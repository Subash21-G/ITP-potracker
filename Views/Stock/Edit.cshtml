@model POTracker.Models.Stock

@{
    ViewData["Title"] = "Edit Stock";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="form-container">
    <div class="page-header">
        <div>
            <h1>Edit Stock</h1>
            <p>Update stock quantity, minimum level and location</p>
        </div>
        <a href="/Stock/Index" class="btn-secondary">Back</a>
    </div>

    <form method="post" class="premium-form">
        <input asp-for="Id" type="hidden" />
        <div class="form-grid">
            <div class="form-group"><label>Material No</label><input asp-for="MaterialNo" required /></div>
            <div class="form-group"><label>Material Name</label><input asp-for="MaterialName" /></div>
            <div class="form-group"><label>RM Grade</label><input asp-for="RMGrade" /></div>
            <div class="form-group"><label>Location</label><input asp-for="Location" /></div>
            <div class="form-group"><label>Available Qty</label><input asp-for="AvailableQty" type="number" step="0.01" /></div>
            <div class="form-group"><label>Minimum Qty</label><input asp-for="MinimumQty" type="number" step="0.01" /></div>
        </div>
        <div class="form-actions">
            <button type="submit" class="btn-primary">Update Stock</button>
            <a href="/Stock/Index" class="btn-secondary">Cancel</a>
        </div>
    </form>
</div>
