@model List<POTracker.Models.Stock>

@{
    ViewData["Title"] = "Stock Control";
    Layout = "~/Views/Shared/_Layout.cshtml";
    string search = ViewBag.Search ?? "";
}

<div class="page-header">
    <div>
        <h1>Stock Control Center</h1>
        <p>RM stock, shortage alerts and minimum quantity control</p>
    </div>
    <role-access roles="Admin,Production">
        <a href="/Stock/Create" class="btn-primary">+ Add Stock</a>
    </role-access>
</div>

<div class="premium-grid">
    <div class="metric-card"><span>Total Items</span><strong>@Model.Count</strong></div>
    <div class="metric-card"><span>Low Stock</span><strong>@(ViewBag.LowStockCount ?? 0)</strong></div>
    <div class="metric-card"><span>Healthy</span><strong>@Model.Count(x => x.AvailableQty > x.MinimumQty)</strong></div>
    <div class="metric-card"><span>Updated Today</span><strong>@Model.Count(x => x.UpdatedDate.Date == DateTime.Today)</strong></div>
</div>

<div class="table-section">
    <form method="get" class="search-box">
        <input type="text" name="search" value="@search" placeholder="Search material, grade or name..." />
        <button type="submit">Search</button>
        <a href="/Stock/Index" class="btn-secondary">Reset</a>
    </form>

    <table class="custom-table">
        <thead>
            <tr>
                <th>Material No</th>
                <th>Name</th>
                <th>RM Grade</th>
                <th>Location</th>
                <th>Available</th>
                <th>Minimum</th>
                <th>Status</th>
                <th>Updated</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                bool lowStock = item.AvailableQty <= item.MinimumQty;
                <tr>
                    <td><strong>@item.MaterialNo</strong></td>
                    <td>@(item.MaterialName ?? "-")</td>
                    <td>@(item.RMGrade ?? "-")</td>
                    <td>@(item.Location ?? "-")</td>
                    <td>@item.AvailableQty</td>
                    <td>@item.MinimumQty</td>
                    <td>
                        <span class="@(lowStock ? "status-red" : "status-green")">
                            @(lowStock ? "Low Stock" : "Healthy")
                        </span>
                    </td>
                    <td>@item.UpdatedDate.ToString("dd-MM-yyyy")</td>
                    <td>
                        <role-access roles="Admin,Production">
                            <a href="/Stock/Edit/@item.Id" class="action-edit">Edit</a>

                            <form asp-controller="Stock"
                                  asp-action="Delete"
                                  asp-route-id="@item.Id"
                                  asp-antiforgery="true"
                                  method="post"
                                  style="display:inline;margin:0;"
                                  onsubmit="return confirm('Delete stock item?');">
                                <button type="submit"
                                        class="action-delete">
                                    Delete
                                </button>
                            </form>
                        </role-access>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
