@model POTracker.ViewModels.MaterialIndexViewModel

@{
    ViewData["Title"] = "Materials";
    Layout = "~/Views/Shared/_Layout.cshtml";

    string StatusClass(string? value)
    {
        var status = value?.Trim().ToLowerInvariant() ?? "";

        if (status.Contains("fully") ||
            status.Contains("complete") ||
            status == "dispatched" ||
            status == "available")
        {
            return "mi-status-success";
        }

        if (status.Contains("partial") ||
            status.Contains("progress"))
        {
            return "mi-status-info";
        }

        if (status.Contains("shortage") ||
            status.Contains("pending"))
        {
            return "mi-status-warning";
        }

        if (status.Contains("out of stock") ||
            status.Contains("not found") ||
            status.Contains("cancel") ||
            status.Contains("reject"))
        {
            return "mi-status-danger";
        }

        return "mi-status-neutral";
    }
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/material-index-premium.css"
          asp-append-version="true" />

    <style>
        .mi-bulk-bar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 14px;
            padding: 13px 15px;
            margin-bottom: 14px;
            border: 1px solid #fecdd3;
            border-radius: 13px;
            background: #fff7f8;
        }

        .mi-bulk-left,
        .mi-bulk-actions {
            display: flex;
            align-items: center;
            gap: 12px;
            flex-wrap: wrap;
        }

        .mi-select-all-label,
        .mi-material-check-label {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
        }

        .mi-select-checkbox {
            width: 18px;
            height: 18px;
            margin: 0;
            accent-color: #dc2626;
            cursor: pointer;
        }

        .mi-checkbox-column {
            width: 48px;
            min-width: 48px;
            text-align: center !important;
        }

        .mi-selected-count {
            display: inline-flex;
            align-items: center;
            min-height: 30px;
            padding: 5px 10px;
            border: 1px solid #ddd6fe;
            border-radius: 999px;
            background: #f5f3ff;
            color: #5b21b6;
            font-size: 12px;
            font-weight: 900;
        }

        .mi-bulk-help {
            color: #64748b;
            font-size: 12px;
            font-weight: 700;
        }

        .mi-btn-bulk-delete {
            min-height: 39px;
            padding: 9px 14px;
            border: 1px solid #dc2626;
            border-radius: 10px;
            background: #dc2626;
            color: #ffffff;
            font: inherit;
            font-size: 13px;
            font-weight: 900;
            cursor: pointer;
            transition: .18s ease;
        }

            .mi-btn-bulk-delete:hover:not(:disabled) {
                background: #b91c1c;
                transform: translateY(-1px);
            }

            .mi-btn-bulk-delete:disabled {
                border-color: #cbd5e1;
                background: #e2e8f0;
                color: #94a3b8;
                cursor: not-allowed;
            }

        .mi-row-selected {
            background: #fff7f8 !important;
        }

        @@media (max-width: 760px) {
            .mi-bulk-bar {
                align-items: flex-start;
                flex-direction: column;
            }

            .mi-bulk-actions,
            .mi-btn-bulk-delete {
                width: 100%;
            }

            .mi-btn-bulk-delete {
                justify-content: center;
            }
        }
    </style>
}

<div class="mi-page">

    <section class="mi-hero">
        <div class="mi-hero-copy">
            <span class="mi-kicker">Material management</span>

            <h2>Materials</h2>

            <p>
                Search, filter and track PO materials with handler,
                received date, invoice, dispatch and live stock details.
            </p>
        </div>

        <div class="mi-hero-actions">
            <a asp-controller="Material"
               asp-action="ExportExcel"
               asp-route-search="@Model.Search"
               asp-route-poNumber="@Model.PONumber"
               asp-route-handler="@Model.Handler"
               asp-route-poDateFrom="@(Model.PODateFrom?.ToString("yyyy-MM-dd"))"
               asp-route-poDateTo="@(Model.PODateTo?.ToString("yyyy-MM-dd"))"
               asp-route-poReceivedDateFrom="@(Model.POReceivedDateFrom?.ToString("yyyy-MM-dd"))"
               asp-route-poReceivedDateTo="@(Model.POReceivedDateTo?.ToString("yyyy-MM-dd"))"
               asp-route-invoiceStatus="@Model.InvoiceStatus"
               asp-route-dispatchStatus="@Model.DispatchStatus"
               asp-route-stockStatus="@Model.StockStatus"
               class="mi-btn mi-btn-excel">
                Export Filtered Excel
            </a>

            <role-access roles="Admin,Production">
                <a asp-controller="Material"
                   asp-action="Create"
                   class="mi-btn mi-btn-primary">
                    + Add Material
                </a>
            </role-access>
        </div>
    </section>

    @if (TempData["Success"] != null)
    {
        <div class="mi-alert mi-alert-success">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="mi-alert mi-alert-danger">
            @TempData["Error"]
        </div>
    }

    <section class="mi-summary-grid">

        <article class="mi-summary-card mi-summary-violet">
            <span>Total Materials</span>
            <strong>@Model.Summary.TotalMaterials</strong>
            <small>Filtered material records</small>
        </article>

        <article class="mi-summary-card mi-summary-rose">
            <span>Pending Dispatch</span>
            <strong>@Model.Summary.PendingDispatchMaterials</strong>
            <small>@Model.Summary.TotalPendingDispatchQuantity.ToString("N2") quantity pending</small>
        </article>

        <article class="mi-summary-card mi-summary-amber">
            <span>Not Invoiced</span>
            <strong>@Model.Summary.NotInvoicedMaterials</strong>
            <small>@Model.Summary.TotalBalanceQuantity.ToString("N2") invoice balance</small>
        </article>

        <article class="mi-summary-card mi-summary-green">
            <span>
                @(Model.Summary.StockSummaryIsCurrentPage
                    ? "In Stock (Current Page)"
                    : "In Stock")
            </span>
            <strong>@Model.Summary.InStockMaterials</strong>
            <small>@Model.Summary.TotalLiveStockQuantity.ToString("N2") available stock</small>
        </article>

        <article class="mi-summary-card mi-summary-red">
            <span>
                @(Model.Summary.StockSummaryIsCurrentPage
                    ? "Shortage (Current Page)"
                    : "Shortage")
            </span>
            <strong>@Model.Summary.ShortageMaterials</strong>
            <small>Materials requiring stock</small>
        </article>
    </section>

    <section class="mi-filter-card">
        <div class="mi-section-head">
            <div>
                <span class="mi-kicker">Search and filter</span>
                <h3>Find materials</h3>
            </div>

            @if (Model.HasActiveFilters)
            {
                <span class="mi-filter-count">
                    @Model.ActiveFilterCount active filter(s)
                </span>
            }
        </div>

        <form asp-controller="Material"
              asp-action="Index"
              method="get"
              class="mi-filter-form">

            <div class="mi-filter-grid">

                <div class="mi-field mi-field-wide">
                    <label for="Search">Material search</label>

                    <input type="search"
                           id="Search"
                           name="search"
                           value="@Model.Search"
                           placeholder="Material no, description, line item, drawing, HSN/SAC..." />
                </div>

                <div class="mi-field">
                    <label for="PONumber">PO number</label>

                    <input type="text"
                           id="PONumber"
                           name="poNumber"
                           value="@Model.PONumber"
                           placeholder="Enter PO number" />
                </div>

                <div class="mi-field">
                    <label for="Handler">Handler / Person</label>

                    <select id="Handler"
                            name="handler">
                        <option value="">All handlers</option>

                        @foreach (var option in Model.Handlers)
                        {
                            if (option.IsSelected)
                            {
                                <option value="@option.Value" selected>
                                    @option.Text (@option.Count)
                                </option>
                            }
                            else
                            {
                                <option value="@option.Value">
                                    @option.Text (@option.Count)
                                </option>
                            }
                        }
                    </select>
                </div>

                <div class="mi-field">
                    <label for="PODateFrom">PO date from</label>

                    <input type="date"
                           id="PODateFrom"
                           name="poDateFrom"
                           value="@(Model.PODateFrom?.ToString("yyyy-MM-dd"))" />
                </div>

                <div class="mi-field">
                    <label for="PODateTo">PO date to</label>

                    <input type="date"
                           id="PODateTo"
                           name="poDateTo"
                           value="@(Model.PODateTo?.ToString("yyyy-MM-dd"))" />
                </div>

                <div class="mi-field">
                    <label for="POReceivedDateFrom">PO received from</label>

                    <input type="date"
                           id="POReceivedDateFrom"
                           name="poReceivedDateFrom"
                           value="@(Model.POReceivedDateFrom?.ToString("yyyy-MM-dd"))" />
                </div>

                <div class="mi-field">
                    <label for="POReceivedDateTo">PO received to</label>

                    <input type="date"
                           id="POReceivedDateTo"
                           name="poReceivedDateTo"
                           value="@(Model.POReceivedDateTo?.ToString("yyyy-MM-dd"))" />
                </div>

                <div class="mi-field">
                    <label for="InvoiceStatus">Invoice status</label>

                    <select id="InvoiceStatus"
                            name="invoiceStatus">
                        <option value="">All invoice statuses</option>

                        @foreach (var option in Model.InvoiceStatuses)
                        {
                            if (option.IsSelected)
                            {
                                <option value="@option.Value" selected>
                                    @option.Text (@option.Count)
                                </option>
                            }
                            else
                            {
                                <option value="@option.Value">
                                    @option.Text (@option.Count)
                                </option>
                            }
                        }
                    </select>
                </div>

                <div class="mi-field">
                    <label for="DispatchStatus">Dispatch status</label>

                    <select id="DispatchStatus"
                            name="dispatchStatus">
                        <option value="">All dispatch statuses</option>

                        @foreach (var option in Model.DispatchStatuses)
                        {
                            if (option.IsSelected)
                            {
                                <option value="@option.Value" selected>
                                    @option.Text (@option.Count)
                                </option>
                            }
                            else
                            {
                                <option value="@option.Value">
                                    @option.Text (@option.Count)
                                </option>
                            }
                        }
                    </select>
                </div>

                <div class="mi-field">
                    <label for="StockStatus">Stock status</label>

                    <select id="StockStatus"
                            name="stockStatus">
                        <option value="">All stock statuses</option>

                        @foreach (var option in Model.StockStatuses)
                        {
                            if (option.IsSelected)
                            {
                                <option value="@option.Value" selected>
                                    @option.Text
                                </option>
                            }
                            else
                            {
                                <option value="@option.Value">
                                    @option.Text
                                </option>
                            }
                        }
                    </select>
                </div>

                <div class="mi-field">
                    <label for="PageSize">Rows per page</label>

                    <select id="PageSize"
                            name="pageSize">
                        @foreach (var size in new[] { 10, 25, 50, 100, 200 })
                        {
                            if (Model.PageSize == size)
                            {
                                <option value="@size" selected>
                                    @size rows
                                </option>
                            }
                            else
                            {
                                <option value="@size">
                                    @size rows
                                </option>
                            }
                        }
                    </select>
                </div>
            </div>

            <div class="mi-filter-actions">
                <button type="submit"
                        class="mi-btn mi-btn-primary">
                    Search Materials
                </button>

                <a asp-controller="Material"
                   asp-action="Index"
                   class="mi-btn mi-btn-light">
                    Reset Filters
                </a>
            </div>
        </form>
    </section>

    <section class="mi-table-card">

        <div class="mi-table-head">
            <div>
                <span class="mi-kicker">Material records</span>

                <h3>Material list</h3>

                <p>
                    Showing @Model.FirstRecordNumber–@Model.LastRecordNumber
                    of @Model.TotalRecords records
                </p>
            </div>

            <a href="/app/pending-materials"
               class="mi-pending-link">
                View Pending Materials
            </a>
        </div>

        @if (Model.Items.Count == 0)
        {
            <div class="mi-empty-state">
                <div class="mi-empty-icon">M</div>

                <h3>No materials found</h3>

                <p>
                    Try changing the search values or reset all filters.
                </p>

                <a asp-controller="Material"
                   asp-action="Index"
                   class="mi-btn mi-btn-primary">
                    Show All Materials
                </a>
            </div>
        }
        else
        {
            <form asp-controller="Material"
                  asp-action="BulkDelete"
                  method="post"
                  id="materialBulkDeleteForm">

                @Html.AntiForgeryToken()

                <input type="hidden"
                       name="returnUrl"
                       value="@($"{Context.Request.Path}{Context.Request.QueryString}")" />

                <role-access roles="Admin,Production">
                    <div class="mi-bulk-bar">
                        <div class="mi-bulk-left">
                            <label class="mi-select-all-label"
                                   for="selectAllMaterials">
                                <input type="checkbox"
                                       id="selectAllMaterials"
                                       class="mi-select-checkbox"
                                       aria-label="Select all materials on this page" />
                            </label>

                            <strong>
                                Select all on this page
                            </strong>

                            <span class="mi-selected-count"
                                  id="selectedMaterialCount">
                                0 selected
                            </span>

                            <span class="mi-bulk-help">
                                Invoice or dispatch-linked materials will be skipped safely.
                            </span>
                        </div>

                        <div class="mi-bulk-actions">
                            <button type="submit"
                                    class="mi-btn-bulk-delete"
                                    id="deleteSelectedMaterialsButton"
                                    disabled>
                                Delete Selected
                            </button>
                        </div>
                    </div>
                </role-access>

                <div class="mi-table-scroll">
                    <table class="mi-table">
                        <thead>
                            <tr>
                                <th class="mi-checkbox-column">
                                    <span class="visually-hidden">
                                        Select
                                    </span>
                                </th>
                                <th>PO No</th>
                                <th>Handler / Person</th>
                                <th>PO Date</th>
                                <th>PO Received Date</th>
                                <th>Line Item</th>
                                <th>Material No</th>
                                <th>Description</th>
                                <th>PO Qty</th>
                                <th>Balance Qty</th>
                                <th>Invoice Status</th>
                                <th>Dispatch Status</th>
                                <th>Live Stock</th>
                                <th>Actions</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var item in Model.Items)
                            {
                                <tr data-material-row="@item.MaterialId">
                                    <td class="mi-checkbox-column">
                                        <role-access roles="Admin,Production">
                                            <label class="mi-material-check-label">
                                                <input type="checkbox"
                                                       name="selectedIds"
                                                       value="@item.MaterialId"
                                                       class="mi-select-checkbox material-select-checkbox"
                                                       aria-label="Select material @item.MaterialNo" />
                                            </label>
                                        </role-access>
                                    </td>

                                    <td>
                                        <a asp-controller="PurchaseOrder"
                                           asp-action="Details"
                                           asp-route-id="@item.PurchaseOrderId"
                                           class="mi-po-number">
                                            @item.PONumber
                                        </a>
                                    </td>

                                    <td>
                                        @if (string.IsNullOrWhiteSpace(item.Handler))
                                        {
                                            <span class="mi-unassigned">
                                                Unassigned
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="mi-handler">
                                                <span>
                                                    @item.Handler.Trim()[0]
                                                </span>

                                                @item.Handler
                                            </span>
                                        }
                                    </td>

                                    <td>
                                        <span class="mi-date">
                                            @(item.PODate?.ToString("dd-MMM-yyyy") ?? "Not set")
                                        </span>
                                    </td>

                                    <td>
                                        <span class="mi-received-date">
                                            @(item.POReceivedDate?.ToString("dd-MMM-yyyy") ?? "Not set")
                                        </span>
                                    </td>

                                    <td>
                                        <span class="mi-line-item">
                                            @item.LineItem
                                        </span>
                                    </td>

                                    <td>
                                        <div class="mi-material-number">
                                            @item.MaterialNo
                                        </div>

                                        @if (!string.IsNullOrWhiteSpace(item.DrawingNo))
                                        {
                                            <div class="mi-drawing-number">
                                                Drg: @item.DrawingNo
                                            </div>
                                        }
                                    </td>

                                    <td>
                                        <div class="mi-description"
                                             title="@item.BriefDescription">
                                            @item.Description
                                        </div>
                                    </td>

                                    <td>
                                        <div class="mi-quantity">
                                            <strong>
                                                @item.POQuantity.ToString("N2")
                                            </strong>

                                            <span>@item.Unit</span>
                                        </div>
                                    </td>

                                    <td>
                                        <div class="mi-balance">
                                            @item.BalanceQuantity.ToString("N2")
                                        </div>

                                        <div class="mi-progress">
                                            <span style="width:@item.InvoiceCompletionPercentage.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)%"></span>
                                        </div>
                                    </td>

                                    <td>
                                        <span class="mi-status @StatusClass(item.InvoiceStatus)">
                                            @item.InvoiceStatus
                                        </span>

                                        <div class="mi-status-meta">
                                            @item.InvoiceQuantity.ToString("N2")
                                            invoiced
                                        </div>
                                    </td>

                                    <td>
                                        <span class="mi-status @StatusClass(item.DispatchStatus)">
                                            @item.DispatchStatus
                                        </span>

                                        <div class="mi-status-meta">
                                            @item.PendingDispatchQuantity.ToString("N2")
                                            pending
                                        </div>
                                    </td>

                                    <td>
                                        <div class="mi-stock-value">
                                            @item.LiveStockQuantity.ToString("N2")
                                        </div>

                                        <span class="mi-status @StatusClass(item.StockStatus)">
                                            @item.StockStatus
                                        </span>

                                        @if (item.ShortageQuantity > 0)
                                        {
                                            <div class="mi-shortage">
                                                Shortage:
                                                @item.ShortageQuantity.ToString("N2")
                                            </div>
                                        }
                                    </td>

                                    <td>
                                        <div class="mi-row-actions">

                                            <a asp-controller="Material"
                                               asp-action="Details"
                                               asp-route-id="@item.MaterialId"
                                               class="mi-row-btn mi-row-view">
                                                View
                                            </a>

                                            <role-access roles="Admin,Production">
                                                <a asp-controller="Material"
                                                   asp-action="Edit"
                                                   asp-route-id="@item.MaterialId"
                                                   class="mi-row-btn mi-row-edit">
                                                    Edit
                                                </a>

                                                <button type="submit"
                                                        form="materialSingleDeleteForm"
                                                        name="id"
                                                        value="@item.MaterialId"
                                                        class="mi-row-btn mi-row-delete"
                                                        onclick="return confirm('Delete this material?');">
                                                    Delete
                                                </button>
                                            </role-access>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="mi-pagination">

                    <div class="mi-pagination-copy">
                        Page @Model.Page of @Model.TotalPages
                    </div>

                    <div class="mi-pagination-links">

                        @if (Model.HasPreviousPage)
                        {
                            <a asp-controller="Material"
                               asp-action="Index"
                               asp-route-search="@Model.Search"
                               asp-route-poNumber="@Model.PONumber"
                               asp-route-handler="@Model.Handler"
                               asp-route-poDateFrom="@(Model.PODateFrom?.ToString("yyyy-MM-dd"))"
                               asp-route-poDateTo="@(Model.PODateTo?.ToString("yyyy-MM-dd"))"
                               asp-route-poReceivedDateFrom="@(Model.POReceivedDateFrom?.ToString("yyyy-MM-dd"))"
                               asp-route-poReceivedDateTo="@(Model.POReceivedDateTo?.ToString("yyyy-MM-dd"))"
                               asp-route-invoiceStatus="@Model.InvoiceStatus"
                               asp-route-dispatchStatus="@Model.DispatchStatus"
                               asp-route-stockStatus="@Model.StockStatus"
                               asp-route-page="@(Model.Page - 1)"
                               asp-route-pageSize="@Model.PageSize"
                               class="mi-page-link">
                                Previous
                            </a>
                        }
                        else
                        {
                            <span class="mi-page-link disabled">
                                Previous
                            </span>
                        }

                        @{
                            var firstPage = Math.Max(1, Model.Page - 2);
                            var lastPage = Math.Min(Model.TotalPages, Model.Page + 2);
                        }

                        @for (var pageNumber = firstPage;
                              pageNumber <= lastPage;
                              pageNumber++)
                        {
                            <a asp-controller="Material"
                               asp-action="Index"
                               asp-route-search="@Model.Search"
                               asp-route-poNumber="@Model.PONumber"
                               asp-route-handler="@Model.Handler"
                               asp-route-poDateFrom="@(Model.PODateFrom?.ToString("yyyy-MM-dd"))"
                               asp-route-poDateTo="@(Model.PODateTo?.ToString("yyyy-MM-dd"))"
                               asp-route-poReceivedDateFrom="@(Model.POReceivedDateFrom?.ToString("yyyy-MM-dd"))"
                               asp-route-poReceivedDateTo="@(Model.POReceivedDateTo?.ToString("yyyy-MM-dd"))"
                               asp-route-invoiceStatus="@Model.InvoiceStatus"
                               asp-route-dispatchStatus="@Model.DispatchStatus"
                               asp-route-stockStatus="@Model.StockStatus"
                               asp-route-page="@pageNumber"
                               asp-route-pageSize="@Model.PageSize"
                               class="mi-page-number @(pageNumber == Model.Page ? "active" : "")">
                                @pageNumber
                            </a>
                        }

                        @if (Model.HasNextPage)
                        {
                            <a asp-controller="Material"
                               asp-action="Index"
                               asp-route-search="@Model.Search"
                               asp-route-poNumber="@Model.PONumber"
                               asp-route-handler="@Model.Handler"
                               asp-route-poDateFrom="@(Model.PODateFrom?.ToString("yyyy-MM-dd"))"
                               asp-route-poDateTo="@(Model.PODateTo?.ToString("yyyy-MM-dd"))"
                               asp-route-poReceivedDateFrom="@(Model.POReceivedDateFrom?.ToString("yyyy-MM-dd"))"
                               asp-route-poReceivedDateTo="@(Model.POReceivedDateTo?.ToString("yyyy-MM-dd"))"
                               asp-route-invoiceStatus="@Model.InvoiceStatus"
                               asp-route-dispatchStatus="@Model.DispatchStatus"
                               asp-route-stockStatus="@Model.StockStatus"
                               asp-route-page="@(Model.Page + 1)"
                               asp-route-pageSize="@Model.PageSize"
                               class="mi-page-link">
                                Next
                            </a>
                        }
                        else
                        {
                            <span class="mi-page-link disabled">
                                Next
                            </span>
                        }
                    </div>
                </div>
            </form>

            <role-access roles="Admin,Production">
                <form asp-controller="Material"
                      asp-action="Delete"
                      asp-antiforgery="true"
                      method="post"
                      id="materialSingleDeleteForm"
                      style="display:none;">
                </form>
            </role-access>
        }
    </section>
</div>

@section Scripts {
    <script>
        (() => {
            "use strict";

            const form =
                document.getElementById(
                    "materialBulkDeleteForm");

            if (!form) {
                return;
            }

            const selectAll =
                document.getElementById(
                    "selectAllMaterials");

            const deleteButton =
                document.getElementById(
                    "deleteSelectedMaterialsButton");

            const selectedCount =
                document.getElementById(
                    "selectedMaterialCount");

            const checkboxes =
                Array.from(
                    form.querySelectorAll(
                        ".material-select-checkbox"));

            const updateSelectionState = () => {
                const selected =
                    checkboxes.filter(
                        checkbox =>
                            checkbox.checked);

                const selectedTotal =
                    selected.length;

                if (selectedCount) {
                    selectedCount.textContent =
                        `${selectedTotal} selected`;
                }

                if (deleteButton) {
                    deleteButton.disabled =
                        selectedTotal === 0;
                }

                if (selectAll) {
                    selectAll.checked =
                        checkboxes.length > 0 &&
                        selectedTotal ===
                        checkboxes.length;

                    selectAll.indeterminate =
                        selectedTotal > 0 &&
                        selectedTotal <
                        checkboxes.length;
                }

                checkboxes.forEach(
                    checkbox => {
                        const row =
                            checkbox.closest(
                                "tr");

                        row?.classList.toggle(
                            "mi-row-selected",
                            checkbox.checked);
                    });
            };

            selectAll?.addEventListener(
                "change",
                () => {
                    checkboxes.forEach(
                        checkbox => {
                            checkbox.checked =
                                selectAll.checked;
                        });

                    updateSelectionState();
                });

            checkboxes.forEach(
                checkbox => {
                    checkbox.addEventListener(
                        "change",
                        updateSelectionState);
                });

            form.addEventListener(
                "submit",
                event => {
                    const selectedTotal =
                        checkboxes.filter(
                            checkbox =>
                                checkbox.checked)
                            .length;

                    if (selectedTotal === 0) {
                        event.preventDefault();

                        window.alert(
                            "Select at least one material.");

                        return;
                    }

                    const confirmed =
                        window.confirm(
                            `Delete ${selectedTotal} selected material(s)? ` +
                            "Invoice or dispatch-linked materials will be skipped.");

                    if (!confirmed) {
                        event.preventDefault();
                        return;
                    }

                    if (deleteButton) {
                        deleteButton.disabled = true;
                        deleteButton.textContent =
                            "Deleting...";
                    }
                });

            updateSelectionState();
        })();
    </script>
}
