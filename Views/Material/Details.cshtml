@model POTracker.Models.Material

@{
    ViewData["Title"] = "Material Details";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var stockInfo =
        ViewBag.StockInfo as POTracker.Models.StockInfoDto;

    decimal availableStock =
        stockInfo?.CurrentStock ?? 0;

    decimal shortageQty =
        Model.Qty > availableStock
            ? Model.Qty - availableStock
            : 0;

    var invoiceItems =
        Model.InvoiceItems?
            .OrderByDescending(x => x.CreatedDate)
            .ToList()
        ?? new List<POTracker.Models.InvoiceItem>();

    var dispatches =
        Model.Dispatches?
            .OrderByDescending(x => x.DispatchDate)
            .ToList()
        ?? new List<POTracker.Models.Dispatch>();

    var handler =
        Model.PurchaseOrder?.BuyerContactPerson;

    var poNumber =
        Model.PurchaseOrder?.PONumber;

    var poDate =
        Model.PurchaseOrder?.PODate
        ?? Model.PODate;

    var poReceivedDate =
        Model.PurchaseOrder?.ReceivedDate
        ?? Model.ReceivingDate;

    var materialDescription =
        !string.IsNullOrWhiteSpace(Model.BriefDescription)
            ? Model.BriefDescription
            : Model.ShortDescription;

    var hasTechnicalDetails =
        !string.IsNullOrWhiteSpace(Model.DrawingNo) ||
        !string.IsNullOrWhiteSpace(Model.DrawingVersion) ||
        !string.IsNullOrWhiteSpace(Model.RMGrade) ||
        !string.IsNullOrWhiteSpace(Model.RMSource) ||
        !string.IsNullOrWhiteSpace(Model.RMProcess) ||
        !string.IsNullOrWhiteSpace(Model.SurfaceFinish) ||
        !string.IsNullOrWhiteSpace(Model.MachiningType) ||
        !string.IsNullOrWhiteSpace(Model.AssignedDashboard);

    var hasCostDetails =
        Model.Cost > 0 ||
        Model.ValueOfGoods > 0 ||
        Model.TotalValue > 0 ||
        !string.IsNullOrWhiteSpace(Model.PriceUnit);

    var hasFiles =
        !string.IsNullOrWhiteSpace(Model.PDFFilePath) ||
        !string.IsNullOrWhiteSpace(Model.DrawingFilePath);

    string MetricClass(string value)
    {
        var status = value.Trim().ToLowerInvariant();

        if (status.Contains("complete") ||
            status.Contains("fully") ||
            status == "dispatched" ||
            status == "available")
        {
            return "md-metric-success";
        }

        if (status.Contains("partial") ||
            status.Contains("progress") ||
            status.Contains("process"))
        {
            return "md-metric-info";
        }

        if (status.Contains("shortage") ||
            status.Contains("pending") ||
            status.Contains("not invoiced"))
        {
            return "md-metric-warning";
        }

        return "md-metric-neutral";
    }
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/material-details-premium.css"
          asp-append-version="true" />
}

<div class="md-page">

    <!-- =========================================================
         PAGE HEADER
    ========================================================== -->

    <section class="md-page-header">
        <div>
            <span class="md-kicker">
                Material tracking
            </span>

            <h1>Material Details</h1>

            <p>
                Complete invoice, dispatch, stock and
                production tracking details.
            </p>
        </div>

        <div class="md-header-actions">
            <a asp-controller="Material"
               asp-action="Index"
               class="md-btn md-btn-light">
                Back
            </a>

            <role-access roles="Admin,Production">
                <a asp-controller="Material"
                   asp-action="Edit"
                   asp-route-id="@Model.Id"
                   class="md-btn md-btn-primary">
                    Edit Material
                </a>

                @if (Model.PendingQty > 0)
                {
                    <a asp-controller="Dispatch"
                       asp-action="Create"
                       asp-route-materialId="@Model.Id"
                       class="md-btn md-btn-success">
                        Add Dispatch
                    </a>
                }
            </role-access>
        </div>
    </section>

    <!-- =========================================================
         MAIN MATERIAL CARD
    ========================================================== -->

    <section class="md-card">

        <div class="md-material-title">

            <div>
                <span class="md-kicker">
                    Material record
                </span>

                <h2>
                    @(string.IsNullOrWhiteSpace(Model.MaterialNo)
                        ? "Material"
                        : Model.MaterialNo)
                </h2>

                @if (!string.IsNullOrWhiteSpace(materialDescription))
                {
                    <p>@materialDescription</p>
                }
            </div>

            <div class="md-title-badges">

                @if (!string.IsNullOrWhiteSpace(Model.LineItem))
                {
                    <span class="md-badge md-badge-neutral">
                        @Model.LineItem
                    </span>
                }

                @if (!string.IsNullOrWhiteSpace(poNumber))
                {
                    <span class="md-badge md-badge-primary">
                        @poNumber
                    </span>
                }
            </div>
        </div>

        <div class="md-detail-grid">

            @if (!string.IsNullOrWhiteSpace(poNumber))
            {
                <article class="md-detail-item">
                    <span>PO Number</span>
                    <strong>@poNumber</strong>
                </article>
            }

            @if (!string.IsNullOrWhiteSpace(handler))
            {
                <article class="md-detail-item">
                    <span>Handler / Person</span>
                    <strong>@handler</strong>
                </article>
            }

            @if (poDate.HasValue)
            {
                <article class="md-detail-item">
                    <span>PO Date</span>
                    <strong>
                        @poDate.Value.ToString("dd-MMM-yyyy")
                    </strong>
                </article>
            }

            @if (poReceivedDate.HasValue)
            {
                <article class="md-detail-item md-detail-received">
                    <span>PO Received Date</span>
                    <strong>
                        @poReceivedDate.Value.ToString("dd-MMM-yyyy")
                    </strong>
                </article>
            }

            @if (!string.IsNullOrWhiteSpace(Model.LineItem))
            {
                <article class="md-detail-item">
                    <span>Line Item</span>
                    <strong>@Model.LineItem</strong>
                </article>
            }

            @if (!string.IsNullOrWhiteSpace(Model.MaterialNo))
            {
                <article class="md-detail-item">
                    <span>Material Number</span>
                    <strong>@Model.MaterialNo</strong>
                </article>
            }

            @if (!string.IsNullOrWhiteSpace(Model.HsnSacCode))
            {
                <article class="md-detail-item">
                    <span>HSN/SAC Code</span>
                    <strong>@Model.HsnSacCode</strong>
                </article>
            }

            <article class="md-detail-item">
                <span>PO Quantity</span>

                <strong>
                    @Model.Qty.ToString("0.##")
                    @Model.Unit
                </strong>
            </article>

            @if (!string.IsNullOrWhiteSpace(Model.Unit))
            {
                <article class="md-detail-item">
                    <span>Unit</span>
                    <strong>@Model.Unit</strong>
                </article>
            }

            @if (!string.IsNullOrWhiteSpace(Model.Dep))
            {
                <article class="md-detail-item">
                    <span>Department</span>
                    <strong>@Model.Dep</strong>
                </article>
            }

            @if (Model.DeliveryDate.HasValue)
            {
                <article class="md-detail-item">
                    <span>Delivery Date</span>

                    <strong>
                        @Model.DeliveryDate.Value.ToString("dd-MMM-yyyy")
                    </strong>
                </article>
            }

            @if (Model.ProcessStartDate.HasValue)
            {
                <article class="md-detail-item">
                    <span>Process Start Date</span>

                    <strong>
                        @Model.ProcessStartDate.Value.ToString("dd-MMM-yyyy")
                    </strong>
                </article>
            }

            @if (Model.AlertDate.HasValue)
            {
                <article class="md-detail-item">
                    <span>Alert Date</span>

                    <strong>
                        @Model.AlertDate.Value.ToString("dd-MMM-yyyy")
                    </strong>
                </article>
            }
        </div>
    </section>

    <!-- =========================================================
         STATUS AND QUANTITY METRICS
         Unique md-* classes prevent global summary-card conflicts.
    ========================================================== -->

    <section class="md-metrics-grid">

        @{
            var processStatus =
                string.IsNullOrWhiteSpace(Model.ProcessStatus)
                    ? "Pending"
                    : Model.ProcessStatus;

            var invoiceStatus =
                string.IsNullOrWhiteSpace(Model.InvoiceStatus)
                    ? "Not Invoiced"
                    : Model.InvoiceStatus;

            var dispatchStatus =
                string.IsNullOrWhiteSpace(Model.DispatchStatus)
                    ? "Pending"
                    : Model.DispatchStatus;
        }

        <article class="md-metric-card @MetricClass(processStatus)">
            <span>Process Status</span>
            <strong>@processStatus</strong>
        </article>

        <article class="md-metric-card @MetricClass(invoiceStatus)">
            <span>Invoice Status</span>
            <strong>@invoiceStatus</strong>
        </article>

        <article class="md-metric-card @MetricClass(dispatchStatus)">
            <span>Dispatch Status</span>
            <strong>@dispatchStatus</strong>
        </article>

        <article class="md-metric-card md-metric-info">
            <span>PO Quantity</span>
            <strong>@Model.Qty.ToString("0.##")</strong>
        </article>

        <article class="md-metric-card md-metric-success">
            <span>Invoice Quantity</span>
            <strong>@Model.InvoiceQty.ToString("0.##")</strong>
        </article>

        <article class="md-metric-card md-metric-warning">
            <span>Balance To Invoice</span>
            <strong>@Model.BalanceQty.ToString("0.##")</strong>
        </article>

        <article class="md-metric-card md-metric-success">
            <span>Dispatch Quantity</span>
            <strong>@Model.DispatchQty.ToString("0.##")</strong>
        </article>

        <article class="md-metric-card md-metric-danger">
            <span>Pending Dispatch Qty</span>
            <strong>@Model.PendingQty.ToString("0.##")</strong>
        </article>

        @if (Model.DispatchDate.HasValue)
        {
            <article class="md-metric-card md-metric-info">
                <span>Last Dispatch Date</span>

                <strong>
                    @Model.DispatchDate.Value.ToString("dd-MMM-yyyy")
                </strong>
            </article>
        }

        <article class="md-metric-card md-metric-success">
            <span>Live Stock</span>

            <strong>
                @(stockInfo == null
                    ? "Not Found"
                    : availableStock.ToString("0.##"))
            </strong>
        </article>

        @if (stockInfo != null)
        {
            <article class="md-metric-card @(shortageQty > 0 ? "md-metric-danger" : "md-metric-success")">
                <span>Shortage Quantity</span>
                <strong>@shortageQty.ToString("0.##")</strong>
            </article>
        }

        <article class="md-metric-card @(stockInfo == null || shortageQty > 0 ? "md-metric-warning" : "md-metric-success")">
            <span>Stock Status</span>

            <strong>
                @if (stockInfo == null)
                {
                    <text>Not Found</text>
                }
                else if (shortageQty > 0)
                {
                    <text>Shortage</text>
                }
                else
                {
                    <text>Available</text>
                }
            </strong>
        </article>
    </section>

    <!-- =========================================================
         TECHNICAL DETAILS
    ========================================================== -->
    @if (hasTechnicalDetails)
    {
        <section class="md-card">

            <div class="md-section-head">
                <div>
                    <span class="md-kicker">
                        Engineering
                    </span>

                    <h3>Technical Details</h3>
                </div>
            </div>

            <div class="md-detail-grid">

                @if (!string.IsNullOrWhiteSpace(Model.DrawingNo))
                {
                    <article class="md-detail-item">
                        <span>Drawing Number</span>
                        <strong>@Model.DrawingNo</strong>
                    </article>
                }

                @if (!string.IsNullOrWhiteSpace(Model.DrawingVersion))
                {
                    <article class="md-detail-item">
                        <span>Drawing Version</span>
                        <strong>@Model.DrawingVersion</strong>
                    </article>
                }

                @if (!string.IsNullOrWhiteSpace(Model.RMGrade))
                {
                    <article class="md-detail-item">
                        <span>RM Grade</span>
                        <strong>@Model.RMGrade</strong>
                    </article>
                }

                @if (!string.IsNullOrWhiteSpace(Model.RMSource))
                {
                    <article class="md-detail-item">
                        <span>RM Source</span>
                        <strong>@Model.RMSource</strong>
                    </article>
                }

                @if (!string.IsNullOrWhiteSpace(Model.RMProcess))
                {
                    <article class="md-detail-item">
                        <span>RM Process</span>
                        <strong>@Model.RMProcess</strong>
                    </article>
                }

                @if (!string.IsNullOrWhiteSpace(Model.SurfaceFinish))
                {
                    <article class="md-detail-item">
                        <span>Surface Finish</span>
                        <strong>@Model.SurfaceFinish</strong>
                    </article>
                }

                @if (!string.IsNullOrWhiteSpace(Model.MachiningType))
                {
                    <article class="md-detail-item">
                        <span>Machining Type</span>
                        <strong>@Model.MachiningType</strong>
                    </article>
                }

                @if (!string.IsNullOrWhiteSpace(Model.AssignedDashboard))
                {
                    <article class="md-detail-item">
                        <span>Assigned Person</span>
                        <strong>@Model.AssignedDashboard</strong>
                    </article>
                }
            </div>
        </section>
    }

    <!-- =========================================================
         COST DETAILS
    ========================================================== -->
    @if (hasCostDetails)
    {
        <section class="md-card">

            <div class="md-section-head">
                <div>
                    <span class="md-kicker">
                        Commercial
                    </span>

                    <h3>Cost Details</h3>
                </div>
            </div>

            <div class="md-detail-grid">

                @if (Model.Cost > 0)
                {
                    <article class="md-detail-item">
                        <span>Cost</span>
                        <strong>₹ @Model.Cost.ToString("0.00")</strong>
                    </article>
                }

                @if (Model.ValueOfGoods > 0)
                {
                    <article class="md-detail-item">
                        <span>Value of Goods</span>

                        <strong>
                            ₹ @Model.ValueOfGoods.ToString("0.00")
                        </strong>
                    </article>
                }

                @if (!string.IsNullOrWhiteSpace(Model.PriceUnit))
                {
                    <article class="md-detail-item">
                        <span>Price Unit</span>
                        <strong>@Model.PriceUnit</strong>
                    </article>
                }

                @if (Model.TotalValue > 0)
                {
                    <article class="md-detail-item">
                        <span>Total Value</span>

                        <strong>
                            ₹ @Model.TotalValue.ToString("0.00")
                        </strong>
                    </article>
                }
            </div>
        </section>
    }

    <!-- =========================================================
         DESCRIPTION
    ========================================================== -->
    @if (!string.IsNullOrWhiteSpace(materialDescription))
    {
        <section class="md-card">

            <div class="md-section-head">
                <div>
                    <span class="md-kicker">
                        Specification
                    </span>

                    <h3>Material Description</h3>
                </div>
            </div>

            <p class="md-description-text">
                @materialDescription
            </p>
        </section>
    }

    <!-- =========================================================
         INVOICE DETAILS
    ========================================================== -->

    <section class="md-card">

        <div class="md-section-head">

            <div>
                <span class="md-kicker">
                    Billing
                </span>

                <h3>Invoice Details</h3>

                <p>
                    Vyapar invoice records linked to this material.
                </p>
            </div>

            <span class="md-badge md-badge-primary">
                @invoiceItems.Count Invoice Record(s)
            </span>
        </div>

        @if (!invoiceItems.Any())
        {
            <div class="md-empty-message">
                No invoice records found for this material.
            </div>
        }
        else
        {
            <div class="md-table-wrap">

                <table class="md-table">

                    <thead>
                        <tr>
                            <th>Invoice No</th>
                            <th>Invoice Date</th>
                            <th>PO No</th>
                            <th>Line Item</th>
                            <th>Material No</th>
                            <th>Description</th>
                            <th>HSN/SAC</th>
                            <th>Invoice Qty</th>
                            <th>Rate</th>
                            <th>GST</th>
                            <th>Amount</th>
                            <th>Uploaded Date</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var invoice in invoiceItems)
                        {
                            <tr>
                                <td>
                                    <strong>
                                        @(invoice.Invoice?.InvoiceNumber ?? "-")
                                    </strong>
                                </td>

                                <td>
                                    @(invoice.Invoice?.InvoiceDate?.ToString("dd-MMM-yyyy") ?? "-")
                                </td>

                                <td>@(invoice.PONumber ?? "-")</td>
                                <td>@(invoice.LineItem ?? "-")</td>
                                <td>@(invoice.MaterialNo ?? "-")</td>
                                <td>@(invoice.Description ?? "-")</td>
                                <td>@(invoice.HsnSacCode ?? "-")</td>

                                <td>
                                    <strong class="md-text-success">
                                        @invoice.InvoiceQty.ToString("0.##")
                                    </strong>
                                </td>

                                <td>
                                    ₹ @invoice.PriceUnit.ToString("0.00")
                                </td>

                                <td>
                                    ₹ @invoice.GstAmount.ToString("0.00")
                                </td>

                                <td>
                                    ₹ @invoice.Amount.ToString("0.00")
                                </td>

                                <td>
                                    @invoice.CreatedDate.ToString("dd-MMM-yyyy hh:mm tt")
                                </td>
                            </tr>
                        }
                    </tbody>

                    <tfoot>
                        <tr>
                            <th colspan="7"
                                class="md-text-right">
                                Total
                            </th>

                            <th>
                                @invoiceItems
                                .Sum(x => x.InvoiceQty)
                                .ToString("0.##")
                            </th>

                            <th></th>

                            <th>
                                ₹ @invoiceItems
                                .Sum(x => x.GstAmount)
                                .ToString("0.00")
                            </th>

                            <th>
                                ₹ @invoiceItems
                                .Sum(x => x.Amount)
                                .ToString("0.00")
                            </th>

                            <th></th>
                        </tr>
                    </tfoot>
                </table>
            </div>
        }
    </section>

    <!-- =========================================================
         DISPATCH DETAILS
    ========================================================== -->

    <section class="md-card">

        <div class="md-section-head">

            <div>
                <span class="md-kicker">
                    Logistics
                </span>

                <h3>Dispatch Details</h3>

                <p>
                    Dispatch records and dispatch quantity tracking.
                </p>
            </div>

            <div class="md-section-actions">

                <span class="md-badge md-badge-primary">
                    @dispatches.Count Dispatch Record(s)
                </span>

                <role-access roles="Admin,Production">
                    @if (Model.PendingQty > 0)
                    {
                        <a asp-controller="Dispatch"
                           asp-action="Create"
                           asp-route-materialId="@Model.Id"
                           class="md-btn md-btn-success">
                            Add Dispatch
                        </a>
                    }
                </role-access>
            </div>
        </div>

        @if (!dispatches.Any())
        {
            <div class="md-empty-message">
                No manual dispatch records found.
                If invoice is considered as dispatch,
                the summary above is already updated.
            </div>
        }
        else
        {
            <div class="md-table-wrap">

                <table class="md-table">

                    <thead>
                        <tr>
                            <th>Dispatch No</th>
                            <th>Dispatch Date</th>
                            <th>Dispatch Qty</th>
                            <th>Remarks</th>
                            <th>File</th>
                            <th>Action</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var dispatch in dispatches)
                        {
                            <tr>
                                <td>
                                    <strong>@dispatch.DispatchNo</strong>
                                </td>

                                <td>
                                    @dispatch.DispatchDate.ToString("dd-MMM-yyyy")
                                </td>

                                <td>
                                    <strong class="md-text-success">
                                        @dispatch.DispatchQty.ToString("0.##")
                                    </strong>
                                </td>

                                <td>
                                    @(string.IsNullOrWhiteSpace(dispatch.Remarks)
                                        ? "-"
                                        : dispatch.Remarks)
                                </td>

                                <td>
                                    @if (!string.IsNullOrWhiteSpace(dispatch.FilePath))
                                    {
                                        <a href="@dispatch.FilePath"
                                           target="_blank"
                                           rel="noopener noreferrer"
                                           class="md-table-link">
                                            View File
                                        </a>
                                    }
                                    else
                                    {
                                        <span>-</span>
                                    }
                                </td>

                                <td>
                                    <role-access roles="Admin,Production">
                                        <form asp-controller="Dispatch"
                                              asp-action="Delete"
                                              asp-route-id="@dispatch.Id"
                                              method="post"
                                              onsubmit="return confirm('Delete this dispatch record? Pending quantity will be restored.');">

                                            @Html.AntiForgeryToken()

                                            <button type="submit"
                                                    class="md-table-delete">
                                                Delete
                                            </button>
                                        </form>
                                    </role-access>
                                </td>
                            </tr>
                        }
                    </tbody>

                    <tfoot>
                        <tr>
                            <th colspan="2"
                                class="md-text-right">
                                Total Dispatch Qty
                            </th>

                            <th>
                                @dispatches
                                .Sum(x => x.DispatchQty)
                                .ToString("0.##")
                            </th>

                            <th colspan="3"></th>
                        </tr>
                    </tfoot>
                </table>
            </div>
        }
    </section>

    <!-- =========================================================
         TIMELINE
    ========================================================== -->

    <section class="md-card">

        <div class="md-section-head">
            <div>
                <span class="md-kicker">
                    Production
                </span>

                <h3>Production Timeline</h3>
            </div>
        </div>

        <div class="md-timeline">

            <article class="md-timeline-item completed">
                <span></span>

                <div>
                    <h4>Material Created</h4>
                    <p>Material added to PO tracking system.</p>
                </div>
            </article>

            <article class="md-timeline-item @(Model.InvoiceQty > 0 ? "completed" : "")">
                <span></span>

                <div>
                    <h4>Invoice Uploaded</h4>

                    <p>
                        Invoice Qty:
                        @Model.InvoiceQty.ToString("0.##")
                    </p>
                </div>
            </article>

            <article class="md-timeline-item @(Model.DispatchQty > 0 ? "completed" : "")">
                <span></span>

                <div>
                    <h4>Dispatch Updated</h4>

                    <p>
                        Dispatch Qty:
                        @Model.DispatchQty.ToString("0.##")
                    </p>
                </div>
            </article>

            <article class="md-timeline-item @(Model.ProcessStatus == "In Process" ||
                                                                                    Model.ProcessStatus == "In Progress" ||
                                                                                    Model.ProcessStatus == "Completed"
                                                                                        ? "completed"
                                                                                        : "")">
                <span></span>

                <div>
                    <h4>Process Started</h4>

                    <p>
                        Status:
                        @(string.IsNullOrWhiteSpace(Model.ProcessStatus)
                            ? "Pending"
                            : Model.ProcessStatus)
                    </p>
                </div>
            </article>

            <article class="md-timeline-item @(Model.ProcessStatus == "Completed"
                                                                                        ? "completed"
                                                                                        : "")">
                <span></span>

                <div>
                    <h4>Process Completed</h4>
                    <p>Production process completion tracking.</p>
                </div>
            </article>

            <article class="md-timeline-item @(Model.DispatchStatus == "Dispatched"
                                                                                        ? "completed"
                                                                                        : "")">
                <span></span>

                <div>
                    <h4>Dispatch Completed</h4>

                    <p>
                        Dispatch Status:
                        @(string.IsNullOrWhiteSpace(Model.DispatchStatus)
                            ? "Pending"
                            : Model.DispatchStatus)
                    </p>
                </div>
            </article>
        </div>
    </section>

    <!-- =========================================================
         FILES
    ========================================================== -->
    @if (hasFiles)
    {
        <section class="md-card">

            <div class="md-section-head">
                <div>
                    <span class="md-kicker">
                        Documents
                    </span>

                    <h3>Files</h3>
                </div>
            </div>

            <div class="md-file-actions">

                @if (!string.IsNullOrWhiteSpace(Model.PDFFilePath))
                {
                    <a href="@Model.PDFFilePath"
                       target="_blank"
                       rel="noopener noreferrer"
                       class="md-file-link">
                        View PO PDF
                    </a>
                }

                @if (!string.IsNullOrWhiteSpace(Model.DrawingFilePath))
                {
                    <a href="@Model.DrawingFilePath"
                       target="_blank"
                       rel="noopener noreferrer"
                       class="md-file-link">
                        View Drawing File
                    </a>
                }
            </div>
        </section>
    }

    <!-- =========================================================
         REMARKS
    ========================================================== -->
    @if (!string.IsNullOrWhiteSpace(Model.Remark))
    {
        <section class="md-card">

            <div class="md-section-head">
                <div>
                    <span class="md-kicker">
                        Notes
                    </span>

                    <h3>Remarks</h3>
                </div>
            </div>

            <p class="md-description-text">
                @Model.Remark
            </p>
        </section>
    }
</div>
