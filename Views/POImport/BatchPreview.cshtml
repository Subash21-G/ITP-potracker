@using System.Globalization
@using POTracker.ViewModels

@model POBatchImportPreviewViewModel

@{
    ViewData["Title"] = "Multiple PO Import Preview";

    var selectableCount = Model.Files.Count(x =>
        x.IsSuccessful &&
        !x.IsDuplicateInBatch &&
        x.PurchaseOrder != null);
}

<style>
    .batch-page {
        max-width: 1500px;
        margin: 0 auto;
        padding: 10px;
    }

    .batch-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 20px;
        margin-bottom: 22px;
    }

        .batch-header h1 {
            margin: 0;
            font-size: 30px;
            font-weight: 800;
            color: #172033;
        }

        .batch-header p {
            margin: 8px 0 0;
            color: #6b7280;
        }

    .btn-back {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 42px;
        padding: 0 16px;
        border: 1px solid #d8dee9;
        border-radius: 10px;
        background: white;
        color: #334155;
        font-weight: 700;
        text-decoration: none;
    }

    .summary-grid {
        display: grid;
        grid-template-columns: repeat(6, minmax(0, 1fr));
        gap: 12px;
        margin-bottom: 20px;
    }

    .summary-card {
        padding: 18px;
        border: 1px solid #e1e6ef;
        border-radius: 14px;
        background: white;
        box-shadow: 0 8px 24px rgba(20, 32, 60, 0.06);
    }

        .summary-card span {
            display: block;
            color: #64748b;
            font-size: 11px;
            font-weight: 800;
            text-transform: uppercase;
        }

        .summary-card strong {
            display: block;
            margin-top: 8px;
            color: #172033;
            font-size: 26px;
        }

        .summary-card.success strong {
            color: #15803d;
        }

        .summary-card.warning strong {
            color: #b45309;
        }

        .summary-card.danger strong {
            color: #b91c1c;
        }

        .summary-card.info strong {
            color: #0369a1;
        }

    .selection-toolbar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 15px;
        margin-bottom: 16px;
        padding: 14px 16px;
        border: 1px solid #e1e6ef;
        border-radius: 12px;
        background: white;
    }

        .selection-toolbar strong {
            color: #172033;
        }

    .toolbar-buttons {
        display: flex;
        gap: 8px;
    }

    .btn-small {
        padding: 9px 13px;
        border: 1px solid #d6dce8;
        border-radius: 8px;
        background: white;
        color: #334155;
        cursor: pointer;
        font-weight: 700;
    }

    .file-list {
        display: grid;
        gap: 16px;
    }

    .file-card {
        overflow: hidden;
        border: 1px solid #dfe5ef;
        border-radius: 15px;
        background: white;
        box-shadow: 0 10px 28px rgba(20, 32, 60, 0.07);
    }

        .file-card.failed {
            border-color: #fecaca;
        }

        .file-card.duplicate {
            border-color: #fde68a;
        }

    .file-header {
        display: grid;
        grid-template-columns: auto minmax(0, 1fr) auto;
        align-items: center;
        gap: 14px;
        padding: 16px 18px;
        border-bottom: 1px solid #e5eaf2;
    }

    .file-checkbox {
        width: 19px;
        height: 19px;
        accent-color: #4f46e5;
    }

    .file-name {
        overflow: hidden;
        color: #172033;
        font-size: 15px;
        font-weight: 800;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .file-size {
        margin-top: 4px;
        color: #64748b;
        font-size: 12px;
    }

    .badge {
        display: inline-flex;
        align-items: center;
        min-height: 29px;
        padding: 0 11px;
        border-radius: 999px;
        font-size: 11px;
        font-weight: 800;
        white-space: nowrap;
    }

    .badge-ready {
        color: #166534;
        background: #dcfce7;
    }

    .badge-existing {
        color: #075985;
        background: #e0f2fe;
    }

    .badge-duplicate {
        color: #92400e;
        background: #fef3c7;
    }

    .badge-failed {
        color: #991b1b;
        background: #fee2e2;
    }

    .error-message {
        margin: 0;
        padding: 12px 18px;
        color: #991b1b;
        background: #fff1f2;
        border-bottom: 1px solid #fecaca;
        font-size: 13px;
        font-weight: 700;
    }

    .warning-message {
        color: #92400e;
        background: #fffbeb;
        border-bottom-color: #fde68a;
    }

    .po-grid {
        display: grid;
        grid-template-columns: repeat(5, minmax(0, 1fr));
        gap: 12px;
        padding: 16px 18px;
    }

    .po-field {
        min-width: 0;
        padding: 12px;
        border: 1px solid #e8edf4;
        border-radius: 10px;
        background: #f8fafc;
    }

        .po-field span {
            display: block;
            margin-bottom: 5px;
            color: #64748b;
            font-size: 10px;
            font-weight: 800;
            text-transform: uppercase;
        }

        .po-field strong {
            display: block;
            overflow: hidden;
            color: #172033;
            font-size: 13px;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

    .pdf-link {
        color: #4338ca;
        text-decoration: none;
    }

        .pdf-link:hover {
            text-decoration: underline;
        }

    .material-details {
        border-top: 1px solid #e5eaf2;
    }

        .material-details summary {
            padding: 14px 18px;
            color: #334155;
            cursor: pointer;
            font-size: 13px;
            font-weight: 800;
        }

    .table-wrapper {
        overflow-x: auto;
        border-top: 1px solid #e5eaf2;
    }

    .material-table {
        width: 100%;
        min-width: 1150px;
        border-collapse: collapse;
    }

        .material-table th,
        .material-table td {
            padding: 11px 12px;
            border-bottom: 1px solid #edf0f5;
            text-align: left;
            vertical-align: top;
            font-size: 12px;
        }

        .material-table th {
            color: #526079;
            background: #f8fafc;
            font-size: 10px;
            font-weight: 800;
            text-transform: uppercase;
        }

    .batch-footer {
        position: sticky;
        bottom: 12px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 15px;
        margin-top: 20px;
        padding: 15px 17px;
        border: 1px solid #d6dce8;
        border-radius: 14px;
        background: rgba(255, 255, 255, 0.97);
        box-shadow: 0 15px 35px rgba(20, 32, 60, 0.14);
    }

    .footer-actions {
        display: flex;
        gap: 10px;
    }

    .btn-cancel,
    .btn-save {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 43px;
        padding: 0 17px;
        border-radius: 10px;
        font-weight: 800;
        text-decoration: none;
    }

    .btn-cancel {
        border: 1px solid #d6dce8;
        background: white;
        color: #475569;
    }

    .btn-save {
        border: none;
        background: linear-gradient(135deg, #6366f1, #4338ca);
        color: white;
        cursor: pointer;
    }

        .btn-save:disabled {
            cursor: not-allowed;
            opacity: 0.5;
        }

    .empty-box {
        padding: 40px;
        border: 1px dashed #cbd5e1;
        border-radius: 14px;
        color: #64748b;
        background: white;
        text-align: center;
    }

    @@media (max-width: 1200px) {
        .summary-grid {
            grid-template-columns: repeat(3, minmax(0, 1fr));
        }

        .po-grid {
            grid-template-columns: repeat(3, minmax(0, 1fr));
        }
    }

    @@media (max-width: 768px) {
        .batch-header,
        .selection-toolbar,
        .batch-footer {
            flex-direction: column;
            align-items: stretch;
        }

        .summary-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .po-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .footer-actions {
            width: 100%;
        }

        .btn-cancel,
        .btn-save {
            flex: 1;
        }
    }

    @@media (max-width: 500px) {
        .summary-grid,
        .po-grid {
            grid-template-columns: 1fr;
        }

        .file-header {
            grid-template-columns: auto minmax(0, 1fr);
        }

            .file-header .badge {
                grid-column: 1 / -1;
                justify-self: start;
            }
    }
</style>

<div class="batch-page">

    <div class="batch-header">
        <div>
            <h1>Multiple PO Import Preview</h1>

            <p>
                Review the extracted purchase orders before saving them.
            </p>
        </div>

        <a asp-controller="POImport"
           asp-action="Upload"
           class="btn-back">
            Upload Different Files
        </a>
    </div>

    <div class="summary-grid">

        <div class="summary-card">
            <span>Total Files</span>
            <strong>@Model.TotalFiles</strong>
        </div>

        <div class="summary-card success">
            <span>Successfully Extracted</span>
            <strong>@Model.SuccessfulFiles</strong>
        </div>

        <div class="summary-card danger">
            <span>Failed Files</span>
            <strong>@Model.FailedFiles</strong>
        </div>

        <div class="summary-card warning">
            <span>Duplicate Files</span>
            <strong>@Model.DuplicateFiles</strong>
        </div>

        <div class="summary-card info">
            <span>Existing POs</span>
            <strong>@Model.ExistingPOFiles</strong>
        </div>

        <div class="summary-card">
            <span>Material Rows</span>
            <strong>@Model.TotalMaterialRows</strong>
        </div>

    </div>

    <form asp-controller="POImport"
          asp-action="SaveBatch"
          method="post"
          id="batchSaveForm">

        @Html.AntiForgeryToken()

        <input type="hidden"
               name="BatchId"
               value="@Model.BatchId" />

        <div class="selection-toolbar">

            <div>
                <strong id="selectedCount">0</strong>
                PO file(s) selected for import.
            </div>

            <div class="toolbar-buttons">

                <button type="button"
                        class="btn-small"
                        id="selectAllButton">
                    Select All Valid
                </button>

                <button type="button"
                        class="btn-small"
                        id="clearAllButton">
                    Clear Selection
                </button>

            </div>

        </div>

        @if (Model.Files == null || Model.Files.Count == 0)
        {
            <div class="empty-box">
                No PO files are available for preview.
            </div>
        }
        else
        {
            <div class="file-list">

                @for (var fileIndex = 0;
                      fileIndex < Model.Files.Count;
                      fileIndex++)
                {
                    var file = Model.Files[fileIndex];

                    var canSelect =
                        file.IsSuccessful &&
                        !file.IsDuplicateInBatch &&
                        file.PurchaseOrder != null;

                    var cardClass =
                        !file.IsSuccessful
                            ? "failed"
                            : file.IsDuplicateInBatch
                                ? "duplicate"
                                : "";

                    <div class="file-card @cardClass">

                        <input type="hidden"
                               name="Files[@fileIndex].BatchItemId"
                               value="@file.BatchItemId" />

                        <input type="hidden"
                               name="Files[@fileIndex].OriginalFileName"
                               value="@file.OriginalFileName" />

                        <input type="hidden"
                               name="Files[@fileIndex].FileSize"
                               value="@file.FileSize" />

                        <input type="hidden"
                               name="Files[@fileIndex].IsSuccessful"
                               value="@file.IsSuccessful.ToString().ToLowerInvariant()" />

                        <input type="hidden"
                               name="Files[@fileIndex].IsDuplicateInBatch"
                               value="@file.IsDuplicateInBatch.ToString().ToLowerInvariant()" />

                        <input type="hidden"
                               name="Files[@fileIndex].ExistsInDatabase"
                               value="@file.ExistsInDatabase.ToString().ToLowerInvariant()" />

                        <input type="hidden"
                               name="Files[@fileIndex].ErrorMessage"
                               value="@file.ErrorMessage" />

                        <div class="file-header">

                            <div>
                                @if (canSelect)
                                {
                                    <input type="checkbox"
                                           class="file-checkbox js-file-selector"
                                           name="Files[@fileIndex].IsSelected"
                                           value="true"
                                           checked />

                                    <input type="hidden"
                                           name="Files[@fileIndex].IsSelected"
                                           value="false" />
                                }
                                else
                                {
                                    <input type="checkbox"
                                           class="file-checkbox"
                                           disabled />

                                    <input type="hidden"
                                           name="Files[@fileIndex].IsSelected"
                                           value="false" />
                                }
                            </div>

                            <div>
                                <div class="file-name">
                                    @file.OriginalFileName
                                </div>

                                <div class="file-size">
                                    @((file.FileSize / 1024d / 1024d).ToString("N2")) MB

                                    @if (file.PurchaseOrder?.Items != null)
                                    {
                                        <span>
                                            • @file.PurchaseOrder.Items.Count material row(s)
                                        </span>
                                    }
                                </div>
                            </div>

                            @if (!file.IsSuccessful)
                            {
                                <span class="badge badge-failed">
                                    Failed
                                </span>
                            }
                            else if (file.IsDuplicateInBatch)
                            {
                                <span class="badge badge-duplicate">
                                    Duplicate in Batch
                                </span>
                            }
                            else if (file.ExistsInDatabase)
                            {
                                <span class="badge badge-existing">
                                    Existing PO — Update
                                </span>
                            }
                            else
                            {
                                <span class="badge badge-ready">
                                    Ready to Import
                                </span>
                            }

                        </div>

                        @if (!string.IsNullOrWhiteSpace(file.ErrorMessage))
                        {
                            <p class="error-message @(file.IsDuplicateInBatch ? "warning-message" : "")">
                                @file.ErrorMessage
                            </p>
                        }

                        @if (file.PurchaseOrder != null)
                        {
                            var po = file.PurchaseOrder;

                            <input type="hidden"
                                   name="Files[@fileIndex].PurchaseOrder.PurchaseOrderNo"
                                   value="@po.PurchaseOrderNo" />

                            <input type="hidden"
                                   name="Files[@fileIndex].PurchaseOrder.PODate"
                                   value="@(po.PODate?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture))" />

                            <input type="hidden"
                                   name="Files[@fileIndex].PurchaseOrder.ReceivedDate"
                                   value="@(po.ReceivedDate?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture))" />

                            <input type="hidden"
                                   name="Files[@fileIndex].PurchaseOrder.BuyerContactPerson"
                                   value="@po.BuyerContactPerson" />

                            <input type="hidden"
                                   name="Files[@fileIndex].PurchaseOrder.UploadedPdfPath"
                                   value="@po.UploadedPdfPath" />

                            <div class="po-grid">

                                <div class="po-field">
                                    <span>PO Number</span>
                                    <strong>@po.PurchaseOrderNo</strong>
                                </div>

                                <div class="po-field">
                                    <span>Date of Order</span>
                                    <strong>
                                        @(po.PODate?.ToString("dd-MMM-yyyy")
                                            ?? "Not detected")
                                    </strong>
                                </div>

                                <div class="po-field">
                                    <span>Received Date</span>
                                    <strong>
                                        @(po.ReceivedDate?.ToString("dd-MMM-yyyy")
                                            ?? "Not detected")
                                    </strong>
                                </div>

                                <div class="po-field">
                                    <span>Buyer / Handler</span>
                                    <strong>
                                        @(string.IsNullOrWhiteSpace(po.BuyerContactPerson)
                                            ? "Not detected"
                                            : po.BuyerContactPerson)
                                    </strong>
                                </div>

                                <div class="po-field">
                                    <span>Uploaded PDF</span>

                                    <strong>
                                        @if (!string.IsNullOrWhiteSpace(po.UploadedPdfPath))
                                        {
                                            <a href="@po.UploadedPdfPath"
                                               target="_blank"
                                               class="pdf-link">
                                                Open PDF
                                            </a>
                                        }
                                        else
                                        {
                                            <span>Not available</span>
                                        }
                                    </strong>
                                </div>

                            </div>

                            @if (po.Items != null &&
                                 po.Items.Count > 0)
                            {
                                <details class="material-details">

                                    <summary>
                                        View @po.Items.Count extracted material row(s)
                                    </summary>

                                    <div class="table-wrapper">

                                        <table class="material-table">

                                            <thead>
                                                <tr>
                                                    <th>Line</th>
                                                    <th>Material No.</th>
                                                    <th>HSN/SAC</th>
                                                    <th>Description</th>
                                                    <th>Quantity</th>
                                                    <th>Unit</th>
                                                    <th>Department</th>
                                                    <th>Rate</th>
                                                    <th>Price Unit</th>
                                                    <th>Total</th>
                                                    <th>Delivery Date</th>
                                                    <th>Drawing No.</th>
                                                </tr>
                                            </thead>

                                            <tbody>

                                                @for (var itemIndex = 0;
                                                      itemIndex < po.Items.Count;
                                                      itemIndex++)
                                                {
                                                    var item =
                                                        po.Items[itemIndex];

                                                    <tr>

                                                        <td>
                                                            <input type="hidden"
                                                                   name="Files[@fileIndex].PurchaseOrder.Items[@itemIndex].LineItem"
                                                                   value="@item.LineItem" />

                                                            <input type="hidden"
                                                                   name="Files[@fileIndex].PurchaseOrder.Items[@itemIndex].MaterialNo"
                                                                   value="@item.MaterialNo" />

                                                            <input type="hidden"
                                                                   name="Files[@fileIndex].PurchaseOrder.Items[@itemIndex].HsnSacCode"
                                                                   value="@item.HsnSacCode" />

                                                            <input type="hidden"
                                                                   name="Files[@fileIndex].PurchaseOrder.Items[@itemIndex].Quantity"
                                                                   value="@item.Quantity.ToString(CultureInfo.InvariantCulture)" />

                                                            <input type="hidden"
                                                                   name="Files[@fileIndex].PurchaseOrder.Items[@itemIndex].Unit"
                                                                   value="@item.Unit" />

                                                            <input type="hidden"
                                                                   name="Files[@fileIndex].PurchaseOrder.Items[@itemIndex].Dep"
                                                                   value="@item.Dep" />

                                                            <input type="hidden"
                                                                   name="Files[@fileIndex].PurchaseOrder.Items[@itemIndex].ValueOfGoods"
                                                                   value="@item.ValueOfGoods.ToString(CultureInfo.InvariantCulture)" />

                                                            <input type="hidden"
                                                                   name="Files[@fileIndex].PurchaseOrder.Items[@itemIndex].PriceUnit"
                                                                   value="@item.PriceUnit" />

                                                            <input type="hidden"
                                                                   name="Files[@fileIndex].PurchaseOrder.Items[@itemIndex].TotalValue"
                                                                   value="@item.TotalValue.ToString(CultureInfo.InvariantCulture)" />

                                                            <input type="hidden"
                                                                   name="Files[@fileIndex].PurchaseOrder.Items[@itemIndex].DeliveryDate"
                                                                   value="@(item.DeliveryDate?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture))" />

                                                            <input type="hidden"
                                                                   name="Files[@fileIndex].PurchaseOrder.Items[@itemIndex].ShortDescription"
                                                                   value="@item.ShortDescription" />

                                                            <textarea hidden
                                                                      name="Files[@fileIndex].PurchaseOrder.Items[@itemIndex].FullDescription">@item.FullDescription</textarea>

                                                            <input type="hidden"
                                                                   name="Files[@fileIndex].PurchaseOrder.Items[@itemIndex].DrawingNo"
                                                                   value="@item.DrawingNo" />

                                                            @item.LineItem
                                                        </td>

                                                        <td>
                                                            <strong>@item.MaterialNo</strong>
                                                        </td>

                                                        <td>@item.HsnSacCode</td>

                                                        <td>
                                                            @(string.IsNullOrWhiteSpace(item.ShortDescription)
                                                                ? item.FullDescription
                                                                : item.ShortDescription)
                                                        </td>

                                                        <td>
                                                            @item.Quantity.ToString("0.##")
                                                        </td>

                                                        <td>@item.Unit</td>

                                                        <td>@item.Dep</td>

                                                        <td>
                                                            @item.ValueOfGoods.ToString("N2")
                                                        </td>

                                                        <td>@item.PriceUnit</td>

                                                        <td>
                                                            @item.TotalValue.ToString("N2")
                                                        </td>

                                                        <td>
                                                            @(item.DeliveryDate?.ToString("dd-MMM-yyyy")
                                                                ?? "-")
                                                        </td>

                                                        <td>@item.DrawingNo</td>

                                                    </tr>
                                                }

                                            </tbody>

                                        </table>

                                    </div>

                                </details>
                            }
                        }

                    </div>
                }

            </div>
        }

        <div class="batch-footer">

            <div>
                <strong id="footerSelectedCount">0</strong>
                valid PO file(s) will be saved.
            </div>

            <div class="footer-actions">

                <a asp-controller="POImport"
                   asp-action="Upload"
                   class="btn-cancel">
                    Cancel
                </a>

                <button type="submit"
                        class="btn-save"
                        id="saveBatchButton"
                        disabled>
                    Import Selected POs
                </button>

            </div>

        </div>

    </form>

</div>

<script>
    (() => {

        const selectors =
            Array.from(
                document.querySelectorAll(
                    ".js-file-selector"
                )
            );

        const selectedCount =
            document.getElementById(
                "selectedCount"
            );

        const footerSelectedCount =
            document.getElementById(
                "footerSelectedCount"
            );

        const selectAllButton =
            document.getElementById(
                "selectAllButton"
            );

        const clearAllButton =
            document.getElementById(
                "clearAllButton"
            );

        const saveBatchButton =
            document.getElementById(
                "saveBatchButton"
            );

        const batchSaveForm =
            document.getElementById(
                "batchSaveForm"
            );

        function updateSelectedCount() {

            const count =
                selectors.filter(
                    checkbox => checkbox.checked
                ).length;

            selectedCount.textContent =
                count.toString();

            footerSelectedCount.textContent =
                count.toString();

            saveBatchButton.disabled =
                count === 0;
        }

        selectors.forEach(checkbox => {

            checkbox.addEventListener(
                "change",
                updateSelectedCount
            );

        });

        selectAllButton?.addEventListener(
            "click",
            () => {

                selectors.forEach(
                    checkbox => {
                        checkbox.checked = true;
                    }
                );

                updateSelectedCount();
            }
        );

        clearAllButton?.addEventListener(
            "click",
            () => {

                selectors.forEach(
                    checkbox => {
                        checkbox.checked = false;
                    }
                );

                updateSelectedCount();
            }
        );

        batchSaveForm?.addEventListener(
            "submit",
            event => {

                const count =
                    selectors.filter(
                        checkbox => checkbox.checked
                    ).length;

                if (count === 0) {

                    event.preventDefault();

                    return;
                }

                saveBatchButton.disabled =
                    true;

                saveBatchButton.textContent =
                    "Importing POs...";
            }
        );

        updateSelectedCount();

    })();
</script>