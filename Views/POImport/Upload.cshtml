@{
    ViewData["Title"] = "Import Multiple PO PDFs";
}

<style>
    .po-upload-page {
        --po-primary: #4f6ef7;
        --po-primary-dark: #3f57d9;
        --po-primary-soft: #eef2ff;
        --po-text: #172033;
        --po-muted: #6b7890;
        --po-border: #dde4ef;
        --po-surface: #ffffff;
        --po-bg: #f5f7fb;
        --po-danger: #b42318;
        --po-danger-bg: #fff0ee;
        --po-success: #137a48;
        --po-shadow: 0 18px 45px rgba(31, 45, 79, 0.08);
        width: 100%;
        color: var(--po-text);
    }

        .po-upload-page *,
        .po-upload-page *::before,
        .po-upload-page *::after {
            box-sizing: border-box;
        }

    .po-upload-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 18px;
        margin-bottom: 22px;
    }

    .po-upload-title-wrap {
        min-width: 0;
    }

    .po-upload-eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 8px;
        color: var(--po-primary);
        font-size: 12px;
        font-weight: 900;
        letter-spacing: 0.08em;
        text-transform: uppercase;
    }

        .po-upload-eyebrow::before {
            content: "";
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: var(--po-primary);
            box-shadow: 0 0 0 5px rgba(79, 110, 247, 0.12);
        }

    .po-upload-header h2 {
        margin: 0;
        font-size: clamp(26px, 3vw, 36px);
        line-height: 1.12;
        letter-spacing: -0.04em;
        color: var(--po-text);
    }

    .po-upload-header p {
        max-width: 720px;
        margin: 9px 0 0;
        color: var(--po-muted);
        font-size: 15px;
        line-height: 1.7;
    }

    .po-back-link {
        flex: 0 0 auto;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        min-height: 44px;
        padding: 0 16px;
        border: 1px solid var(--po-border);
        border-radius: 12px;
        background: var(--po-surface);
        color: #334155;
        text-decoration: none;
        font-size: 14px;
        font-weight: 800;
        box-shadow: 0 7px 18px rgba(31, 45, 79, 0.05);
        transition: 0.2s ease;
    }

        .po-back-link:hover {
            transform: translateY(-1px);
            border-color: #c7d2fe;
            color: var(--po-primary-dark);
        }

    .po-alert {
        display: flex;
        align-items: flex-start;
        gap: 12px;
        margin-bottom: 18px;
        padding: 14px 16px;
        border: 1px solid #fecaca;
        border-radius: 14px;
        background: var(--po-danger-bg);
        color: var(--po-danger);
        font-size: 14px;
        font-weight: 700;
        line-height: 1.5;
    }

    .po-alert-icon {
        flex: 0 0 auto;
        display: grid;
        place-items: center;
        width: 28px;
        height: 28px;
        border-radius: 9px;
        background: #ffe1dc;
        font-size: 15px;
    }

    .po-upload-layout {
        display: grid;
        grid-template-columns: minmax(0, 1.55fr) minmax(260px, 0.7fr);
        gap: 20px;
        align-items: stretch;
    }

    .po-upload-card,
    .po-info-card {
        border: 1px solid var(--po-border);
        border-radius: 20px;
        background: var(--po-surface);
        box-shadow: var(--po-shadow);
    }

    .po-upload-card {
        padding: clamp(20px, 3vw, 32px);
    }

    .po-card-heading {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 14px;
        margin-bottom: 20px;
    }

        .po-card-heading h3 {
            margin: 0;
            color: var(--po-text);
            font-size: 20px;
            letter-spacing: -0.02em;
        }

        .po-card-heading p {
            margin: 6px 0 0;
            color: var(--po-muted);
            font-size: 14px;
            line-height: 1.55;
        }

    .po-secure-badge {
        flex: 0 0 auto;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 7px 10px;
        border-radius: 999px;
        background: #ecfdf3;
        color: var(--po-success);
        font-size: 12px;
        font-weight: 900;
        white-space: nowrap;
    }

    .po-drop-zone {
        position: relative;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        min-height: 290px;
        padding: 28px;
        border: 2px dashed #bcc8dc;
        border-radius: 18px;
        background: radial-gradient(circle at top right, rgba(79, 110, 247, 0.09), transparent 34%), linear-gradient(180deg, #fbfcff, #f7f9fd);
        text-align: center;
        cursor: pointer;
        transition: 0.22s ease;
        outline: none;
    }

        .po-drop-zone:hover,
        .po-drop-zone:focus-visible,
        .po-drop-zone.is-dragging {
            border-color: var(--po-primary);
            background: radial-gradient(circle at top right, rgba(79, 110, 247, 0.15), transparent 36%), linear-gradient(180deg, #f8faff, #f1f5ff);
            transform: translateY(-1px);
        }

        .po-drop-zone.has-file {
            border-style: solid;
            border-color: #9fb0ff;
            background: var(--po-primary-soft);
        }

    .po-file-input {
        position: absolute;
        width: 1px;
        height: 1px;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
        white-space: nowrap;
        clip-path: inset(50%);
    }

    .po-upload-icon {
        display: grid;
        place-items: center;
        width: 74px;
        height: 74px;
        margin-bottom: 18px;
        border-radius: 22px;
        background: linear-gradient(135deg, #5d78ff, #4057d7);
        color: #fff;
        box-shadow: 0 16px 32px rgba(79, 110, 247, 0.28);
        font-size: 34px;
    }

    .po-drop-zone h4 {
        margin: 0;
        color: var(--po-text);
        font-size: 19px;
    }

    .po-drop-zone p {
        margin: 9px 0 0;
        color: var(--po-muted);
        font-size: 14px;
        line-height: 1.55;
    }

    .po-browse-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 42px;
        margin-top: 18px;
        padding: 0 17px;
        border: 1px solid #c8d2ff;
        border-radius: 11px;
        background: #fff;
        color: var(--po-primary-dark);
        font-size: 14px;
        font-weight: 900;
        box-shadow: 0 7px 18px rgba(79, 110, 247, 0.08);
    }

    .po-selection-summary {
        display: none;
        width: 100%;
        max-width: 560px;
        margin-top: 20px;
        padding: 13px 14px;
        border: 1px solid #cbd5ff;
        border-radius: 13px;
        background: #fff;
        text-align: left;
    }

    .po-drop-zone.has-file .po-selection-summary {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .po-file-icon {
        flex: 0 0 auto;
        display: grid;
        place-items: center;
        width: 42px;
        height: 42px;
        border-radius: 11px;
        background: #fee2e2;
        color: #b91c1c;
        font-size: 12px;
        font-weight: 900;
    }

    .po-selection-copy {
        min-width: 0;
        flex: 1;
    }

    .po-selected-count {
        display: block;
        color: #24314a;
        font-size: 13px;
        font-weight: 900;
    }

    .po-selected-total {
        display: block;
        margin-top: 3px;
        color: var(--po-muted);
        font-size: 12px;
        font-weight: 700;
    }

    .po-file-panel {
        margin-top: 16px;
        border: 1px solid var(--po-border);
        border-radius: 15px;
        background: #fbfcff;
        overflow: hidden;
    }

        .po-file-panel[hidden] {
            display: none;
        }

    .po-file-panel-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        padding: 13px 15px;
        border-bottom: 1px solid var(--po-border);
        background: #f8faff;
    }

    .po-file-panel-title {
        color: #26334c;
        font-size: 13px;
        font-weight: 900;
    }

    .po-clear-files {
        border: 0;
        background: transparent;
        color: #b42318;
        font-size: 12px;
        font-weight: 900;
        cursor: pointer;
    }

        .po-clear-files:hover {
            text-decoration: underline;
        }

    .po-file-list {
        display: grid;
        gap: 9px;
        max-height: 310px;
        padding: 12px;
        overflow-y: auto;
    }

    .po-file-row {
        display: flex;
        align-items: center;
        gap: 11px;
        min-width: 0;
        padding: 11px 12px;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        background: #fff;
    }

    .po-file-number {
        flex: 0 0 auto;
        display: grid;
        place-items: center;
        width: 29px;
        height: 29px;
        border-radius: 9px;
        background: var(--po-primary-soft);
        color: var(--po-primary-dark);
        font-size: 11px;
        font-weight: 900;
    }

    .po-file-meta {
        min-width: 0;
        flex: 1;
    }

    .po-file-name {
        display: block;
        overflow: hidden;
        color: #24314a;
        font-size: 13px;
        font-weight: 900;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .po-file-size {
        display: block;
        margin-top: 3px;
        color: var(--po-muted);
        font-size: 12px;
        font-weight: 700;
    }

    .po-remove-file {
        flex: 0 0 auto;
        width: 34px;
        height: 34px;
        border: 0;
        border-radius: 10px;
        background: #f1f5f9;
        color: #64748b;
        font-size: 18px;
        font-weight: 900;
        cursor: pointer;
    }

        .po-remove-file:hover {
            background: #fee2e2;
            color: #b91c1c;
        }

    .po-file-validation {
        margin-top: 13px;
        padding: 12px 14px;
        border: 1px solid #fed7aa;
        border-radius: 12px;
        background: #fff7ed;
        color: #9a3412;
        font-size: 12px;
        font-weight: 800;
        line-height: 1.55;
    }

        .po-file-validation[hidden] {
            display: none;
        }

    .po-form-footer {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 16px;
        margin-top: 20px;
    }

    .po-helper-text {
        display: flex;
        align-items: center;
        gap: 8px;
        color: var(--po-muted);
        font-size: 12px;
        font-weight: 700;
    }

    .po-submit-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 9px;
        min-width: 170px;
        min-height: 46px;
        padding: 0 20px;
        border: 0;
        border-radius: 12px;
        background: linear-gradient(135deg, #5d78ff, #4057d7);
        color: #fff;
        font-size: 14px;
        font-weight: 900;
        box-shadow: 0 13px 26px rgba(79, 110, 247, 0.25);
        cursor: pointer;
        transition: 0.2s ease;
    }

        .po-submit-button:hover:not(:disabled) {
            transform: translateY(-1px);
            box-shadow: 0 16px 30px rgba(79, 110, 247, 0.31);
        }

        .po-submit-button:disabled {
            background: #cbd5e1;
            box-shadow: none;
            cursor: not-allowed;
        }

        .po-submit-button.is-loading {
            pointer-events: none;
        }

    .po-spinner {
        display: none;
        width: 17px;
        height: 17px;
        border: 2px solid rgba(255, 255, 255, 0.45);
        border-top-color: #fff;
        border-radius: 50%;
        animation: po-spin 0.75s linear infinite;
    }

    .po-submit-button.is-loading .po-spinner {
        display: inline-block;
    }

    .po-submit-button.is-loading .po-submit-icon {
        display: none;
    }

    @@keyframes po-spin {
        to {
            transform: rotate(360deg);
        }
    }

    .po-info-card {
        display: flex;
        flex-direction: column;
        padding: 24px;
        overflow: hidden;
    }

    .po-info-visual {
        display: grid;
        place-items: center;
        min-height: 132px;
        margin: -24px -24px 22px;
        background: radial-gradient(circle at 75% 20%, rgba(255,255,255,0.18), transparent 28%), linear-gradient(140deg, #16213f, #304d9c 58%, #5571ed);
        color: #fff;
        font-size: 52px;
    }

    .po-info-card h3 {
        margin: 0;
        color: var(--po-text);
        font-size: 18px;
    }

    .po-info-card > p {
        margin: 8px 0 0;
        color: var(--po-muted);
        font-size: 13px;
        line-height: 1.6;
    }

    .po-step-list {
        display: grid;
        gap: 14px;
        margin: 22px 0 0;
        padding: 0;
        list-style: none;
    }

    .po-step-item {
        display: flex;
        align-items: flex-start;
        gap: 12px;
    }

    .po-step-number {
        flex: 0 0 auto;
        display: grid;
        place-items: center;
        width: 30px;
        height: 30px;
        border-radius: 10px;
        background: var(--po-primary-soft);
        color: var(--po-primary-dark);
        font-size: 12px;
        font-weight: 900;
    }

    .po-step-copy strong {
        display: block;
        color: #26334c;
        font-size: 13px;
    }

    .po-step-copy span {
        display: block;
        margin-top: 3px;
        color: var(--po-muted);
        font-size: 12px;
        line-height: 1.45;
    }

    .po-note {
        margin-top: auto;
        padding-top: 20px;
    }

    .po-note-box {
        padding: 13px 14px;
        border: 1px solid #dbe4f2;
        border-radius: 13px;
        background: #f8fafc;
        color: #53627a;
        font-size: 12px;
        font-weight: 700;
        line-height: 1.55;
    }

    @@media (max-width: 980px) {
        .po-upload-layout {
            grid-template-columns: 1fr;
        }

        .po-info-card {
            min-height: auto;
        }

        .po-note {
            margin-top: 18px;
        }
    }

    @@media (max-width: 680px) {
        .po-upload-header {
            flex-direction: column;
        }

        .po-back-link {
            width: 100%;
        }

        .po-card-heading,
        .po-form-footer {
            flex-direction: column;
            align-items: stretch;
        }

        .po-secure-badge {
            align-self: flex-start;
        }

        .po-submit-button {
            width: 100%;
        }

        .po-drop-zone {
            min-height: 250px;
            padding: 22px 16px;
        }
    }
</style>

<div class="po-upload-page">

    <div class="po-upload-header">
        <div class="po-upload-title-wrap">
            <div class="po-upload-eyebrow">Purchase Order Automation</div>
            <h2>Import Multiple PO PDFs</h2>
            <p>
                Upload up to 20 WEG purchase order PDFs together. The system processes each file
                separately and prepares a batch preview before anything is saved.
            </p>
        </div>

        <a asp-controller="Material"
           asp-action="Index"
           class="po-back-link">
            <span aria-hidden="true">←</span>
            Back to Materials
        </a>
    </div>

    @if (ViewBag.Error != null)
    {
        <div class="po-alert" role="alert">
            <div class="po-alert-icon">!</div>
            <div>@ViewBag.Error</div>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="po-alert" role="alert">
            <div class="po-alert-icon">!</div>
            <div>@TempData["Error"]</div>
        </div>
    }

    <div class="po-upload-layout">

        <section class="po-upload-card">
            <div class="po-card-heading">
                <div>
                    <h3>Select purchase order PDFs</h3>
                    <p>Select one or more PDF files. You can remove individual files before extraction.</p>
                </div>

                <div class="po-secure-badge">
                    <span aria-hidden="true">✓</span>
                    Batch preview before save
                </div>
            </div>

            <form asp-action="UploadBatch"
                  asp-controller="POImport"
                  method="post"
                  enctype="multipart/form-data"
                  id="poUploadForm">

                @Html.AntiForgeryToken()

                <div class="po-drop-zone"
                     id="poDropZone"
                     role="button"
                     tabindex="0"
                     aria-label="Select or drop purchase order PDF files">

                    <input type="file"
                           id="pdfFiles"
                           name="pdfFiles"
                           class="po-file-input"
                           accept="application/pdf,.pdf"
                           multiple
                           required />

                    <div class="po-upload-icon" aria-hidden="true">⇧</div>

                    <h4>Drop your PO PDFs here</h4>
                    <p>Select up to 20 PDF files, or add more files after your first selection.</p>

                    <span class="po-browse-button">Choose PDF files</span>

                    <div class="po-selection-summary" id="poSelectionSummary" aria-live="polite">
                        <div class="po-file-icon" aria-hidden="true">PDF</div>

                        <div class="po-selection-copy">
                            <span class="po-selected-count" id="poSelectedCount">0 files selected</span>
                            <span class="po-selected-total" id="poSelectedTotal">0 MB total</span>
                        </div>
                    </div>
                </div>

                <div class="po-file-panel" id="poFilePanel" hidden>
                    <div class="po-file-panel-header">
                        <span class="po-file-panel-title">Selected PO files</span>

                        <button type="button"
                                class="po-clear-files"
                                id="poClearFiles">
                            Clear all
                        </button>
                    </div>

                    <div class="po-file-list" id="poFileList"></div>
                </div>

                <div class="po-file-validation"
                     id="poFileValidation"
                     role="alert"
                     hidden></div>

                <div class="po-form-footer">
                    <div class="po-helper-text">
                        <span aria-hidden="true">ⓘ</span>
                        Maximum 20 files · 20 MB each · 200 MB combined
                    </div>

                    <button type="submit"
                            class="po-submit-button"
                            id="poSubmitButton"
                            disabled>
                        <span class="po-submit-icon" aria-hidden="true">✦</span>
                        <span class="po-spinner" aria-hidden="true"></span>
                        <span id="poSubmitText">Extract Selected POs</span>
                    </button>
                </div>
            </form>
        </section>

        <aside class="po-info-card">
            <div class="po-info-visual" aria-hidden="true">📚</div>

            <h3>How batch PO import works</h3>
            <p>Every original PDF remains linked with its purchase order for future reference.</p>

            <ol class="po-step-list">
                <li class="po-step-item">
                    <div class="po-step-number">1</div>
                    <div class="po-step-copy">
                        <strong>Select multiple PDFs</strong>
                        <span>Choose or drag up to 20 purchase order PDF files at one time.</span>
                    </div>
                </li>

                <li class="po-step-item">
                    <div class="po-step-number">2</div>
                    <div class="po-step-copy">
                        <strong>Review batch extraction</strong>
                        <span>Successful, failed, duplicate and existing POs are shown separately.</span>
                    </div>
                </li>

                <li class="po-step-item">
                    <div class="po-step-number">3</div>
                    <div class="po-step-copy">
                        <strong>Save selected POs</strong>
                        <span>Only valid and selected purchase orders will be imported into PO Tracker.</span>
                    </div>
                </li>
            </ol>

            <div class="po-note">
                <div class="po-note-box">
                    For best extraction accuracy, upload original text-based PDFs rather than scanned images.
                    One invalid PDF will not stop the other files from being processed.
                </div>
            </div>
        </aside>

    </div>
</div>

@section Scripts {
    <script>
        (() => {
            const form = document.getElementById("poUploadForm");
            const dropZone = document.getElementById("poDropZone");
            const fileInput = document.getElementById("pdfFiles");
            const filePanel = document.getElementById("poFilePanel");
            const fileList = document.getElementById("poFileList");
            const clearButton = document.getElementById("poClearFiles");
            const selectedCount = document.getElementById("poSelectedCount");
            const selectedTotal = document.getElementById("poSelectedTotal");
            const validationBox = document.getElementById("poFileValidation");
            const submitButton = document.getElementById("poSubmitButton");
            const submitText = document.getElementById("poSubmitText");

            if (!form ||
                !dropZone ||
                !fileInput ||
                !filePanel ||
                !fileList ||
                !submitButton) {
                return;
            }

            const maxFileCount = 100;
            const maxFileSize = 20 * 1024 * 1024;
            const maxTotalSize = 200 * 1024 * 1024;

            let selectedFiles = [];

            function formatBytes(bytes) {
                if (!bytes) {
                    return "0 KB";
                }

                const units = ["B", "KB", "MB", "GB"];
                const index = Math.min(
                    Math.floor(Math.log(bytes) / Math.log(1024)),
                    units.length - 1
                );

                const value = bytes / Math.pow(1024, index);

                return `${value.toFixed(index === 0 ? 0 : 1)} ${units[index]}`;
            }

            function isPdf(file) {
                return file && (
                    file.type === "application/pdf" ||
                    file.name.toLowerCase().endsWith(".pdf")
                );
            }

            function fileKey(file) {
                return `${file.name}|${file.size}|${file.lastModified}`;
            }

            function getTotalSize() {
                return selectedFiles.reduce(
                    (total, file) => total + file.size,
                    0
                );
            }

            function showValidation(messages) {
                if (!validationBox) {
                    return;
                }

                if (!messages || messages.length === 0) {
                    validationBox.hidden = true;
                    validationBox.innerHTML = "";
                    return;
                }

                validationBox.hidden = false;
                validationBox.innerHTML = messages
                    .map(message => `<div>• ${escapeHtml(message)}</div>`)
                    .join("");
            }

            function escapeHtml(value) {
                return String(value)
                    .replaceAll("&", "&amp;")
                    .replaceAll("<", "&lt;")
                    .replaceAll(">", "&gt;")
                    .replaceAll('"', "&quot;")
                    .replaceAll("'", "&#039;");
            }

            function syncInputFiles() {
                const transfer = new DataTransfer();

                selectedFiles.forEach(file => {
                    transfer.items.add(file);
                });

                fileInput.files = transfer.files;
            }

            function renderFiles() {
                const totalSize = getTotalSize();
                const hasFiles = selectedFiles.length > 0;

                dropZone.classList.toggle("has-file", hasFiles);
                filePanel.hidden = !hasFiles;
                submitButton.disabled = !hasFiles;

                if (selectedCount) {
                    selectedCount.textContent = hasFiles
                        ? `${selectedFiles.length} file${selectedFiles.length === 1 ? "" : "s"} selected`
                        : "0 files selected";
                }

                if (selectedTotal) {
                    selectedTotal.textContent = `${formatBytes(totalSize)} total`;
                }

                fileList.innerHTML = "";

                selectedFiles.forEach((file, index) => {
                    const row = document.createElement("div");
                    row.className = "po-file-row";

                    const number = document.createElement("div");
                    number.className = "po-file-number";
                    number.textContent = String(index + 1);

                    const meta = document.createElement("div");
                    meta.className = "po-file-meta";

                    const name = document.createElement("span");
                    name.className = "po-file-name";
                    name.textContent = file.name;
                    name.title = file.name;

                    const size = document.createElement("span");
                    size.className = "po-file-size";
                    size.textContent = formatBytes(file.size);

                    const remove = document.createElement("button");
                    remove.type = "button";
                    remove.className = "po-remove-file";
                    remove.setAttribute(
                        "aria-label",
                        `Remove ${file.name}`
                    );
                    remove.textContent = "×";
                    remove.addEventListener("click", () => {
                        selectedFiles.splice(index, 1);
                        syncInputFiles();
                        renderFiles();
                        showValidation([]);
                    });

                    meta.appendChild(name);
                    meta.appendChild(size);

                    row.appendChild(number);
                    row.appendChild(meta);
                    row.appendChild(remove);

                    fileList.appendChild(row);
                });
            }

            function addFiles(files) {
                const messages = [];
                const existingKeys = new Set(
                    selectedFiles.map(fileKey)
                );

                for (const file of Array.from(files || [])) {
                    if (!isPdf(file)) {
                        messages.push(`${file.name} was skipped because it is not a PDF.`);
                        continue;
                    }

                    if (file.size > maxFileSize) {
                        messages.push(`${file.name} was skipped because it is larger than 20 MB.`);
                        continue;
                    }

                    if (existingKeys.has(fileKey(file))) {
                        messages.push(`${file.name} is already selected.`);
                        continue;
                    }

                    if (selectedFiles.length >= maxFileCount) {
                        messages.push(`Only ${maxFileCount} PDF files can be selected at one time.`);
                        break;
                    }

                    if (getTotalSize() + file.size > maxTotalSize) {
                        messages.push(`${file.name} was skipped because the combined size would exceed 200 MB.`);
                        continue;
                    }

                    selectedFiles.push(file);
                    existingKeys.add(fileKey(file));
                }

                syncInputFiles();
                renderFiles();
                showValidation(messages);
            }

            dropZone.addEventListener("click", event => {
                if (event.target.closest("button")) {
                    return;
                }

                fileInput.click();
            });

            dropZone.addEventListener("keydown", event => {
                if (event.key === "Enter" || event.key === " ") {
                    event.preventDefault();
                    fileInput.click();
                }
            });

            fileInput.addEventListener("change", () => {
                const newFiles = Array.from(fileInput.files || []);

                // Keep the previously selected files in JavaScript,
                // then merge the new browser selection into them.
                addFiles(newFiles);
            });

            ["dragenter", "dragover"].forEach(eventName => {
                dropZone.addEventListener(eventName, event => {
                    event.preventDefault();
                    dropZone.classList.add("is-dragging");
                });
            });

            ["dragleave", "drop"].forEach(eventName => {
                dropZone.addEventListener(eventName, event => {
                    event.preventDefault();
                    dropZone.classList.remove("is-dragging");
                });
            });

            dropZone.addEventListener("drop", event => {
                addFiles(event.dataTransfer?.files || []);
            });

            clearButton?.addEventListener("click", () => {
                selectedFiles = [];
                syncInputFiles();
                renderFiles();
                showValidation([]);
            });

            form.addEventListener("submit", event => {
                if (selectedFiles.length === 0) {
                    event.preventDefault();
                    showValidation(["Please select at least one PO PDF file."]);
                    return;
                }

                if (selectedFiles.length > maxFileCount ||
                    getTotalSize() > maxTotalSize ||
                    selectedFiles.some(file => !isPdf(file) || file.size > maxFileSize)) {
                    event.preventDefault();
                    showValidation(["Please correct the selected files before continuing."]);
                    return;
                }

                syncInputFiles();
                submitButton.disabled = true;
                submitButton.classList.add("is-loading");
                submitText.textContent = `Extracting ${selectedFiles.length} PO${selectedFiles.length === 1 ? "" : "s"}...`;
            });

            renderFiles();
        })();
    </script>
}
