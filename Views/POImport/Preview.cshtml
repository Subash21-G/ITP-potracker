@model POTracker.ViewModels.POImportPreviewViewModel

@{
    ViewData["Title"] = "PO Import Preview";

    var itemCount = Model?.Items?.Count ?? 0;
    var totalQuantity = Model?.Items?.Sum(x => x.Quantity) ?? 0m;
    var extractedItemValue = Model?.Items?.Sum(x => x.TotalValue) ?? 0m;

    var basicValue =
        (Model?.BasicValue ?? 0m) > 0
            ? Model!.BasicValue
            : extractedItemValue;

    var taxValue = Model?.TaxValue ?? 0m;

    var grandTotal =
        (Model?.GrandTotal ?? 0m) > 0
            ? Model!.GrandTotal
            : basicValue + taxValue;
}

<style>
    .po-preview-page {
        --po-primary: #4f6df5;
        --po-primary-dark: #3854d8;
        --po-success: #059669;
        --po-danger: #dc2626;
        --po-warning: #d97706;
        --po-card: #ffffff;
        --po-border: #e4e9f2;
        --po-text: #172033;
        --po-muted: #68748a;
        padding: 26px;
        color: var(--po-text);
    }

        .po-preview-page *,
        .po-preview-page *::before,
        .po-preview-page *::after {
            box-sizing: border-box;
        }

    .po-preview-header {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 20px;
        margin-bottom: 22px;
    }

    .po-preview-title-wrap {
        display: flex;
        align-items: flex-start;
        gap: 14px;
    }

    .po-preview-icon {
        width: 50px;
        height: 50px;
        flex: 0 0 50px;
        border-radius: 15px;
        display: grid;
        place-items: center;
        background: linear-gradient(135deg, #4f6df5, #7357e8);
        color: #fff;
        font-size: 22px;
        box-shadow: 0 12px 26px rgba(79, 109, 245, .24);
    }

    .po-preview-header h1 {
        margin: 0;
        font-size: 27px;
        line-height: 1.2;
        letter-spacing: -.02em;
    }

    .po-preview-header p {
        margin: 7px 0 0;
        color: var(--po-muted);
        font-size: 14px;
    }

    .po-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        min-height: 42px;
        padding: 10px 16px;
        border: 0;
        border-radius: 11px;
        text-decoration: none;
        font-size: 14px;
        font-weight: 800;
        cursor: pointer;
        transition: .18s ease;
        white-space: nowrap;
    }

        .po-btn:hover {
            transform: translateY(-1px);
        }

    .po-btn-primary {
        background: linear-gradient(135deg, var(--po-primary), #6c5ce7);
        color: #fff;
        box-shadow: 0 10px 22px rgba(79, 109, 245, .22);
    }

        .po-btn-primary:hover {
            background: linear-gradient(135deg, var(--po-primary-dark), #5945cf);
            color: #fff;
        }

    .po-btn-secondary {
        background: #eef1f6;
        color: #344054;
        border: 1px solid #dfe5ee;
    }

        .po-btn-secondary:hover {
            background: #e4e9f1;
            color: #172033;
        }

    .po-alert {
        display: flex;
        align-items: flex-start;
        gap: 11px;
        padding: 14px 16px;
        margin-bottom: 18px;
        border-radius: 12px;
        font-size: 14px;
        font-weight: 700;
    }

    .po-alert-danger {
        color: #991b1b;
        background: #fef2f2;
        border: 1px solid #fecaca;
    }

    .po-alert-warning {
        color: #92400e;
        background: #fffbeb;
        border: 1px solid #fde68a;
    }

    .po-warning-list {
        margin: 7px 0 0;
        padding-left: 20px;
        font-weight: 600;
    }

    .po-summary-grid {
        display: grid;
        grid-template-columns: repeat(5, minmax(0, 1fr));
        gap: 14px;
        margin-bottom: 20px;
    }

    .po-summary-card {
        display: flex;
        align-items: center;
        gap: 13px;
        min-width: 0;
        padding: 17px;
        background: var(--po-card);
        border: 1px solid var(--po-border);
        border-radius: 15px;
        box-shadow: 0 8px 24px rgba(16, 24, 40, .05);
    }

    .po-summary-badge {
        width: 42px;
        height: 42px;
        flex: 0 0 42px;
        border-radius: 12px;
        display: grid;
        place-items: center;
        font-size: 18px;
        background: #edf1ff;
        color: var(--po-primary);
    }

    .po-summary-card:nth-child(2) .po-summary-badge {
        background: #ecfdf3;
        color: #059669;
    }

    .po-summary-card:nth-child(3) .po-summary-badge {
        background: #fff7ed;
        color: #ea580c;
    }

    .po-summary-card:nth-child(4) .po-summary-badge {
        background: #fff7ed;
        color: #d97706;
    }

    .po-summary-card:nth-child(5) .po-summary-badge {
        background: #ecfdf3;
        color: #047857;
    }

    .po-summary-card span {
        display: block;
        color: var(--po-muted);
        font-size: 11px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .05em;
    }

    .po-summary-card strong {
        display: block;
        overflow-wrap: anywhere;
        margin-top: 4px;
        font-size: 20px;
        line-height: 1.15;
    }

    .po-panel {
        overflow: hidden;
        margin-bottom: 20px;
        background: var(--po-card);
        border: 1px solid var(--po-border);
        border-radius: 16px;
        box-shadow: 0 10px 30px rgba(16, 24, 40, .055);
    }

    .po-panel-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 15px;
        min-height: 59px;
        padding: 14px 18px;
        background: linear-gradient(180deg, #fff, #fbfcfe);
        border-bottom: 1px solid var(--po-border);
    }

        .po-panel-head h2 {
            margin: 0;
            font-size: 16px;
            letter-spacing: -.01em;
        }

        .po-panel-head p {
            margin: 4px 0 0;
            color: var(--po-muted);
            font-size: 12px;
        }

    .po-count-pill {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 30px;
        height: 28px;
        padding: 0 10px;
        border-radius: 999px;
        background: #edf1ff;
        color: var(--po-primary);
        font-size: 12px;
        font-weight: 900;
    }

    .po-header-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 16px;
        padding: 18px;
    }

    .po-field {
        min-width: 0;
        padding: 14px;
        border-radius: 12px;
        background: #f8fafc;
        border: 1px solid #edf0f5;
    }

    .po-field-wide {
        grid-column: span 2;
    }

    .po-field-label {
        display: flex;
        align-items: center;
        gap: 7px;
        margin-bottom: 7px;
        color: var(--po-muted);
        font-size: 11px;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: .05em;
    }

    .po-field-value {
        overflow-wrap: anywhere;
        color: var(--po-text);
        font-size: 14px;
        font-weight: 800;
    }

    .po-pdf-link {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        color: var(--po-primary);
        text-decoration: none;
        font-weight: 900;
    }

        .po-pdf-link:hover {
            text-decoration: underline;
        }

    .po-table-wrap {
        width: 100%;
        overflow-x: auto;
        scrollbar-width: thin;
    }

    .po-table {
        width: 100%;
        min-width: 2450px;
        border-collapse: separate;
        border-spacing: 0;
        font-size: 13px;
    }

        .po-table thead th {
            position: sticky;
            top: 0;
            z-index: 2;
            padding: 13px 12px;
            text-align: left;
            color: #475467;
            background: #f3f5f9;
            border-bottom: 1px solid #dde3ec;
            font-size: 11px;
            font-weight: 900;
            text-transform: uppercase;
            letter-spacing: .045em;
            white-space: nowrap;
        }

        .po-table tbody td {
            padding: 15px 12px;
            vertical-align: middle;
            border-bottom: 1px solid #edf0f5;
            color: #263247;
        }

        .po-table tbody tr:last-child td {
            border-bottom: 0;
        }

        .po-table tbody tr:hover td {
            background: #fbfcff;
        }

    .po-line-pill,
    .po-type-pill,
    .po-material-pill,
    .po-dep-pill,
    .po-info-pill {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 6px 9px;
        border-radius: 8px;
        white-space: nowrap;
        font-weight: 900;
    }

    .po-line-pill {
        color: #3b5bdb;
        background: #edf1ff;
    }

    .po-type-pill {
        min-width: 34px;
        color: #047857;
        background: #ecfdf3;
    }

    .po-material-pill {
        color: #172033;
        background: #f0f2f6;
        font-family: Consolas, monospace;
    }

    .po-material-missing {
        color: #92400e;
        background: #fff7ed;
        font-family: inherit;
    }

    .po-dep-pill {
        color: #7c3aed;
        background: #f5f0ff;
    }

    .po-info-pill {
        color: #155e75;
        background: #ecfeff;
    }

    .po-number {
        white-space: nowrap;
        font-variant-numeric: tabular-nums;
        font-weight: 800;
    }

    .po-description {
        width: 340px;
        max-width: 340px;
    }

    .po-description-title {
        display: block;
        margin-bottom: 6px;
        color: #172033;
        font-size: 13px;
        font-weight: 900;
        line-height: 1.4;
    }

    .po-description details {
        color: var(--po-muted);
        font-size: 12px;
        line-height: 1.55;
    }

    .po-description summary {
        width: fit-content;
        color: var(--po-primary);
        font-weight: 800;
        cursor: pointer;
        user-select: none;
    }

    .po-description-text {
        max-height: 190px;
        overflow: auto;
        margin-top: 8px;
        padding: 10px;
        white-space: pre-line;
        background: #f7f9fc;
        border: 1px solid #e8edf4;
        border-radius: 9px;
    }

    .po-drawing-number {
        display: block;
        min-width: 145px;
        max-width: 190px;
        white-space: pre-line;
        overflow-wrap: anywhere;
        font-weight: 800;
        line-height: 1.45;
    }

    .po-file-box {
        min-width: 225px;
    }

    .po-file-input {
        display: block;
        width: 100%;
        padding: 7px;
        color: #475467;
        background: #fff;
        border: 1px solid #d7deea;
        border-radius: 10px;
        font-size: 12px;
    }

        .po-file-input::file-selector-button {
            margin-right: 8px;
            padding: 7px 10px;
            color: #344054;
            background: #edf1f7;
            border: 0;
            border-radius: 7px;
            font-weight: 800;
            cursor: pointer;
        }

    .po-file-help {
        display: block;
        margin-top: 6px;
        color: #98a2b3;
        font-size: 10px;
    }

    .po-actions-bar {
        position: sticky;
        bottom: 0;
        z-index: 8;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 18px;
        margin-top: 18px;
        padding: 14px 16px;
        background: rgba(255, 255, 255, .96);
        backdrop-filter: blur(10px);
        border: 1px solid var(--po-border);
        border-radius: 14px;
        box-shadow: 0 -6px 26px rgba(16, 24, 40, .08);
    }

    .po-actions-note {
        color: var(--po-muted);
        font-size: 12px;
        line-height: 1.5;
    }

        .po-actions-note strong {
            color: var(--po-text);
        }

    .po-actions-buttons {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .po-empty-state {
        padding: 45px 20px;
        text-align: center;
        background: #fff;
        border: 1px dashed #cfd7e5;
        border-radius: 16px;
    }

        .po-empty-state .icon {
            font-size: 34px;
        }

        .po-empty-state h2 {
            margin: 12px 0 6px;
            font-size: 18px;
        }

        .po-empty-state p {
            margin: 0 0 16px;
            color: var(--po-muted);
        }

    @@media (max-width: 1250px) {
        .po-summary-grid {
            grid-template-columns: repeat(3, minmax(180px, 1fr));
        }

        .po-header-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @@media (max-width: 700px) {
        .po-preview-page {
            padding: 16px;
        }

        .po-preview-header {
            flex-direction: column;
            align-items: stretch;
        }

            .po-preview-header .po-btn {
                width: 100%;
            }

        .po-summary-grid,
        .po-header-grid {
            grid-template-columns: 1fr;
        }

        .po-field-wide {
            grid-column: span 1;
        }

        .po-actions-bar {
            position: static;
            flex-direction: column;
            align-items: stretch;
        }

        .po-actions-buttons {
            display: grid;
            grid-template-columns: 1fr;
        }

            .po-actions-buttons .po-btn {
                width: 100%;
            }
    }
</style>

<div class="po-preview-page">
    <div class="po-preview-header">
        <div class="po-preview-title-wrap">
            <div class="po-preview-icon">📄</div>
            <div>
                <h1>PO Import Preview</h1>
                <p>Review the extracted purchase order and material details before saving.</p>
            </div>
        </div>

        <a asp-controller="POImport"
           asp-action="Upload"
           class="po-btn po-btn-secondary">
            ← Back to Upload
        </a>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="po-alert po-alert-danger">
            <span>⚠️</span>
            <span>@TempData["Error"]</span>
        </div>
    }

    @if (Model == null)
    {
        <div class="po-empty-state">
            <div class="icon">📂</div>
            <h2>No preview data found</h2>
            <p>Please upload the purchase order PDF again.</p>

            <a asp-controller="POImport"
               asp-action="Upload"
               class="po-btn po-btn-primary">
                Upload PO PDF
            </a>
        </div>
    }
    else
    {
        @if (Model.Warnings != null && Model.Warnings.Count > 0)
        {
            <div class="po-alert po-alert-warning">
                <span>⚠️</span>
                <div>
                    <strong>Import warnings</strong>
                    <ul class="po-warning-list">
                        @foreach (var warning in Model.Warnings)
                        {
                            <li>@warning</li>
                        }
                    </ul>
                </div>
            </div>
        }

        <div class="po-summary-grid">
            <div class="po-summary-card">
                <div class="po-summary-badge">📦</div>
                <div>
                    <span>Material Items</span>
                    <strong>@itemCount</strong>
                </div>
            </div>

            <div class="po-summary-card">
                <div class="po-summary-badge">🔢</div>
                <div>
                    <span>Total Quantity</span>
                    <strong>@totalQuantity.ToString("0.##")</strong>
                </div>
            </div>

            <div class="po-summary-card">
                <div class="po-summary-badge">₹</div>
                <div>
                    <span>Basic Value</span>
                    <strong>₹@basicValue.ToString("N2")</strong>
                </div>
            </div>

            <div class="po-summary-card">
                <div class="po-summary-badge">%</div>
                <div>
                    <span>Tax Value</span>
                    <strong>₹@taxValue.ToString("N2")</strong>
                </div>
            </div>

            <div class="po-summary-card">
                <div class="po-summary-badge">✓</div>
                <div>
                    <span>Grand Total</span>
                    <strong>₹@grandTotal.ToString("N2")</strong>
                </div>
            </div>
        </div>

        <section class="po-panel">
            <div class="po-panel-head">
                <div>
                    <h2>Purchase Order Details</h2>
                    <p>Header information extracted from the uploaded PDF.</p>
                </div>

                <span class="po-count-pill">
                    @(string.IsNullOrWhiteSpace(Model.ImportFormat)
                        ? "PO"
                        : Model.ImportFormat)
                </span>
            </div>

            <div class="po-header-grid">
                <div class="po-field">
                    <div class="po-field-label"># PO Number</div>
                    <div class="po-field-value">
                        @(string.IsNullOrWhiteSpace(Model.PurchaseOrderNo)
                            ? "-"
                            : Model.PurchaseOrderNo)
                    </div>
                </div>

                <div class="po-field">
                    <div class="po-field-label">📅 PO Date</div>
                    <div class="po-field-value">
                        @(Model.PODate?.ToString("dd MMM yyyy") ?? "-")
                    </div>
                </div>

                <div class="po-field">
                    <div class="po-field-label">📥 PO Received Date</div>
                    <div class="po-field-value">
                        @(Model.ReceivedDate?.ToString("dd MMM yyyy") ?? "-")
                    </div>
                </div>

                <div class="po-field">
                    <div class="po-field-label">👤 Buyer Contact</div>
                    <div class="po-field-value">
                        @(string.IsNullOrWhiteSpace(Model.BuyerContactPerson)
                            ? "-"
                            : Model.BuyerContactPerson)
                    </div>
                </div>

                <div class="po-field">
                    <div class="po-field-label">✉ Buyer Email</div>
                    <div class="po-field-value">
                        @(string.IsNullOrWhiteSpace(Model.BuyerEmail)
                            ? "-"
                            : Model.BuyerEmail)
                    </div>
                </div>

                <div class="po-field">
                    <div class="po-field-label">🏷 Vendor Code</div>
                    <div class="po-field-value">
                        @(string.IsNullOrWhiteSpace(Model.VendorCode)
                            ? "-"
                            : Model.VendorCode)
                    </div>
                </div>

                <div class="po-field po-field-wide">
                    <div class="po-field-label">🏭 Vendor Name</div>
                    <div class="po-field-value">
                        @(string.IsNullOrWhiteSpace(Model.VendorName)
                            ? "-"
                            : Model.VendorName)
                    </div>
                </div>

                <div class="po-field po-field-wide">
                    <div class="po-field-label">💳 Payment Terms</div>
                    <div class="po-field-value">
                        @(string.IsNullOrWhiteSpace(Model.PaymentTerms)
                            ? "-"
                            : Model.PaymentTerms)
                    </div>
                </div>

                <div class="po-field">
                    <div class="po-field-label">🚚 Delivery Condition</div>
                    <div class="po-field-value">
                        @(string.IsNullOrWhiteSpace(Model.DeliveryCondition)
                            ? "-"
                            : Model.DeliveryCondition)
                    </div>
                </div>

                <div class="po-field">
                    <div class="po-field-label">💱 Currency</div>
                    <div class="po-field-value">
                        @(string.IsNullOrWhiteSpace(Model.Currency)
                            ? "-"
                            : Model.Currency)
                    </div>
                </div>

                <div class="po-field">
                    <div class="po-field-label">🧾 Import Format</div>
                    <div class="po-field-value">
                        @(string.IsNullOrWhiteSpace(Model.ImportFormat)
                            ? "Standard"
                            : Model.ImportFormat)
                    </div>
                </div>

                <div class="po-field">
                    <div class="po-field-label">📎 Source PDF</div>
                    <div class="po-field-value">
                        @if (!string.IsNullOrWhiteSpace(Model.UploadedPdfPath))
                        {
                            <a href="@Model.UploadedPdfPath"
                               target="_blank"
                               rel="noopener"
                               class="po-pdf-link">
                                View uploaded PDF ↗
                            </a>
                        }
                        else
                        {
                            <span>-</span>
                        }
                    </div>
                </div>
            </div>
        </section>

        @if (Model.Items == null || Model.Items.Count == 0)
        {
            <div class="po-alert po-alert-warning">
                <span>⚠️</span>
                <span>No material items were extracted from this PDF.</span>
            </div>
        }
        else
        {
            <form asp-controller="POImport"
                  asp-action="SaveAll"
                  method="post"
                  enctype="multipart/form-data">

                @Html.AntiForgeryToken()

                <input type="hidden" asp-for="PurchaseOrderNo" />
                <input type="hidden" asp-for="PODate" />
                <input type="hidden" asp-for="ReceivedDate" />
                <input type="hidden" asp-for="BuyerContactPerson" />
                <input type="hidden" asp-for="BuyerEmail" />
                <input type="hidden" asp-for="VendorCode" />
                <input type="hidden" asp-for="VendorName" />
                <input type="hidden" asp-for="PaymentTerms" />
                <input type="hidden" asp-for="DeliveryCondition" />
                <input type="hidden" asp-for="Currency" />
                <input type="hidden" asp-for="BasicValue" />
                <input type="hidden" asp-for="TaxValue" />
                <input type="hidden" asp-for="GrandTotal" />
                <input type="hidden" asp-for="ImportFormat" />
                <input type="hidden" asp-for="UploadedPdfPath" />

                <section class="po-panel">
                    <div class="po-panel-head">
                        <div>
                            <h2>Extracted Material Items</h2>
                            <p>
                                Material number may be blank in some WEG purchase orders.
                                Item number and description will still be imported.
                            </p>
                        </div>

                        <span class="po-count-pill">@itemCount Items</span>
                    </div>

                    <div class="po-table-wrap">
                        <table class="po-table">
                            <thead>
                                <tr>
                                    <th>Type</th>
                                    <th>Line Item</th>
                                    <th>Material No</th>
                                    <th>HSN/SAC</th>
                                    <th>Description</th>
                                    <th>Receiver</th>
                                    <th>Unloading Point</th>
                                    <th>Qty</th>
                                    <th>Unit</th>
                                    <th>Dep</th>
                                    <th>Unit Value</th>
                                    <th>Price Unit</th>
                                    <th>Basic Total</th>
                                    <th>CGST</th>
                                    <th>SGST</th>
                                    <th>IGST</th>
                                    <th>Total With Tax</th>
                                    <th>Delivery Date</th>
                                    <th>Drawing No</th>
                                    <th>Drawing File</th>
                                </tr>
                            </thead>

                            <tbody>
                                @for (var i = 0; i < Model.Items.Count; i++)
                                {
                                    var row = Model.Items[i];

                                    var rowTotalWithTax =
                                        row.TotalValueWithTax > 0
                                            ? row.TotalValueWithTax
                                            : row.TotalValue +
                                              row.CGSTAmount +
                                              row.SGSTAmount +
                                              row.IGSTAmount;

                                    <tr>
                                        <td>
                                            <span class="po-type-pill">
                                                @(string.IsNullOrWhiteSpace(row.ItemType)
                                                    ? "-"
                                                    : row.ItemType)
                                            </span>

                                            <input type="hidden" asp-for="Items[i].ItemType" />
                                        </td>

                                        <td>
                                            <span class="po-line-pill">
                                                @(string.IsNullOrWhiteSpace(row.LineItem)
                                                    ? "-"
                                                    : row.LineItem)
                                            </span>

                                            <input type="hidden" asp-for="Items[i].LineItem" />
                                        </td>

                                        <td>
                                            @if (string.IsNullOrWhiteSpace(row.MaterialNo))
                                            {
                                                <span class="po-material-pill po-material-missing">
                                                    Not Provided
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="po-material-pill">
                                                    @row.MaterialNo
                                                </span>
                                            }

                                            <input type="hidden" asp-for="Items[i].MaterialNo" />
                                        </td>

                                        <td>
                                            <span class="po-number">
                                                @(string.IsNullOrWhiteSpace(row.HsnSacCode)
                                                    ? "-"
                                                    : row.HsnSacCode)
                                            </span>

                                            <input type="hidden" asp-for="Items[i].HsnSacCode" />
                                        </td>

                                        <td class="po-description">
                                            <span class="po-description-title">
                                                @(string.IsNullOrWhiteSpace(row.ShortDescription)
                                                    ? "No description"
                                                    : row.ShortDescription)
                                            </span>

                                            @if (!string.IsNullOrWhiteSpace(row.FullDescription))
                                            {
                                                <details>
                                                    <summary>View full description</summary>
                                                    <div class="po-description-text">
                                                        @row.FullDescription
                                                    </div>
                                                </details>
                                            }

                                            <input type="hidden" asp-for="Items[i].ShortDescription" />
                                            <input type="hidden" asp-for="Items[i].FullDescription" />
                                        </td>

                                        <td>
                                            @if (!string.IsNullOrWhiteSpace(row.Receiver))
                                            {
                                                <span class="po-info-pill">@row.Receiver</span>
                                            }
                                            else
                                            {
                                                <span>-</span>
                                            }

                                            <input type="hidden" asp-for="Items[i].Receiver" />
                                        </td>

                                        <td>
                                            @if (!string.IsNullOrWhiteSpace(row.UnloadingPoint))
                                            {
                                                <span class="po-info-pill">@row.UnloadingPoint</span>
                                            }
                                            else
                                            {
                                                <span>-</span>
                                            }

                                            <input type="hidden" asp-for="Items[i].UnloadingPoint" />
                                        </td>

                                        <td>
                                            <span class="po-number">
                                                @row.Quantity.ToString("0.##")
                                            </span>

                                            <input type="hidden" asp-for="Items[i].Quantity" />
                                        </td>

                                        <td>
                                            <span class="po-number">
                                                @(string.IsNullOrWhiteSpace(row.Unit)
                                                    ? "-"
                                                    : row.Unit)
                                            </span>

                                            <input type="hidden" asp-for="Items[i].Unit" />
                                        </td>

                                        <td>
                                            @if (!string.IsNullOrWhiteSpace(row.Dep))
                                            {
                                                <span class="po-dep-pill">@row.Dep</span>
                                            }
                                            else
                                            {
                                                <span>-</span>
                                            }

                                            <input type="hidden" asp-for="Items[i].Dep" />
                                        </td>

                                        <td>
                                            <span class="po-number">
                                                ₹@row.ValueOfGoods.ToString("N2")
                                            </span>

                                            <input type="hidden" asp-for="Items[i].ValueOfGoods" />
                                        </td>

                                        <td>
                                            <span class="po-number">
                                                @(string.IsNullOrWhiteSpace(row.PriceUnit)
                                                    ? "-"
                                                    : row.PriceUnit)
                                            </span>

                                            <input type="hidden" asp-for="Items[i].PriceUnit" />
                                        </td>

                                        <td>
                                            <span class="po-number">
                                                ₹@row.TotalValue.ToString("N2")
                                            </span>

                                            <input type="hidden" asp-for="Items[i].TotalValue" />
                                        </td>

                                        <td>
                                            <span class="po-number">
                                                @row.CGSTRate.ToString("0.##")%
                                                <br />
                                                ₹@row.CGSTAmount.ToString("N2")
                                            </span>

                                            <input type="hidden" asp-for="Items[i].CGSTRate" />
                                            <input type="hidden" asp-for="Items[i].CGSTAmount" />
                                        </td>

                                        <td>
                                            <span class="po-number">
                                                @row.SGSTRate.ToString("0.##")%
                                                <br />
                                                ₹@row.SGSTAmount.ToString("N2")
                                            </span>

                                            <input type="hidden" asp-for="Items[i].SGSTRate" />
                                            <input type="hidden" asp-for="Items[i].SGSTAmount" />
                                        </td>

                                        <td>
                                            <span class="po-number">
                                                @row.IGSTRate.ToString("0.##")%
                                                <br />
                                                ₹@row.IGSTAmount.ToString("N2")
                                            </span>

                                            <input type="hidden" asp-for="Items[i].IGSTRate" />
                                            <input type="hidden" asp-for="Items[i].IGSTAmount" />
                                        </td>

                                        <td>
                                            <span class="po-number">
                                                ₹@rowTotalWithTax.ToString("N2")
                                            </span>

                                            <input type="hidden" asp-for="Items[i].TotalValueWithTax" />
                                        </td>

                                        <td>
                                            <span class="po-number">
                                                @(row.DeliveryDate?.ToString("dd MMM yyyy") ?? "-")
                                            </span>

                                            <input type="hidden" asp-for="Items[i].DeliveryDate" />
                                        </td>

                                        <td>
                                            <span class="po-drawing-number">
                                                @(string.IsNullOrWhiteSpace(row.DrawingNo)
                                                    ? "-"
                                                    : row.DrawingNo)
                                            </span>

                                            <input type="hidden" asp-for="Items[i].DrawingNo" />
                                        </td>

                                        <td>
                                            <div class="po-file-box">
                                                <input type="file"
                                                       asp-for="Items[i].DrawingFile"
                                                       class="po-file-input"
                                                       accept=".pdf,.jpg,.jpeg,.png,.dwg,.dxf,.step,.stp" />

                                                <span class="po-file-help">
                                                    PDF, image, DWG, DXF, STEP or STP
                                                </span>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </section>

                <div class="po-actions-bar">
                    <div class="po-actions-note">
                        <strong>@itemCount material item(s)</strong> will be saved under
                        PO <strong>@Model.PurchaseOrderNo</strong>.

                        <br />

                        Blank Material Number and HSN/SAC values are allowed.
                    </div>

                    <div class="po-actions-buttons">
                        <a asp-controller="POImport"
                           asp-action="Upload"
                           class="po-btn po-btn-secondary">
                            Cancel
                        </a>

                        <button type="submit"
                                class="po-btn po-btn-primary">
                            ✓ Save All Materials
                        </button>
                    </div>
                </div>
            </form>
        }
    }
</div>
