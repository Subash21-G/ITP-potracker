@model List<POTracker.Models.Invoice>

@{
    ViewData["Title"] = "Imported Invoices";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var invoices =
        Model ?? new List<POTracker.Models.Invoice>();

    var allItems =
        invoices
            .SelectMany(
                x => x.Items
                     ?? new List<POTracker.Models.InvoiceItem>())
            .ToList();

    int totalInvoices =
        invoices.Count;

    int totalItems =
        allItems.Count;

    decimal totalInvoiceQty =
        allItems.Sum(x => x.InvoiceQty);

    decimal totalAmount =
        allItems.Sum(x => x.Amount);

    decimal totalGst =
        allItems.Sum(x => x.GstAmount);
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/invoice-list-premium.css"
          asp-append-version="true" />

    <style>
        .vil-action-stack {
            display: flex;
            flex-direction: column;
            align-items: stretch;
            gap: 8px;
            min-width: 145px;
        }

        .vil-export-button {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-height: 36px;
            padding: 8px 12px;
            border: 1px solid #86efac;
            border-radius: 9px;
            background: #ecfdf3;
            color: #166534;
            font-size: 12px;
            font-weight: 800;
            line-height: 1.2;
            text-decoration: none;
            white-space: nowrap;
            transition: 0.18s ease;
        }

            .vil-export-button:hover {
                border-color: #22c55e;
                background: #dcfce7;
                color: #14532d;
                transform: translateY(-1px);
            }

        .vil-action-stack .vil-delete-form {
            width: 100%;
        }

        .vil-action-stack .vil-delete-button {
            width: 100%;
        }

        .vil-bulk-bar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 14px;
            padding: 13px 15px;
            margin-bottom: 15px;
            border: 1px solid #fecdd3;
            border-radius: 13px;
            background: #fff7f8;
        }

        .vil-bulk-left,
        .vil-bulk-actions {
            display: flex;
            align-items: center;
            gap: 12px;
            flex-wrap: wrap;
        }

        .vil-select-all-label,
        .vil-row-check-label {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
        }

        .vil-select-checkbox {
            width: 18px;
            height: 18px;
            margin: 0;
            accent-color: #dc2626;
            cursor: pointer;
        }

        .vil-checkbox-column {
            width: 48px;
            min-width: 48px;
            text-align: center !important;
        }

        .vil-selected-count {
            display: inline-flex;
            align-items: center;
            min-height: 30px;
            padding: 5px 10px;
            border: 1px solid #ddd6fe;
            border-radius: 999px;
            background: #f5f3ff;
            color: #5b21b6;
            font-size: 12px;
            font-weight: 900;
        }

        .vil-bulk-help {
            color: #64748b;
            font-size: 12px;
            font-weight: 700;
        }

        .vil-bulk-delete-button {
            min-height: 39px;
            padding: 9px 14px;
            border: 1px solid #dc2626;
            border-radius: 10px;
            background: #dc2626;
            color: #ffffff;
            font: inherit;
            font-size: 13px;
            font-weight: 900;
            cursor: pointer;
            transition: .18s ease;
        }

            .vil-bulk-delete-button:hover:not(:disabled) {
                background: #b91c1c;
                transform: translateY(-1px);
            }

            .vil-bulk-delete-button:disabled {
                border-color: #cbd5e1;
                background: #e2e8f0;
                color: #94a3b8;
                cursor: not-allowed;
            }

        .vil-row-selected {
            background: #fff7f8 !important;
        }

        @@media (max-width: 760px) {
            .vil-bulk-bar {
                align-items: flex-start;
                flex-direction: column;
            }

            .vil-bulk-actions,
            .vil-bulk-delete-button {
                width: 100%;
            }
        }
    </style>
}

<div class="vil-page">

    <!-- =========================================================
         PAGE HEADER
    ========================================================== -->

    <section class="vil-header">

        <div>
            <span class="vil-kicker">
                Vyapar invoice management
            </span>

            <h1>Imported Invoices</h1>

            <p>
                Manage imported invoices, review invoice totals
                and delete wrong imports safely.
            </p>
        </div>

        <div class="vil-header-actions">

            <a asp-action="Upload"
               asp-controller="VyaparInvoiceImport"
               class="vil-btn vil-btn-primary">
                Upload New Invoice
            </a>

            <a asp-action="History"
               asp-controller="VyaparInvoiceImport"
               class="vil-btn vil-btn-light">
                Import History
            </a>

            <a asp-action="InvoiceStatus"
               asp-controller="VyaparInvoiceImport"
               class="vil-btn vil-btn-light">
                Invoice Status
            </a>
        </div>
    </section>

    <!-- =========================================================
         FLASH MESSAGES
    ========================================================== -->
    @if (TempData["Success"] != null)
    {
        <div class="vil-alert vil-alert-success">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="vil-alert vil-alert-danger">
            @TempData["Error"]
        </div>
    }

    <!-- =========================================================
         SUMMARY CARDS
    ========================================================== -->

    <section class="vil-summary-grid">

        <article class="vil-summary-card vil-summary-violet">
            <span>Total Invoices</span>
            <strong>@totalInvoices</strong>
            <small>Imported invoice records</small>
        </article>

        <article class="vil-summary-card vil-summary-blue">
            <span>Total Items</span>
            <strong>@totalItems</strong>
            <small>Invoice material lines</small>
        </article>

        <article class="vil-summary-card vil-summary-green">
            <span>Total Invoice Qty</span>
            <strong>@totalInvoiceQty.ToString("0.##")</strong>
            <small>Combined invoiced quantity</small>
        </article>

        <article class="vil-summary-card vil-summary-amber">
            <span>Total GST</span>
            <strong>₹ @totalGst.ToString("0.00")</strong>
            <small>Combined GST amount</small>
        </article>

        <article class="vil-summary-card vil-summary-rose">
            <span>Total Amount</span>
            <strong>₹ @totalAmount.ToString("0.00")</strong>
            <small>Combined invoice amount</small>
        </article>
    </section>

    <!-- =========================================================
         SAFETY NOTICE
    ========================================================== -->

    <section class="vil-safety-note">

        <div class="vil-safety-icon">
            !
        </div>

        <div>
            <strong>
                Actual invoice deletion
            </strong>

            <p>
                Deleting an invoice removes its invoice items and
                pending invoice items. Linked material InvoiceQty,
                BalanceQty, DispatchQty and PendingQty are restored.
            </p>
        </div>
    </section>

    <!-- =========================================================
         INVOICE TABLE
    ========================================================== -->

    <section class="vil-card">

        <div class="vil-section-head">

            <div>
                <span class="vil-kicker">
                    Invoice records
                </span>

                <h2>Invoice List</h2>

                <p>
                    Delete an invoice only when the imported invoice
                    is incorrect or duplicated.
                </p>
            </div>

            <span class="vil-count-badge">
                @totalInvoices Invoice(s)
            </span>
        </div>

        @if (invoices.Count == 0)
        {
            <div class="vil-empty-state">

                <div class="vil-empty-icon">
                    I
                </div>

                <h3>No imported invoices found</h3>

                <p>
                    Upload a Vyapar invoice to start invoice tracking.
                </p>

                <a asp-action="Upload"
                   asp-controller="VyaparInvoiceImport"
                   class="vil-btn vil-btn-primary">
                    Upload Invoice
                </a>
            </div>
        }
        else
        {
            <div class="vil-bulk-bar">
                <div class="vil-bulk-left">
                    <label class="vil-select-all-label"
                           for="selectAllInvoices">
                        <input type="checkbox"
                               id="selectAllInvoices"
                               class="vil-select-checkbox"
                               aria-label="Select all invoices" />
                    </label>

                    <strong>
                        Select all invoices
                    </strong>

                    <span class="vil-selected-count"
                          id="selectedInvoiceCount">
                        0 selected
                    </span>

                    <span class="vil-bulk-help">
                        Select up to 200 invoices. Material invoice and dispatch quantities will be restored.
                    </span>
                </div>

                <div class="vil-bulk-actions">
                    <form asp-action="BulkDeleteInvoices"
                          asp-controller="VyaparInvoiceImport"
                          method="post"
                          id="invoiceBulkDeleteForm">

                        @Html.AntiForgeryToken()

                        <input type="hidden"
                               name="returnUrl"
                               value="@($"{Context.Request.Path}{Context.Request.QueryString}")" />

                        <button type="submit"
                                class="vil-bulk-delete-button"
                                id="deleteSelectedInvoicesButton"
                                disabled>
                            Delete Selected
                        </button>
                    </form>
                </div>
            </div>

            <div class="vil-table-wrap">

                <table class="vil-table">

                    <thead>
                        <tr>
                            <th class="vil-checkbox-column">
                                <span class="visually-hidden">
                                    Select
                                </span>
                            </th>
                            <th>#</th>
                            <th>Invoice No</th>
                            <th>Invoice Date</th>
                            <th>Customer</th>
                            <th>Items</th>
                            <th>Total Qty</th>
                            <th>GST</th>
                            <th>Amount</th>
                            <th>Uploaded File</th>
                            <th>Created Date</th>
                            <th>Action</th>
                        </tr>
                    </thead>

                    <tbody>

                        @{
                            int index = 1;
                        }

                        @foreach (var invoice in invoices)
                        {
                            var invoiceItems =
                                invoice.Items
                                ?? new List<POTracker.Models.InvoiceItem>();

                            decimal invoiceQty =
                                invoiceItems.Sum(x => x.InvoiceQty);

                            decimal invoiceGst =
                                invoiceItems.Sum(x => x.GstAmount);

                            decimal invoiceAmount =
                                invoiceItems.Sum(x => x.Amount);

                            string invoiceNumber =
                                string.IsNullOrWhiteSpace(
                                    invoice.InvoiceNumber)
                                    ? $"Invoice #{invoice.Id}"
                                    : invoice.InvoiceNumber;

                            string customerName =
                                string.IsNullOrWhiteSpace(
                                    invoice.CustomerName)
                                    ? "Not available"
                                    : invoice.CustomerName;

                            string deleteConfirmation =
                                $"Delete invoice '{invoiceNumber}'? " +
                                $"This will remove {invoiceItems.Count} invoice item(s) " +
                                $"and restore material invoice and dispatch quantities. " +
                                "This action cannot be undone.";

                            <tr data-invoice-row="@invoice.Id">

                                <td class="vil-checkbox-column">
                                    <label class="vil-row-check-label">
                                        <input type="checkbox"
                                               name="selectedIds"
                                               value="@invoice.Id"
                                               form="invoiceBulkDeleteForm"
                                               class="vil-select-checkbox invoice-select-checkbox"
                                               aria-label="Select invoice @invoiceNumber" />
                                    </label>
                                </td>

                                <td>
                                    @index
                                </td>

                                <td>
                                    <strong class="vil-invoice-number">
                                        @invoiceNumber
                                    </strong>
                                </td>

                                <td>
                                    @if (invoice.InvoiceDate.HasValue)
                                    {
                                        <span class="vil-date">
                                            @(invoice.InvoiceDate.Value.ToString("dd-MMM-yyyy"))
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="vil-muted">
                                            Not set
                                        </span>
                                    }
                                </td>

                                <td>
                                    <span class="vil-customer"
                                          title="@customerName">
                                        @customerName
                                    </span>
                                </td>

                                <td>
                                    <span class="vil-badge vil-badge-blue">
                                        @invoiceItems.Count
                                    </span>
                                </td>

                                <td>
                                    <strong class="vil-qty">
                                        @invoiceQty.ToString("0.##")
                                    </strong>
                                </td>

                                <td>
                                    ₹ @invoiceGst.ToString("0.00")
                                </td>

                                <td>
                                    <strong class="vil-amount">
                                        ₹ @invoiceAmount.ToString("0.00")
                                    </strong>
                                </td>

                                <td>
                                    @if (!string.IsNullOrWhiteSpace(
                                        invoice.UploadedFilePath))
                                    {
                                        <a href="@invoice.UploadedFilePath"
                                           target="_blank"
                                           rel="noopener noreferrer"
                                           class="vil-file-link">
                                            View File
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="vil-badge vil-badge-neutral">
                                            No File
                                        </span>
                                    }
                                </td>

                                <td>
                                    <span class="vil-created-date">
                                        @invoice.CreatedDate.ToString(
                                            "dd-MMM-yyyy hh:mm tt")
                                    </span>
                                </td>

                                <td>
                                    <div class="vil-action-stack">

                                        <a asp-action="ExportInvoiceExcel"
                                           asp-controller="VyaparInvoiceImport"
                                           class="vil-export-button">
                                            Export Full Excel
                                        </a>

                                        <form asp-action="DeleteInvoice"
                                              asp-controller="VyaparInvoiceImport"
                                              asp-route-invoiceId="@invoice.Id"
                                              method="post"
                                              class="vil-delete-form"
                                              data-confirm-message="@deleteConfirmation">

                                            @Html.AntiForgeryToken()

                                            <button type="submit"
                                                    class="vil-delete-button">
                                                Delete Invoice
                                            </button>
                                        </form>

                                    </div>
                                </td>
                            </tr>

                            index++;
                        }
                    </tbody>

                    <tfoot>
                        <tr>
                            <th colspan="5"
                                class="vil-text-right">
                                Total
                            </th>

                            <th>
                                @totalItems
                            </th>

                            <th>
                                @totalInvoiceQty.ToString("0.##")
                            </th>

                            <th>
                                ₹ @totalGst.ToString("0.00")
                            </th>

                            <th>
                                ₹ @totalAmount.ToString("0.00")
                            </th>

                            <th colspan="3"></th>
                        </tr>
                    </tfoot>
                </table>
            </div>
        }
    </section>
</div>

@section Scripts {
    <script>
        (() => {
            "use strict";

            // --------------------------------------------------------
            // Individual invoice delete confirmation
            // --------------------------------------------------------

            const individualDeleteForms =
                document.querySelectorAll(
                    ".vil-delete-form");

            individualDeleteForms.forEach(
                form => {
                    form.addEventListener(
                        "submit",
                        event => {
                            const message =
                                form.dataset.confirmMessage ??
                                "Delete this invoice?";

                            if (!window.confirm(message)) {
                                event.preventDefault();
                                return;
                            }

                            const button =
                                form.querySelector(
                                    ".vil-delete-button");

                            if (button) {
                                button.disabled = true;
                                button.textContent =
                                    "Deleting...";
                            }
                        });
                });

            // --------------------------------------------------------
            // Multiple invoice selection and deletion
            // --------------------------------------------------------

            const bulkForm =
                document.getElementById(
                    "invoiceBulkDeleteForm");

            if (!bulkForm) {
                return;
            }

            const selectAll =
                document.getElementById(
                    "selectAllInvoices");

            const deleteButton =
                document.getElementById(
                    "deleteSelectedInvoicesButton");

            const selectedCount =
                document.getElementById(
                    "selectedInvoiceCount");

            const checkboxes =
                Array.from(
                    document.querySelectorAll(
                        ".invoice-select-checkbox"));

            const maximumSelection = 200;

            const updateSelectionState = () => {
                const selected =
                    checkboxes.filter(
                        checkbox =>
                            checkbox.checked);

                const selectedTotal =
                    selected.length;

                if (selectedCount) {
                    selectedCount.textContent =
                        `${selectedTotal} selected`;
                }

                if (deleteButton) {
                    deleteButton.disabled =
                        selectedTotal === 0;
                }

                if (selectAll) {
                    selectAll.checked =
                        checkboxes.length > 0 &&
                        selectedTotal ===
                        checkboxes.length;

                    selectAll.indeterminate =
                        selectedTotal > 0 &&
                        selectedTotal <
                        checkboxes.length;
                }

                checkboxes.forEach(
                    checkbox => {
                        const row =
                            checkbox.closest("tr");

                        row?.classList.toggle(
                            "vil-row-selected",
                            checkbox.checked);
                    });
            };

            selectAll?.addEventListener(
                "change",
                () => {
                    checkboxes.forEach(
                        (checkbox, index) => {
                            checkbox.checked =
                                selectAll.checked &&
                                index < maximumSelection;
                        });

                    if (selectAll.checked &&
                        checkboxes.length > maximumSelection) {
                        window.alert(
                            "Only the first 200 invoices were selected.");
                    }

                    updateSelectionState();
                });

            checkboxes.forEach(
                checkbox => {
                    checkbox.addEventListener(
                        "change",
                        () => {
                            const selectedTotal =
                                checkboxes.filter(x => x.checked).length;

                            if (selectedTotal > maximumSelection) {
                                checkbox.checked = false;
                                window.alert(
                                    "You can select a maximum of 200 invoices.");
                            }

                            updateSelectionState();
                        });
                });

            bulkForm.addEventListener(
                "submit",
                event => {
                    const selectedTotal =
                        checkboxes.filter(
                            checkbox =>
                                checkbox.checked)
                            .length;

                    if (selectedTotal === 0) {
                        event.preventDefault();

                        window.alert(
                            "Select at least one invoice.");

                        return;
                    }

                    if (selectedTotal > maximumSelection) {
                        event.preventDefault();

                        window.alert(
                            "You can delete a maximum of 200 invoices at one time.");

                        return;
                    }

                    const confirmed =
                        window.confirm(
                            `Delete ${selectedTotal} selected invoice(s)? ` +
                            "Invoice items and pending items will be removed, " +
                            "and material invoice/dispatch quantities will be restored. " +
                            "This action cannot be undone.");

                    if (!confirmed) {
                        event.preventDefault();
                        return;
                    }

                    if (deleteButton) {
                        deleteButton.disabled = true;
                        deleteButton.textContent =
                            "Deleting...";
                    }
                });

            updateSelectionState();
        })();
    </script>
}
