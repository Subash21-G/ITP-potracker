@{
    ViewData["Title"] = "Upload Vyapar Invoice";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/invoice-upload-premium.css"
          asp-append-version="true" />
    <style>
        .viu-bulk-card {
            margin-bottom: 24px;
            border: 1px solid #c7d2fe;
            background: linear-gradient(135deg,#fff,#f5f7ff);
        }

        .viu-bulk-zone {
            padding: 28px;
            border: 2px dashed #a5b4fc;
            border-radius: 16px;
            background: #f8faff;
            text-align: center;
            cursor: pointer;
            transition: .2s ease;
        }

            .viu-bulk-zone:hover, .viu-bulk-zone.is-dragging {
                border-color: #4f46e5;
                background: #eef2ff;
            }

            .viu-bulk-zone input {
                position: absolute;
                width: 1px;
                height: 1px;
                overflow: hidden;
                clip: rect(0,0,0,0);
            }

            .viu-bulk-zone h3 {
                margin: 8px 0;
            }

            .viu-bulk-zone p {
                margin: 0;
                color: #64748b;
            }

        .viu-bulk-icon {
            display: grid;
            place-items: center;
            width: 62px;
            height: 62px;
            margin: 0 auto 12px;
            border-radius: 18px;
            background: linear-gradient(135deg,#6366f1,#4338ca);
            color: #fff;
            font-size: 28px;
        }

        .viu-bulk-meta {
            display: flex;
            justify-content: space-between;
            gap: 12px;
            align-items: center;
            margin: 15px 0;
            padding: 13px 15px;
            border: 1px solid #e2e8f0;
            border-radius: 12px;
            background: #fff;
        }

            .viu-bulk-meta strong {
                color: #312e81;
            }

            .viu-bulk-meta span {
                color: #64748b;
                font-size: 13px;
            }

        .viu-bulk-list {
            display: grid;
            gap: 7px;
            max-height: 280px;
            overflow: auto;
        }

        .viu-bulk-file {
            display: grid;
            grid-template-columns: minmax(0,1fr) auto auto;
            gap: 10px;
            align-items: center;
            padding: 10px 12px;
            border: 1px solid #e2e8f0;
            border-radius: 10px;
            background: #fff;
            font-size: 13px;
        }

            .viu-bulk-file strong {
                overflow: hidden;
                text-overflow: ellipsis;
                white-space: nowrap;
            }

            .viu-bulk-file span {
                color: #64748b;
                white-space: nowrap;
            }

        .viu-bulk-remove {
            border: 0;
            background: #fee2e2;
            color: #991b1b;
            border-radius: 7px;
            padding: 6px 9px;
            cursor: pointer;
            font-weight: 800;
        }

        .viu-bulk-actions {
            display: flex;
            justify-content: flex-end;
            gap: 9px;
            margin-top: 15px;
            flex-wrap: wrap;
        }

        .viu-main-grid > .viu-card:first-child {
            display: none;
        }

        .viu-main-grid {
            grid-template-columns: 1fr !important;
        }
    </style>
}

<div class="viu-page">

    <!-- =========================================================
         PAGE HEADER
    ========================================================== -->

    <section class="viu-header">

        <div>
            <span class="viu-kicker">
                Vyapar invoice import
            </span>

            <h1>Upload Vyapar Invoice</h1>

            <p>
                Import Vyapar PDF or Excel invoices,
                preview extracted rows and automatically
                link them with PO materials.
            </p>
        </div>

        <div class="viu-header-actions">

            <a asp-action="DownloadExcelTemplate"
               asp-controller="VyaparInvoiceImport"
               class="viu-btn viu-btn-primary">
                Download Excel Format
            </a>

            <a asp-action="InvoiceList"
               asp-controller="VyaparInvoiceImport"
               class="viu-btn viu-btn-light">
                Imported Invoices
            </a>

            <a asp-action="History"
               asp-controller="VyaparInvoiceImport"
               class="viu-btn viu-btn-light">
                Import History
            </a>

            <a asp-action="InvoiceStatus"
               asp-controller="VyaparInvoiceImport"
               class="viu-btn viu-btn-light">
                Invoice Status
            </a>
        </div>
    </section>

    <!-- =========================================================
         MESSAGES
    ========================================================== -->
    @if (ViewBag.Error != null)
    {
        <div class="viu-alert viu-alert-danger">
            @ViewBag.Error
        </div>
    }

    @if (TempData["Success"] != null)
    {
        <div class="viu-alert viu-alert-success">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="viu-alert viu-alert-danger">
            @TempData["Error"]
        </div>
    }

    <!-- =========================================================
         SUMMARY
    ========================================================== -->

    <section class="viu-summary-grid">

        <article class="viu-summary-card viu-summary-violet">
            <span>Allowed Files</span>
            <strong>PDF / Excel</strong>
            <small>PDF, XLSX and XLS formats</small>
        </article>

        <article class="viu-summary-card viu-summary-blue">
            <span>Auto Match</span>
            <strong>PO + Material</strong>
            <small>PO number, material and line item</small>
        </article>

        <article class="viu-summary-card viu-summary-green">
            <span>Automatic Update</span>
            <strong>Invoice Qty</strong>
            <small>Balance quantity recalculated</small>
        </article>

        <article class="viu-summary-card viu-summary-teal">
            <span>Dispatch Rule</span>
            <strong>Invoice = Dispatch</strong>
            <small>Dispatch quantity updates together</small>
        </article>
    </section>

    <section class="viu-card viu-bulk-card">
        <div class="viu-section-head">
            <div>
                <span class="viu-kicker">Invoice import</span>
                <h2>Upload Invoice Files</h2>
                <p>Select one invoice or multiple invoices in the same upload area. PDF, XLSX and XLS formats are supported.</p>
            </div>
        </div>

        <form asp-action="UploadBatch"
              asp-controller="VyaparInvoiceImport"
              method="post"
              enctype="multipart/form-data"
              id="invoiceBulkForm">
            @Html.AntiForgeryToken()

            <div class="viu-bulk-zone" id="invoiceBulkDropZone" tabindex="0">
                <input type="file"
                       id="invoiceBulkFiles"
                       name="invoiceFiles"
                       accept=".pdf,.xlsx,.xls"
                       multiple />
                <div class="viu-bulk-icon">⇧</div>
                <h3>Drop one or multiple invoice files here</h3>
                <p>Upload 1 to 100 files · 20 MB each · 200 MB combined</p>
            </div>

            <div class="viu-validation" id="invoiceBulkValidation" role="alert" hidden></div>

            <div class="viu-bulk-meta" id="invoiceBulkMeta" hidden>
                <strong><span id="invoiceBulkCount">0</span> files selected</strong>
                <span id="invoiceBulkSize">0 MB</span>
            </div>

            <div class="viu-bulk-list" id="invoiceBulkList"></div>

            <div class="viu-bulk-actions">
                <button type="button" class="viu-btn viu-btn-light" id="invoiceBulkClear" hidden>Clear All</button>
                <button type="submit" class="viu-btn viu-btn-primary" id="invoiceBulkSubmit" disabled>Upload &amp; Preview</button>
            </div>
        </form>
    </section>

    <!-- =========================================================
         UPLOAD AND PROCESS
    ========================================================== -->

    <section class="viu-main-grid">

        <div class="viu-card">

            <div class="viu-section-head">

                <div>
                    <span class="viu-kicker">
                        Select invoice file
                    </span>

                    <h2>Upload Invoice File</h2>

                    <p>
                        Choose or drop one Vyapar invoice file.
                        The system reads the file and opens a preview
                        before the invoice is saved.
                    </p>
                </div>
            </div>

            <form asp-action="Upload"
                  asp-controller="VyaparInvoiceImport"
                  method="post"
                  enctype="multipart/form-data"
                  id="invoiceUploadForm"
                  class="viu-upload-form">

                @Html.AntiForgeryToken()

                <div class="viu-drop-zone"
                     id="invoiceDropZone"
                     tabindex="0"
                     role="button"
                     aria-label="Choose or drop a Vyapar invoice file">

                    <input type="file"
                           name="file"
                           id="invoiceFileInput"
                           accept=".pdf,.xlsx,.xls"
                           required />

                    <div class="viu-upload-icon">
                        ↑
                    </div>

                    <h3>
                        Drop your invoice file here
                    </h3>

                    <p>
                        or click to browse from your computer
                    </p>

                    <div class="viu-format-list">
                        <span>PDF</span>
                        <span>XLSX</span>
                        <span>XLS</span>
                    </div>

                    <small>
                        Only one invoice file can be uploaded at a time.
                    </small>
                </div>

                <div class="viu-file-preview"
                     id="selectedFilePreview"
                     hidden>

                    <div class="viu-file-icon"
                         id="selectedFileIcon">
                        F
                    </div>

                    <div class="viu-file-info">
                        <strong id="selectedFileName">
                            No file selected
                        </strong>

                        <span id="selectedFileMeta">
                            Select PDF, XLSX or XLS
                        </span>
                    </div>

                    <button type="button"
                            class="viu-remove-file"
                            id="removeSelectedFile"
                            aria-label="Remove selected file">
                        Remove
                    </button>
                </div>

                <div class="viu-validation"
                     id="fileValidationMessage"
                     role="alert"
                     hidden>
                </div>

                <div class="viu-upload-progress"
                     id="uploadProgress"
                     hidden>

                    <div class="viu-progress-head">
                        <span>
                            Reading invoice file...
                        </span>

                        <strong>
                            Please wait
                        </strong>
                    </div>

                    <div class="viu-progress-track">
                        <i></i>
                    </div>
                </div>

                <div class="viu-form-actions">

                    <button type="submit"
                            class="viu-btn viu-btn-primary"
                            id="uploadSubmitButton"
                            disabled>
                        Upload &amp; Preview
                    </button>

                    <a asp-action="History"
                       asp-controller="VyaparInvoiceImport"
                       class="viu-btn viu-btn-light">
                        Cancel
                    </a>
                </div>
            </form>
        </div>

        <div class="viu-card">

            <div class="viu-section-head">

                <div>
                    <span class="viu-kicker">
                        Import workflow
                    </span>

                    <h2>How Import Works</h2>
                </div>
            </div>

            <div class="viu-timeline">

                <article class="viu-timeline-item">

                    <span class="viu-step-number">
                        1
                    </span>

                    <div>
                        <h3>Upload File</h3>

                        <p>
                            Select the Vyapar PDF or Excel
                            invoice file.
                        </p>
                    </div>
                </article>

                <article class="viu-timeline-item">

                    <span class="viu-step-number">
                        2
                    </span>

                    <div>
                        <h3>Preview Invoice</h3>

                        <p>
                            Invoice number, PO number, material,
                            line item and quantity are extracted.
                        </p>
                    </div>
                </article>

                <article class="viu-timeline-item">

                    <span class="viu-step-number">
                        3
                    </span>

                    <div>
                        <h3>Match Material</h3>

                        <p>
                            The system matches PO number,
                            material number and line item.
                        </p>
                    </div>
                </article>

                <article class="viu-timeline-item">

                    <span class="viu-step-number">
                        4
                    </span>

                    <div>
                        <h3>Update Status</h3>

                        <p>
                            Invoice and dispatch quantities
                            are updated after confirmation.
                        </p>
                    </div>
                </article>
            </div>
        </div>
    </section>

    <!-- =========================================================
         RULES AND QUICK LINKS
    ========================================================== -->

    <section class="viu-bottom-grid">

        <div class="viu-card">

            <div class="viu-section-head">

                <div>
                    <span class="viu-kicker">
                        Import protection
                    </span>

                    <h2>Important Rules</h2>
                </div>
            </div>

            <div class="viu-rule-list">

                <article class="viu-rule viu-rule-info">

                    <strong>Invoice and dispatch</strong>

                    <p>
                        In this project, imported InvoiceQty
                        is also treated as DispatchQty.
                    </p>
                </article>

                <article class="viu-rule viu-rule-warning">

                    <strong>Stored rows</strong>

                    <p>
                        When a PO or material is not available,
                        the row is stored for automatic matching later.
                    </p>
                </article>

                <article class="viu-rule viu-rule-danger">

                    <strong>Duplicate protection</strong>

                    <p>
                        Duplicate invoice rows and quantities above
                        the available balance are protected from saving.
                    </p>
                </article>
            </div>
        </div>

        <div class="viu-card">

            <div class="viu-section-head">

                <div>
                    <span class="viu-kicker">
                        Navigation
                    </span>

                    <h2>Quick Links</h2>
                </div>
            </div>

            <div class="viu-quick-links">

                <a asp-action="DownloadExcelTemplate"
                   asp-controller="VyaparInvoiceImport"
                   class="viu-quick-link">

                    <strong>Download Excel Format</strong>

                    <span>
                        Get the standard invoice import template
                    </span>
                </a>

                <a asp-action="InvoiceList"
                   asp-controller="VyaparInvoiceImport"
                   class="viu-quick-link">

                    <strong>Manage Invoices</strong>

                    <span>
                        Review or delete imported invoices
                    </span>
                </a>

                <a asp-action="History"
                   asp-controller="VyaparInvoiceImport"
                   class="viu-quick-link">

                    <strong>Import History</strong>

                    <span>
                        View uploaded batches and reports
                    </span>
                </a>

                <a asp-action="Index"
                   asp-controller="Material"
                   class="viu-quick-link">

                    <strong>Check Materials</strong>

                    <span>
                        Verify PO material information
                    </span>
                </a>

                <a asp-action="Index"
                   asp-controller="Dispatch"
                   class="viu-quick-link">

                    <strong>Check Dispatch</strong>

                    <span>
                        Review dispatch quantity and status
                    </span>
                </a>
            </div>
        </div>
    </section>
</div>

@section Scripts {
    <script>
        (() => {
            "use strict";

            const form =
                document.getElementById(
                    "invoiceUploadForm");

            const dropZone =
                document.getElementById(
                    "invoiceDropZone");

            const fileInput =
                document.getElementById(
                    "invoiceFileInput");

            const filePreview =
                document.getElementById(
                    "selectedFilePreview");

            const fileName =
                document.getElementById(
                    "selectedFileName");

            const fileMeta =
                document.getElementById(
                    "selectedFileMeta");

            const fileIcon =
                document.getElementById(
                    "selectedFileIcon");

            const removeButton =
                document.getElementById(
                    "removeSelectedFile");

            const validationMessage =
                document.getElementById(
                    "fileValidationMessage");

            const submitButton =
                document.getElementById(
                    "uploadSubmitButton");

            const uploadProgress =
                document.getElementById(
                    "uploadProgress");

            if (!form ||
                !dropZone ||
                !fileInput ||
                !submitButton) {
                return;
            }

            const allowedExtensions =
                [".pdf", ".xlsx", ".xls"];

            const maximumFileSize =
                25 * 1024 * 1024;

            const formatFileSize = (bytes) => {
                if (!Number.isFinite(bytes) ||
                    bytes <= 0) {
                    return "0 KB";
                }

                const units =
                    ["B", "KB", "MB", "GB"];

                const unitIndex =
                    Math.min(
                        Math.floor(
                            Math.log(bytes) /
                            Math.log(1024)),
                        units.length - 1);

                const value =
                    bytes /
                    Math.pow(1024, unitIndex);

                return `${value.toFixed(
                    unitIndex === 0 ? 0 : 2
                )} ${units[unitIndex]}`;
            };

            const getExtension = (name) => {
                const lastDot =
                    name.lastIndexOf(".");

                if (lastDot < 0) {
                    return "";
                }

                return name
                    .substring(lastDot)
                    .toLowerCase();
            };

            const showValidation = (message) => {
                if (!validationMessage) {
                    return;
                }

                validationMessage.textContent =
                    message;

                validationMessage.hidden =
                    false;
            };

            const clearValidation = () => {
                if (!validationMessage) {
                    return;
                }

                validationMessage.textContent =
                    "";

                validationMessage.hidden =
                    true;
            };

            const clearFile = () => {
                fileInput.value = "";

                if (filePreview) {
                    filePreview.hidden = true;
                }

                if (fileName) {
                    fileName.textContent =
                        "No file selected";
                }

                if (fileMeta) {
                    fileMeta.textContent =
                        "Select PDF, XLSX or XLS";
                }

                if (fileIcon) {
                    fileIcon.textContent = "F";
                }

                submitButton.disabled = true;
                clearValidation();

                dropZone.classList.remove(
                    "viu-has-file");
            };

            const validateAndDisplayFile =
                (file) => {
                    clearValidation();

                    if (!file) {
                        clearFile();
                        return false;
                    }

                    const extension =
                        getExtension(file.name);

                    if (!allowedExtensions
                        .includes(extension)) {
                        showValidation(
                            "Unsupported file format. Select PDF, XLSX or XLS.");

                        clearFile();

                        return false;
                    }

                    if (file.size <= 0) {
                        showValidation(
                            "The selected file is empty.");

                        clearFile();

                        return false;
                    }

                    if (file.size >
                        maximumFileSize) {
                        showValidation(
                            "File size is above 25 MB. Select a smaller invoice file.");

                        clearFile();

                        return false;
                    }

                    if (filePreview) {
                        filePreview.hidden = false;
                    }

                    if (fileName) {
                        fileName.textContent =
                            file.name;
                    }

                    if (fileMeta) {
                        fileMeta.textContent =
                            `${extension
                                .replace(".", "")
                                .toUpperCase()} • ${formatFileSize(file.size)}`;
                    }

                    if (fileIcon) {
                        fileIcon.textContent =
                            extension === ".pdf"
                                ? "P"
                                : "X";
                    }

                    submitButton.disabled = false;

                    dropZone.classList.add(
                        "viu-has-file");

                    return true;
                };

            dropZone.addEventListener(
                "click",
                () => fileInput.click());

            dropZone.addEventListener(
                "keydown",
                (event) => {
                    if (event.key === "Enter" ||
                        event.key === " ") {
                        event.preventDefault();
                        fileInput.click();
                    }
                });

            fileInput.addEventListener(
                "click",
                (event) => {
                    event.stopPropagation();
                });

            fileInput.addEventListener(
                "change",
                () => {
                    validateAndDisplayFile(
                        fileInput.files?.[0]);
                });

            ["dragenter", "dragover"]
                .forEach((eventName) => {
                    dropZone.addEventListener(
                        eventName,
                        (event) => {
                            event.preventDefault();
                            event.stopPropagation();

                            dropZone.classList.add(
                                "viu-drag-active");
                        });
                });

            ["dragleave", "drop"]
                .forEach((eventName) => {
                    dropZone.addEventListener(
                        eventName,
                        (event) => {
                            event.preventDefault();
                            event.stopPropagation();

                            dropZone.classList.remove(
                                "viu-drag-active");
                        });
                });

            dropZone.addEventListener(
                "drop",
                (event) => {
                    const droppedFile =
                        event.dataTransfer
                            ?.files?.[0];

                    if (!droppedFile) {
                        return;
                    }

                    const transfer =
                        new DataTransfer();

                    transfer.items.add(
                        droppedFile);

                    fileInput.files =
                        transfer.files;

                    validateAndDisplayFile(
                        droppedFile);
                });

            removeButton?.addEventListener(
                "click",
                clearFile);

            form.addEventListener(
                "submit",
                (event) => {
                    const file =
                        fileInput.files?.[0];

                    if (!validateAndDisplayFile(file)) {
                        event.preventDefault();
                        return;
                    }

                    submitButton.disabled = true;
                    submitButton.textContent =
                        "Uploading...";

                    if (uploadProgress) {
                        uploadProgress.hidden =
                            false;
                    }

                    removeButton?.setAttribute(
                        "disabled",
                        "disabled");

                    dropZone.classList.add(
                        "viu-uploading");
                });
        })();

        (() => {
            "use strict";
            const form = document.getElementById("invoiceBulkForm");
            const zone = document.getElementById("invoiceBulkDropZone");
            const input = document.getElementById("invoiceBulkFiles");
            const list = document.getElementById("invoiceBulkList");
            const meta = document.getElementById("invoiceBulkMeta");
            const count = document.getElementById("invoiceBulkCount");
            const size = document.getElementById("invoiceBulkSize");
            const clear = document.getElementById("invoiceBulkClear");
            const submit = document.getElementById("invoiceBulkSubmit");
            const validation = document.getElementById("invoiceBulkValidation");
            if (!form || !zone || !input || !list || !submit) return;

            const maxCount = 100;
            const maxFileSize = 20 * 1024 * 1024;
            const maxTotalSize = 200 * 1024 * 1024;
            const allowed = [".pdf", ".xlsx", ".xls"];
            let files = [];

            const extension = name => name.includes(".") ? name.substring(name.lastIndexOf(".")).toLowerCase() : "";
            const format = bytes => bytes < 1024 * 1024 ? `${(bytes / 1024).toFixed(1)} KB` : `${(bytes / 1024 / 1024).toFixed(2)} MB`;
            const total = () => files.reduce((sum, file) => sum + file.size, 0);
            const key = file => `${file.name}|${file.size}|${file.lastModified}`;

            function message(messages) {
                if (!validation) return;
                validation.hidden = messages.length === 0;
                validation.innerHTML = messages.map(x => `<div>${x}</div>`).join("");
            }

            function sync() {
                const transfer = new DataTransfer();
                files.forEach(file => transfer.items.add(file));
                input.files = transfer.files;
            }

            function render() {
                sync();
                list.innerHTML = "";
                files.forEach((file, index) => {
                    const row = document.createElement("div");
                    row.className = "viu-bulk-file";
                    const name = document.createElement("strong");
                    name.textContent = file.name;
                    const fileSize = document.createElement("span");
                    fileSize.textContent = format(file.size);
                    const remove = document.createElement("button");
                    remove.type = "button";
                    remove.className = "viu-bulk-remove";
                    remove.textContent = "Remove";
                    remove.addEventListener("click", () => { files.splice(index, 1); render(); });
                    row.append(name, fileSize, remove);
                    list.appendChild(row);
                });
                if (meta) meta.hidden = files.length === 0;
                if (clear) clear.hidden = files.length === 0;
                if (count) count.textContent = files.length;
                if (size) size.textContent = format(total());
                submit.disabled = files.length === 0;
            }

            function addFiles(incoming) {
                const messages = [];
                const existing = new Set(files.map(key));
                for (const file of Array.from(incoming || [])) {
                    if (files.length >= maxCount) { messages.push(`Only ${maxCount} files are allowed.`); break; }
                    if (!allowed.includes(extension(file.name))) { messages.push(`${file.name}: unsupported format.`); continue; }
                    if (file.size <= 0) { messages.push(`${file.name}: file is empty.`); continue; }
                    if (file.size > maxFileSize) { messages.push(`${file.name}: exceeds 20 MB.`); continue; }
                    if (existing.has(key(file))) { messages.push(`${file.name}: already selected.`); continue; }
                    if (total() + file.size > maxTotalSize) { messages.push(`${file.name}: combined size would exceed 200 MB.`); continue; }
                    files.push(file); existing.add(key(file));
                }
                message(messages); render();
            }

            zone.addEventListener("click", () => input.click());
            zone.addEventListener("keydown", event => {
                if (event.key === "Enter" || event.key === " ") { event.preventDefault(); input.click(); }
            });
            input.addEventListener("click", event => event.stopPropagation());
            input.addEventListener("change", () => { addFiles(input.files); });
            ["dragenter", "dragover"].forEach(name => zone.addEventListener(name, event => {
                event.preventDefault(); zone.classList.add("is-dragging");
            }));
            ["dragleave", "drop"].forEach(name => zone.addEventListener(name, event => {
                event.preventDefault(); zone.classList.remove("is-dragging");
            }));
            zone.addEventListener("drop", event => addFiles(event.dataTransfer?.files));
            clear?.addEventListener("click", () => { files = []; message([]); render(); });
            form.addEventListener("submit", event => {
                if (files.length === 0) { event.preventDefault(); message(["Select at least one invoice file."]); return; }
                submit.disabled = true;
                submit.textContent = `Extracting ${files.length} invoices...`;
            });
            render();
        })();
    </script>
}
