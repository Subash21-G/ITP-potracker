@using System.Globalization
@model POTracker.ViewModels.InvoiceImportPreviewViewModel

@{
    ViewData["Title"] = "Invoice Import Preview";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var items =
        Model.Items
        ?? new List<POTracker.ViewModels.InvoiceImportItemViewModel>();

    int totalRows =
        items.Count;

    decimal totalQty =
        items.Sum(x => x.InvoiceQty);

    decimal totalGst =
        items.Sum(x => x.GstAmount);

    decimal totalAmount =
        items.Sum(x => x.Amount);

    int readyRows =
        items.Count(x =>
            !string.IsNullOrWhiteSpace(x.PONumber) &&
            !string.IsNullOrWhiteSpace(x.MaterialNo) &&
            !string.IsNullOrWhiteSpace(x.LineItem) &&
            x.InvoiceQty > 0);

    int storedRows =
        totalRows - readyRows;

    string DecimalValue(decimal value)
    {
        return value.ToString(
            "0.####",
            CultureInfo.InvariantCulture);
    }
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/invoice-preview-premium.css"
          asp-append-version="true" />
}

<div class="vip-page">

    <!-- =========================================================
         PAGE HEADER
    ========================================================== -->

    <section class="vip-header">

        <div>
            <span class="vip-kicker">
                Invoice verification
            </span>

            <h1>Invoice Import Preview</h1>

            <p>
                Verify and edit every extracted invoice row before
                saving. InvoiceQty and DispatchQty are updated only
                after final confirmation.
            </p>
        </div>

        <div class="vip-header-actions">

            <a asp-action="Upload"
               asp-controller="VyaparInvoiceImport"
               class="vip-btn vip-btn-light">
                Back to Upload
            </a>

            <a asp-action="History"
               asp-controller="VyaparInvoiceImport"
               class="vip-btn vip-btn-light">
                Import History
            </a>

            <a asp-action="InvoiceList"
               asp-controller="VyaparInvoiceImport"
               class="vip-btn vip-btn-light">
                Imported Invoices
            </a>
        </div>
    </section>

    <!-- =========================================================
         MESSAGE
    ========================================================== -->
    @if (TempData["Error"] != null)
    {
        <div class="vip-alert vip-alert-danger">
            @TempData["Error"]
        </div>
    }

    @if (ViewData["Error"] != null)
    {
        <div class="vip-alert vip-alert-danger">
            @ViewData["Error"]
        </div>
    }

    <!-- =========================================================
         SUMMARY CARDS
    ========================================================== -->

    <section class="vip-summary-grid">

        <article class="vip-summary-card vip-summary-violet">
            <span>Invoice No</span>

            <strong title="@Model.InvoiceNumber">
                @(string.IsNullOrWhiteSpace(Model.InvoiceNumber)
                    ? "-"
                    : Model.InvoiceNumber)
            </strong>

            <small>Imported invoice reference</small>
        </article>

        <article class="vip-summary-card vip-summary-blue">
            <span>Invoice Date</span>

            <strong>
                @(Model.InvoiceDate?.ToString("dd-MMM-yyyy") ?? "-")
            </strong>

            <small>Invoice document date</small>
        </article>

        <article class="vip-summary-card vip-summary-teal">
            <span>Total Rows</span>

            <strong id="summaryTotalRows">
                @totalRows
            </strong>

            <small>Extracted material rows</small>
        </article>

        <article class="vip-summary-card vip-summary-green">
            <span>Valid for Matching</span>

            <strong id="summaryReadyRows">
                @readyRows
            </strong>

            <small>Rows with complete match keys</small>
        </article>

        <article class="vip-summary-card vip-summary-amber">
            <span>Needs Review</span>

            <strong id="summaryStoredRows">
                @storedRows
            </strong>

            <small>Rows requiring correction or later matching</small>
        </article>

        <article class="vip-summary-card vip-summary-cyan">
            <span>Total Quantity</span>

            <strong id="summaryTotalQty">
                @totalQty.ToString("0.##")
            </strong>

            <small>Combined invoice quantity</small>
        </article>

        <article class="vip-summary-card vip-summary-rose">
            <span>Total GST</span>

            <strong id="summaryTotalGst">
                ₹ @totalGst.ToString("0.00")
            </strong>

            <small>Combined GST amount</small>
        </article>

        <article class="vip-summary-card vip-summary-dark">
            <span>Total Amount</span>

            <strong id="summaryTotalAmount">
                ₹ @totalAmount.ToString("0.00")
            </strong>

            <small>Combined invoice value</small>
        </article>
    </section>

    <!-- =========================================================
         HEADER DETAILS + CHECKLIST
    ========================================================== -->

    <section class="vip-two-column">

        <div class="vip-card">

            <div class="vip-section-head">

                <div>
                    <span class="vip-kicker">
                        Invoice information
                    </span>

                    <h2>Invoice Header</h2>
                </div>
            </div>

            <div class="vip-details-grid">

                <div class="vip-detail-item">
                    <span>Invoice Number</span>

                    <strong>
                        @(string.IsNullOrWhiteSpace(Model.InvoiceNumber)
                            ? "-"
                            : Model.InvoiceNumber)
                    </strong>
                </div>

                <div class="vip-detail-item">
                    <span>Invoice Date</span>

                    <strong>
                        @(Model.InvoiceDate?.ToString("dd-MMM-yyyy") ?? "-")
                    </strong>
                </div>

                <div class="vip-detail-item">
                    <span>Customer Name</span>

                    <strong title="@Model.CustomerName">
                        @(string.IsNullOrWhiteSpace(Model.CustomerName)
                            ? "-"
                            : Model.CustomerName)
                    </strong>
                </div>

                <div class="vip-detail-item">
                    <span>Uploaded File</span>

                    @if (!string.IsNullOrWhiteSpace(Model.UploadedFilePath))
                    {
                        <a href="@Model.UploadedFilePath"
                           target="_blank"
                           rel="noopener noreferrer"
                           class="vip-file-link"
                           title="@Model.UploadedFileName">
                            @(string.IsNullOrWhiteSpace(Model.UploadedFileName)
                                ? "View Uploaded File"
                                : Model.UploadedFileName)
                        </a>
                    }
                    else
                    {
                        <strong>
                            @(string.IsNullOrWhiteSpace(Model.UploadedFileName)
                                ? "-"
                                : Model.UploadedFileName)
                        </strong>
                    }
                </div>
            </div>
        </div>

        <div class="vip-card">

            <div class="vip-section-head">

                <div>
                    <span class="vip-kicker">
                        Before saving
                    </span>

                    <h2>Verification Checklist</h2>
                </div>
            </div>

            <div class="vip-check-list">

                <article class="vip-check vip-check-info">
                    <strong>Matching rule</strong>

                    <p>
                        The system checks PO Number, Material Number
                        and Line Item when saving.
                    </p>
                </article>

                <article class="vip-check vip-check-warning">
                    <strong>Stored rows</strong>

                    <p>
                        A row becomes Pending only when valid PO and material values are present but no safe database match is found.
                    </p>
                </article>

                <article class="vip-check vip-check-danger">
                    <strong>Duplicate protection</strong>

                    <p>
                        Duplicate match keys and invalid quantities are
                        highlighted before final save.
                    </p>
                </article>
            </div>
        </div>
    </section>

    <!-- =========================================================
         SAVE FORM
    ========================================================== -->

    <form asp-action="SaveAll"
          asp-controller="VyaparInvoiceImport"
          method="post"
          id="invoicePreviewForm">

        @Html.AntiForgeryToken()

        <input type="hidden"
               asp-for="UploadedFileName" />

        <input type="hidden"
               asp-for="UploadedFilePath" />

        <section class="vip-card">

            <div class="vip-section-head">
                <div>
                    <span class="vip-kicker">
                        Required verification
                    </span>

                    <h2>Correct Invoice Header Before Saving</h2>

                    <p>
                        Confirm the invoice number and date. A placeholder
                        beginning with REVIEW- must be corrected.
                    </p>
                </div>
            </div>

            <div class="vip-details-grid">

                <div class="vip-detail-item">
                    <label for="InvoiceNumber">
                        Invoice Number *
                    </label>

                    <input asp-for="InvoiceNumber"
                           class="vip-input"
                           required
                           autocomplete="off"
                           placeholder="Enter invoice number" />

                    <span asp-validation-for="InvoiceNumber"
                          class="text-danger"></span>
                </div>

                <div class="vip-detail-item">
                    <label for="InvoiceDate">
                        Invoice Date
                    </label>

                    <input type="date"
                           asp-for="InvoiceDate"
                           value="@(Model.InvoiceDate?.ToString("yyyy-MM-dd"))"
                           class="vip-input" />
                </div>

                <div class="vip-detail-item">
                    <label for="CustomerName">
                        Customer Name
                    </label>

                    <input asp-for="CustomerName"
                           class="vip-input"
                           autocomplete="off"
                           placeholder="Enter customer name" />
                </div>

                <div class="vip-detail-item">
                    <span>Uploaded File</span>

                    <strong>
                        @(string.IsNullOrWhiteSpace(Model.UploadedFileName)
                            ? "-"
                            : Model.UploadedFileName)
                    </strong>
                </div>
            </div>
        </section>

        <section class="vip-card">

            <div class="vip-section-head">

                <div>
                    <span class="vip-kicker">
                        Editable preview
                    </span>

                    <h2>Invoice Item Preview</h2>

                    <p>
                        Verify or correct the extracted fields before
                        saving the invoice into PO Tracker.
                    </p>
                </div>

                <span class="vip-count-badge"
                      id="visiblePreviewRowCount">
                    @totalRows Row(s)
                </span>
            </div>

            @if (items.Count == 0)
            {
                <div class="vip-empty-state">

                    <div class="vip-empty-icon">
                        I
                    </div>

                    <h3>No invoice items found</h3>

                    <p>
                        Upload a supported Vyapar invoice containing
                        material item rows.
                    </p>

                    <a asp-action="Upload"
                       asp-controller="VyaparInvoiceImport"
                       class="vip-btn vip-btn-primary">
                        Upload Another File
                    </a>
                </div>
            }
            else
            {
                <div class="vip-table-note">

                    <span>
                        Editable fields
                    </span>

                    <p>
                        PO, line item, material, description, quantity,
                        rate, GST and amount can be corrected here.
                    </p>
                </div>

                <div class="vip-table-wrap">

                    <table class="vip-table"
                           id="invoicePreviewTable">

                        <thead>
                            <tr>
                                <th>#</th>
                                <th>PO Date</th>
                                <th>PO No</th>
                                <th>Line Item</th>
                                <th>Material No</th>
                                <th>Description</th>
                                <th>HSN/SAC</th>
                                <th>Invoice Qty</th>
                                <th>Rate</th>
                                <th>GST</th>
                                <th>Amount</th>
                                <th>Preview Status</th>
                                <th>Note</th>
                            </tr>
                        </thead>

                        <tbody>

                            @for (int i = 0; i < items.Count; i++)
                            {
                                var item =
                                    items[i];

                                bool hasMatchKey =
                                    !string.IsNullOrWhiteSpace(item.PONumber) &&
                                    !string.IsNullOrWhiteSpace(item.MaterialNo) &&
                                    !string.IsNullOrWhiteSpace(item.LineItem);

                                bool hasValidQty =
                                    item.InvoiceQty > 0;

                                string initialStatus =
                                    hasMatchKey && hasValidQty
                                        ? "Valid for Matching"
                                        : "Stored";

                                string initialStatusClass =
                                    hasMatchKey && hasValidQty
                                        ? "vip-status-success"
                                        : "vip-status-warning";

                                string initialNote =
                                    !hasValidQty
                                        ? "Enter quantity greater than zero."
                                        : !hasMatchKey
                                            ? "Complete PO, material and line item."
                                            : "Fields are valid; database matching happens during save.";

                                <tr class="vip-preview-row"
                                    data-row-index="@i">

                                    <td>
                                        <span class="vip-row-number">
                                            @(i + 1)
                                        </span>
                                    </td>

                                    <td>
                                        <input type="date"
                                               name="Items[@i].PODate"
                                               value="@(item.PODate?.ToString("yyyy-MM-dd"))"
                                               class="vip-input vip-date-input"
                                               data-field="poDate"
                                               aria-label="PO date row @(i + 1)" />
                                    </td>

                                    <td>
                                        <input type="text"
                                               name="Items[@i].PONumber"
                                               value="@item.PONumber"
                                               class="vip-input vip-po-input"
                                               data-field="poNumber"
                                               placeholder="PO number"
                                               aria-label="PO number row @(i + 1)" />
                                    </td>

                                    <td>
                                        <input type="text"
                                               name="Items[@i].LineItem"
                                               value="@item.LineItem"
                                               class="vip-input vip-line-input"
                                               data-field="lineItem"
                                               placeholder="Line item"
                                               aria-label="Line item row @(i + 1)" />
                                    </td>

                                    <td>
                                        <input type="text"
                                               name="Items[@i].MaterialNo"
                                               value="@item.MaterialNo"
                                               class="vip-input vip-material-input"
                                               data-field="materialNo"
                                               placeholder="Material number"
                                               aria-label="Material number row @(i + 1)" />
                                    </td>

                                    <td>
                                        <textarea name="Items[@i].Description"
                                                  class="vip-input vip-description-input"
                                                  data-field="description"
                                                  rows="2"
                                                  placeholder="Description"
                                                  aria-label="Description row @(i + 1)">@item.Description</textarea>
                                    </td>

                                    <td>
                                        <input type="text"
                                               name="Items[@i].HsnSacCode"
                                               value="@item.HsnSacCode"
                                               class="vip-input vip-hsn-input"
                                               data-field="hsnSacCode"
                                               placeholder="HSN/SAC"
                                               aria-label="HSN or SAC row @(i + 1)" />
                                    </td>

                                    <td>
                                        <input type="number"
                                               name="Items[@i].InvoiceQty"
                                               value="@DecimalValue(item.InvoiceQty)"
                                               class="vip-input vip-number-input vip-qty-input"
                                               data-field="invoiceQty"
                                               step="0.01"
                                               min="0"
                                               inputmode="decimal"
                                               aria-label="Invoice quantity row @(i + 1)" />
                                    </td>

                                    <td>
                                        <div class="vip-money-input">
                                            <span>₹</span>

                                            <input type="number"
                                                   name="Items[@i].PriceUnit"
                                                   value="@DecimalValue(item.PriceUnit)"
                                                   class="vip-input vip-number-input vip-rate-input"
                                                   data-field="priceUnit"
                                                   step="0.01"
                                                   min="0"
                                                   inputmode="decimal"
                                                   aria-label="Rate row @(i + 1)" />
                                        </div>
                                    </td>

                                    <td>
                                        <div class="vip-money-input">
                                            <span>₹</span>

                                            <input type="number"
                                                   name="Items[@i].GstAmount"
                                                   value="@DecimalValue(item.GstAmount)"
                                                   class="vip-input vip-number-input vip-gst-input"
                                                   data-field="gstAmount"
                                                   step="0.01"
                                                   min="0"
                                                   inputmode="decimal"
                                                   aria-label="GST amount row @(i + 1)" />
                                        </div>
                                    </td>

                                    <td>
                                        <div class="vip-money-input">
                                            <span>₹</span>

                                            <input type="number"
                                                   name="Items[@i].Amount"
                                                   value="@DecimalValue(item.Amount)"
                                                   class="vip-input vip-number-input vip-amount-input"
                                                   data-field="amount"
                                                   step="0.01"
                                                   min="0"
                                                   inputmode="decimal"
                                                   aria-label="Amount row @(i + 1)" />
                                        </div>
                                    </td>

                                    <td>
                                        <span class="vip-status @initialStatusClass"
                                              data-role="previewStatus">
                                            @initialStatus
                                        </span>
                                    </td>

                                    <td>
                                        <span class="vip-row-note"
                                              data-role="previewNote">
                                            @initialNote
                                        </span>
                                    </td>
                                </tr>
                            }
                        </tbody>

                        <tfoot>
                            <tr>
                                <th colspan="7"
                                    class="vip-text-right">
                                    Total
                                </th>

                                <th id="footerTotalQty">
                                    @totalQty.ToString("0.##")
                                </th>

                                <th></th>

                                <th id="footerTotalGst">
                                    ₹ @totalGst.ToString("0.00")
                                </th>

                                <th id="footerTotalAmount">
                                    ₹ @totalAmount.ToString("0.00")
                                </th>

                                <th colspan="2"></th>
                            </tr>
                        </tfoot>
                    </table>
                </div>

                <div class="vip-save-warning"
                     id="storedRowWarning"
                     hidden>

                    <strong>
                        Some rows need review
                    </strong>

                    <p>
                        Correct missing or duplicate values before saving. Only unmatched valid rows can be stored as Pending.
                    </p>
                </div>

                <div class="vip-form-actions">

                    <a asp-action="Upload"
                       asp-controller="VyaparInvoiceImport"
                       class="vip-btn vip-btn-light">
                        Cancel
                    </a>

                    <a asp-action="Upload"
                       asp-controller="VyaparInvoiceImport"
                       class="vip-btn vip-btn-light">
                        Upload Another File
                    </a>

                    <button type="submit"
                            class="vip-btn vip-btn-primary"
                            id="saveInvoiceButton">
                        Save Invoice
                    </button>
                </div>

                <div class="vip-saving-state"
                     id="savingState"
                     hidden>

                    <div class="vip-saving-head">
                        <span>
                            Saving invoice and updating quantities...
                        </span>

                        <strong>
                            Please wait
                        </strong>
                    </div>

                    <div class="vip-saving-track">
                        <i></i>
                    </div>
                </div>
            }
        </section>
    </form>
</div>

@section Scripts {
    <script>
        (() => {
            "use strict";

            const form =
                document.getElementById(
                    "invoicePreviewForm");

            const table =
                document.getElementById(
                    "invoicePreviewTable");

            const saveButton =
                document.getElementById(
                    "saveInvoiceButton");

            const savingState =
                document.getElementById(
                    "savingState");

            const storedWarning =
                document.getElementById(
                    "storedRowWarning");

            if (!form ||
                !table ||
                !saveButton) {
                return;
            }

            const rows =
                Array.from(
                    table.querySelectorAll(
                        ".vip-preview-row"));

            const summaryReadyRows =
                document.getElementById(
                    "summaryReadyRows");

            const summaryStoredRows =
                document.getElementById(
                    "summaryStoredRows");

            const summaryTotalQty =
                document.getElementById(
                    "summaryTotalQty");

            const summaryTotalGst =
                document.getElementById(
                    "summaryTotalGst");

            const summaryTotalAmount =
                document.getElementById(
                    "summaryTotalAmount");

            const footerTotalQty =
                document.getElementById(
                    "footerTotalQty");

            const footerTotalGst =
                document.getElementById(
                    "footerTotalGst");

            const footerTotalAmount =
                document.getElementById(
                    "footerTotalAmount");

            const parseNumber = (value) => {
                const parsed =
                    Number.parseFloat(value);

                return Number.isFinite(parsed)
                    ? parsed
                    : 0;
            };

            const normalize = (value) => {
                return (value ?? "")
                    .trim()
                    .toLowerCase();
            };

            const formatQty = (value) => {
                return value.toLocaleString(
                    undefined,
                    {
                        minimumFractionDigits: 0,
                        maximumFractionDigits: 2
                    });
            };

            const formatMoney = (value) => {
                return `₹ ${value.toLocaleString(
                    undefined,
                    {
                        minimumFractionDigits: 2,
                        maximumFractionDigits: 2
                    })}`;
            };

            const getInput = (row, field) => {
                return row.querySelector(
                    `[data-field="${field}"]`);
            };

            const evaluateRows = () => {
                const keyCounts =
                    new Map();

                rows.forEach((row) => {
                    const po =
                        normalize(
                            getInput(
                                row,
                                "poNumber")?.value);

                    const material =
                        normalize(
                            getInput(
                                row,
                                "materialNo")?.value);

                    const line =
                        normalize(
                            getInput(
                                row,
                                "lineItem")?.value);

                    if (!po ||
                        !material ||
                        !line) {
                        return;
                    }

                    const key =
                        `${po}|${material}|${line}`;

                    keyCounts.set(
                        key,
                        (keyCounts.get(key) ?? 0) + 1);
                });

                let readyCount = 0;
                let storedCount = 0;
                let totalQtyValue = 0;
                let totalGstValue = 0;
                let totalAmountValue = 0;

                rows.forEach((row) => {
                    const po =
                        normalize(
                            getInput(
                                row,
                                "poNumber")?.value);

                    const material =
                        normalize(
                            getInput(
                                row,
                                "materialNo")?.value);

                    const line =
                        normalize(
                            getInput(
                                row,
                                "lineItem")?.value);

                    const qty =
                        parseNumber(
                            getInput(
                                row,
                                "invoiceQty")?.value);

                    const gst =
                        parseNumber(
                            getInput(
                                row,
                                "gstAmount")?.value);

                    const amount =
                        parseNumber(
                            getInput(
                                row,
                                "amount")?.value);

                    totalQtyValue += qty;
                    totalGstValue += gst;
                    totalAmountValue += amount;

                    const status =
                        row.querySelector(
                            '[data-role="previewStatus"]');

                    const note =
                        row.querySelector(
                            '[data-role="previewNote"]');

                    const hasMatchKey =
                        Boolean(
                            po &&
                            material &&
                            line);

                    const key =
                        hasMatchKey
                            ? `${po}|${material}|${line}`
                            : "";

                    const duplicate =
                        key &&
                        (keyCounts.get(key) ?? 0) > 1;

                    let ready = true;
                    let message =
                        "Fields are valid; database matching happens during save.";

                    if (qty <= 0) {
                        ready = false;
                        message =
                            "Enter quantity greater than zero.";
                    } else if (!hasMatchKey) {
                        ready = false;
                        message =
                            "Complete PO, material and line item.";
                    } else if (duplicate) {
                        ready = false;
                        message =
                            "Duplicate match key detected.";
                    }

                    row.classList.toggle(
                        "vip-row-stored",
                        !ready);

                    if (status) {
                        status.textContent =
                            ready
                                ? "Valid for Matching"
                                : "Stored";

                        status.classList.toggle(
                            "vip-status-success",
                            ready);

                        status.classList.toggle(
                            "vip-status-warning",
                            !ready);
                    }

                    if (note) {
                        note.textContent =
                            message;
                    }

                    if (ready) {
                        readyCount++;
                    } else {
                        storedCount++;
                    }
                });

                if (summaryReadyRows) {
                    summaryReadyRows.textContent =
                        readyCount.toString();
                }

                if (summaryStoredRows) {
                    summaryStoredRows.textContent =
                        storedCount.toString();
                }

                if (summaryTotalQty) {
                    summaryTotalQty.textContent =
                        formatQty(totalQtyValue);
                }

                if (summaryTotalGst) {
                    summaryTotalGst.textContent =
                        formatMoney(totalGstValue);
                }

                if (summaryTotalAmount) {
                    summaryTotalAmount.textContent =
                        formatMoney(totalAmountValue);
                }

                if (footerTotalQty) {
                    footerTotalQty.textContent =
                        formatQty(totalQtyValue);
                }

                if (footerTotalGst) {
                    footerTotalGst.textContent =
                        formatMoney(totalGstValue);
                }

                if (footerTotalAmount) {
                    footerTotalAmount.textContent =
                        formatMoney(totalAmountValue);
                }

                if (storedWarning) {
                    storedWarning.hidden =
                        storedCount === 0;
                }
            };

            table.addEventListener(
                "input",
                (event) => {
                    if (event.target.matches(
                        ".vip-input")) {
                        evaluateRows();
                    }
                });

            form.addEventListener(
                "submit",
                (event) => {
                    evaluateRows();

                    const storedCount =
                        Number.parseInt(
                            summaryStoredRows?.textContent
                                ?? "0",
                            10);

                    const confirmation =
                        storedCount > 0
                            ? `Save this invoice? ${storedCount} row(s) need review and may become Failed or Pending. InvoiceQty and DispatchQty will update for matched rows.`
                            : "Save this invoice? InvoiceQty and DispatchQty will be updated.";

                    const confirmed =
                        window.confirm(
                            confirmation);

                    if (!confirmed) {
                        event.preventDefault();
                        return;
                    }

                    saveButton.disabled = true;
                    saveButton.textContent =
                        "Saving...";

                    if (savingState) {
                        savingState.hidden =
                            false;
                    }

                    table
                        .querySelectorAll(
                            "input, textarea")
                        .forEach((input) => {
                            input.readOnly = true;
                        });
                });

            evaluateRows();
        })();
    </script>
}
