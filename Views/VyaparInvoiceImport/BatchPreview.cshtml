@using POTracker.ViewModels
@model InvoiceBatchImportPreviewViewModel

@{
    ViewData["Title"] = "Bulk Invoice Import Preview";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var selectableCount = Model.Files.Count(x =>
        x.IsSuccessful &&
        !x.IsDuplicateInBatch &&
        !x.ExistsInDatabase &&
        x.Invoice != null);
}

<style>
    .ib-page {
        max-width: 1500px;
        margin: 0 auto;
        color: #172033;
    }

    .ib-header {
        display: flex;
        justify-content: space-between;
        gap: 20px;
        align-items: flex-start;
        margin-bottom: 22px;
    }

        .ib-header h1 {
            margin: 0;
            font-size: 32px;
            font-weight: 900;
        }

        .ib-header p {
            margin: 8px 0 0;
            color: #64748b;
        }

    .ib-back {
        padding: 11px 16px;
        border: 1px solid #dbe2ea;
        border-radius: 11px;
        background: #fff;
        color: #334155;
        text-decoration: none;
        font-weight: 800;
    }

    .ib-summary {
        display: grid;
        grid-template-columns: repeat(6,minmax(0,1fr));
        gap: 12px;
        margin-bottom: 20px;
    }

    .ib-stat {
        padding: 17px;
        border: 1px solid #e2e8f0;
        border-radius: 15px;
        background: #fff;
        box-shadow: 0 8px 24px rgba(15,23,42,.06);
    }

        .ib-stat span {
            display: block;
            color: #64748b;
            font-size: 11px;
            font-weight: 900;
            text-transform: uppercase;
        }

        .ib-stat strong {
            display: block;
            margin-top: 7px;
            font-size: 27px;
        }

    .ib-success strong {
        color: #15803d;
    }

    .ib-danger strong {
        color: #b91c1c;
    }

    .ib-warning strong {
        color: #b45309;
    }

    .ib-info strong {
        color: #0369a1;
    }

    .ib-toolbar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        padding: 14px 16px;
        margin-bottom: 15px;
        border: 1px solid #e2e8f0;
        border-radius: 13px;
        background: #fff;
    }

    .ib-tools {
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
    }

    .ib-btn {
        padding: 10px 14px;
        border: 1px solid #d5dce7;
        border-radius: 9px;
        background: #fff;
        color: #334155;
        font-weight: 800;
        cursor: pointer;
        text-decoration: none;
    }

    .ib-save {
        border-color: #4f46e5;
        background: linear-gradient(135deg,#6366f1,#4338ca);
        color: #fff;
    }

        .ib-save:disabled {
            opacity: .5;
            cursor: not-allowed;
        }

    .ib-list {
        display: grid;
        gap: 14px;
    }

    .ib-card {
        overflow: hidden;
        border: 1px solid #dfe5ee;
        border-radius: 15px;
        background: #fff;
        box-shadow: 0 9px 26px rgba(15,23,42,.06);
    }

        .ib-card.failed {
            border-color: #fecaca;
        }

        .ib-card.duplicate {
            border-color: #fde68a;
        }

        .ib-card.existing {
            border-color: #bae6fd;
        }

    .ib-card-head {
        display: grid;
        grid-template-columns: auto minmax(0,1fr) auto;
        align-items: center;
        gap: 13px;
        padding: 15px 17px;
        border-bottom: 1px solid #e8edf3;
    }

    .ib-check {
        width: 19px;
        height: 19px;
        accent-color: #4f46e5;
    }

    .ib-name {
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        font-weight: 900;
    }

    .ib-size {
        margin-top: 4px;
        color: #64748b;
        font-size: 12px;
    }

    .ib-badge {
        padding: 7px 10px;
        border-radius: 999px;
        font-size: 11px;
        font-weight: 900;
        white-space: nowrap;
    }

    .ready {
        background: #dcfce7;
        color: #166534;
    }

    .failed-b {
        background: #fee2e2;
        color: #991b1b;
    }

    .duplicate-b {
        background: #fef3c7;
        color: #92400e;
    }

    .existing-b {
        background: #e0f2fe;
        color: #075985;
    }

    .ib-message {
        margin: 0;
        padding: 11px 17px;
        background: #fff7ed;
        color: #9a3412;
        font-size: 13px;
        font-weight: 700;
    }

    .ib-grid {
        display: grid;
        grid-template-columns: repeat(5,minmax(0,1fr));
        gap: 11px;
        padding: 15px 17px;
    }

    .ib-field {
        min-width: 0;
        padding: 11px;
        border: 1px solid #e8edf3;
        border-radius: 10px;
        background: #f8fafc;
    }

        .ib-field span {
            display: block;
            color: #64748b;
            font-size: 10px;
            font-weight: 900;
            text-transform: uppercase;
        }

        .ib-field strong {
            display: block;
            margin-top: 5px;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
            font-size: 13px;
        }

    .ib-items {
        padding: 0 17px 15px;
    }

        .ib-items summary {
            padding: 11px 0;
            color: #4338ca;
            font-weight: 900;
            cursor: pointer;
        }

    .ib-table-wrap {
        overflow: auto;
        border: 1px solid #e2e8f0;
        border-radius: 10px;
    }

    .ib-table {
        width: 100%;
        border-collapse: collapse;
        min-width: 950px;
        font-size: 12px;
    }

        .ib-table th, .ib-table td {
            padding: 10px;
            border-bottom: 1px solid #edf1f5;
            text-align: left;
        }

        .ib-table th {
            background: #f8fafc;
            color: #475569;
        }

    .ib-empty {
        padding: 35px;
        text-align: center;
        border: 1px dashed #cbd5e1;
        border-radius: 14px;
        background: #fff;
        color: #64748b;
    }

    @@media(max-width:1000px) {
        .ib-summary {
            grid-template-columns: repeat(3,1fr);
        }

        .ib-grid {
            grid-template-columns: repeat(2,1fr);
        }
    }

    @@media(max-width:650px) {
        .ib-header, .ib-toolbar {
            flex-direction: column;
        }

        .ib-summary {
            grid-template-columns: repeat(2,1fr);
        }

        .ib-grid {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="ib-page">
    <div class="ib-header">
        <div>
            <h1>Bulk Invoice Preview</h1>
            <p>Review extracted invoices and save only the valid selected files.</p>
        </div>
        <a asp-action="Upload" class="ib-back">Back to Upload</a>
    </div>

    <div class="ib-summary">
        <div class="ib-stat"><span>Total files</span><strong>@Model.TotalFiles</strong></div>
        <div class="ib-stat ib-success"><span>Extracted</span><strong>@Model.SuccessfulFiles</strong></div>
        <div class="ib-stat ib-danger"><span>Failed</span><strong>@Model.FailedFiles</strong></div>
        <div class="ib-stat ib-warning"><span>Duplicates</span><strong>@Model.DuplicateFiles</strong></div>
        <div class="ib-stat ib-info"><span>Existing</span><strong>@Model.ExistingInvoiceFiles</strong></div>
        <div class="ib-stat"><span>Invoice rows</span><strong>@Model.TotalInvoiceRows</strong></div>
    </div>

    @if (Model.Files.Count == 0)
    {
        <div class="ib-empty">No invoice files are available for preview.</div>
    }
    else
    {
        <form asp-action="SaveBatch" asp-controller="VyaparInvoiceImport" method="post" id="invoiceBatchForm">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="BatchId" />

            <div class="ib-toolbar">
                <strong><span id="selectedInvoiceCount">@Model.Files.Count(x => x.IsSelected)</span> of @selectableCount valid invoices selected</strong>
                <div class="ib-tools">
                    <button type="button" class="ib-btn" id="selectAllInvoices">Select all valid</button>
                    <button type="button" class="ib-btn" id="clearInvoiceSelection">Clear</button>
                    <button type="submit" class="ib-btn ib-save" id="saveInvoiceBatch" @(selectableCount == 0 ? "disabled" : null)>Save Selected Invoices</button>
                </div>
            </div>

            <div class="ib-list">
                @for (var i = 0; i < Model.Files.Count; i++)
                {
                    var file = Model.Files[i];
                    var invoice = file.Invoice;
                    var canSelect = file.IsSuccessful && !file.IsDuplicateInBatch && !file.ExistsInDatabase && invoice != null;
                    var cardClass = !file.IsSuccessful ? "failed" : file.IsDuplicateInBatch ? "duplicate" : file.ExistsInDatabase ? "existing" : "";

                    <article class="ib-card @cardClass">
                        <input type="hidden" asp-for="Files[i].BatchItemId" />
                        <input type="hidden" asp-for="Files[i].OriginalFileName" />
                        <input type="hidden" asp-for="Files[i].FileSize" />
                        <input type="hidden" asp-for="Files[i].IsSuccessful" />
                        <input type="hidden" asp-for="Files[i].IsDuplicateInBatch" />
                        <input type="hidden" asp-for="Files[i].ExistsInDatabase" />
                        <input type="hidden" asp-for="Files[i].ErrorMessage" />

                        <div class="ib-card-head">
                            @if (canSelect)
                            {
                                <input asp-for="Files[i].IsSelected" class="ib-check invoice-select" />
                            }
                            else
                            {
                                <input type="hidden" asp-for="Files[i].IsSelected" value="false" />
                                <span></span>
                            }
                            <div>
                                <div class="ib-name">@file.OriginalFileName</div>
                                <div class="ib-size">@((file.FileSize / 1024d / 1024d).ToString("0.00")) MB</div>
                            </div>
                            @if (!file.IsSuccessful)
                            {
                                <span class="ib-badge failed-b">Failed</span>
                            }
                            else if (file.IsDuplicateInBatch)
                            {

                                <span class="ib-badge duplicate-b">Duplicate</span>
                            }
                            else if (file.ExistsInDatabase)
                            {

                                <span class="ib-badge existing-b">Already exists</span>
                            }
                            else
                            {

                                <span class="ib-badge ready">Ready</span>
                            }
                        </div>

                        @if (!string.IsNullOrWhiteSpace(file.ErrorMessage))
                        {
                            <p class="ib-message">@file.ErrorMessage</p>
                        }

                        @if (invoice != null)
                        {
                            <input type="hidden" asp-for="Files[i].Invoice!.InvoiceNumber" />
                            <input type="hidden" asp-for="Files[i].Invoice!.InvoiceDate" />
                            <input type="hidden" asp-for="Files[i].Invoice!.CustomerName" />
                            <input type="hidden" asp-for="Files[i].Invoice!.UploadedFileName" />
                            <input type="hidden" asp-for="Files[i].Invoice!.UploadedFilePath" />

                            <div class="ib-grid">
                                <div class="ib-field"><span>Invoice number</span><strong>@invoice.InvoiceNumber</strong></div>
                                <div class="ib-field"><span>Invoice date</span><strong>@(invoice.InvoiceDate?.ToString("dd MMM yyyy") ?? "-")</strong></div>
                                <div class="ib-field"><span>Customer</span><strong>@(invoice.CustomerName ?? "-")</strong></div>
                                <div class="ib-field"><span>Rows</span><strong>@invoice.Items.Count</strong></div>
                                <div class="ib-field"><span>Total quantity</span><strong>@invoice.Items.Sum(x => x.InvoiceQty).ToString("0.##")</strong></div>
                            </div>

                            <details class="ib-items">
                                <summary>View @invoice.Items.Count invoice rows</summary>
                                <div class="ib-table-wrap">
                                    <table class="ib-table">
                                        <thead><tr><th>PO No.</th><th>Line</th><th>Material</th><th>Description</th><th>Qty</th><th>Price</th><th>GST</th><th>Amount</th></tr></thead>
                                        <tbody>
                                            @for (var j = 0; j < invoice.Items.Count; j++)
                                            {
                                                var item = invoice.Items[j];
                                                <tr>
                                                    <td>@item.PONumber</td>
                                                    <td>@item.LineItem</td>
                                                    <td>@item.MaterialNo</td>
                                                    <td>@item.Description</td>
                                                    <td>@item.InvoiceQty</td>
                                                    <td>@item.PriceUnit</td>
                                                    <td>@item.GstAmount</td>
                                                    <td>@item.Amount</td>
                                                </tr>
                                                <input type="hidden" asp-for="Files[i].Invoice!.Items[j].PODate" />
                                                <input type="hidden" asp-for="Files[i].Invoice!.Items[j].PONumber" />
                                                <input type="hidden" asp-for="Files[i].Invoice!.Items[j].LineItem" />
                                                <input type="hidden" asp-for="Files[i].Invoice!.Items[j].MaterialNo" />
                                                <input type="hidden" asp-for="Files[i].Invoice!.Items[j].Description" />
                                                <input type="hidden" asp-for="Files[i].Invoice!.Items[j].HsnSacCode" />
                                                <input type="hidden" asp-for="Files[i].Invoice!.Items[j].InvoiceQty" />
                                                <input type="hidden" asp-for="Files[i].Invoice!.Items[j].PriceUnit" />
                                                <input type="hidden" asp-for="Files[i].Invoice!.Items[j].GstAmount" />
                                                <input type="hidden" asp-for="Files[i].Invoice!.Items[j].Amount" />
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </details>
                        }
                    </article>
                }
            </div>
        </form>
    }
</div>

@section Scripts {
    <script>
        (() => {
            const checks = Array.from(document.querySelectorAll(".invoice-select"));
            const count = document.getElementById("selectedInvoiceCount");
            const save = document.getElementById("saveInvoiceBatch");
            const form = document.getElementById("invoiceBatchForm");

            function refresh() {
                const selected = checks.filter(x => x.checked).length;
                if (count) count.textContent = selected;
                if (save) save.disabled = selected === 0;
            }

            document.getElementById("selectAllInvoices")?.addEventListener("click", () => {
                checks.forEach(x => x.checked = true); refresh();
            });
            document.getElementById("clearInvoiceSelection")?.addEventListener("click", () => {
                checks.forEach(x => x.checked = false); refresh();
            });
            checks.forEach(x => x.addEventListener("change", refresh));
            form?.addEventListener("submit", () => {
                if (save) { save.disabled = true; save.textContent = "Saving invoices..."; }
            });
            refresh();
        })();
    </script>
}
