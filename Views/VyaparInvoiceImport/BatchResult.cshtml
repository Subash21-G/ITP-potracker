@using POTracker.ViewModels
@model InvoiceBatchImportResultViewModel

@{
    ViewData["Title"] = "Bulk Invoice Import Result";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var results = Model?.Results ?? new List<InvoiceBatchImportResultItemViewModel>();
}

<style>
    .ibr-page {
        max-width: 1400px;
        margin: 0 auto;
        color: #172033;
    }

    .ibr-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 18px;
        margin-bottom: 22px;
    }

        .ibr-header h1 {
            margin: 0;
            font-size: 32px;
            font-weight: 900;
        }

        .ibr-header p {
            margin: 8px 0 0;
            color: #64748b;
        }

    .ibr-actions {
        display: flex;
        gap: 9px;
        flex-wrap: wrap;
    }

    .ibr-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 42px;
        padding: 10px 15px;
        border: 1px solid #d8e0ea;
        border-radius: 10px;
        background: #fff;
        color: #334155;
        text-decoration: none;
        font-size: 13px;
        font-weight: 900;
    }

    .ibr-primary {
        border-color: #4f46e5;
        background: linear-gradient(135deg,#6366f1,#4338ca);
        color: #fff;
    }

    .ibr-summary {
        display: grid;
        grid-template-columns: repeat(4,minmax(0,1fr));
        gap: 13px;
        margin-bottom: 21px;
    }

    .ibr-stat {
        padding: 19px;
        border: 1px solid #e2e8f0;
        border-radius: 16px;
        background: #fff;
        box-shadow: 0 9px 28px rgba(15,23,42,.06);
    }

        .ibr-stat span {
            display: block;
            color: #64748b;
            font-size: 11px;
            font-weight: 900;
            text-transform: uppercase;
            letter-spacing: .04em;
        }

        .ibr-stat strong {
            display: block;
            margin-top: 8px;
            font-size: 30px;
        }

    .ibr-success strong {
        color: #15803d;
    }

    .ibr-danger strong {
        color: #b91c1c;
    }

    .ibr-info strong {
        color: #1d4ed8;
    }

    .ibr-card {
        overflow: hidden;
        border: 1px solid #e1e7ef;
        border-radius: 16px;
        background: #fff;
        box-shadow: 0 10px 30px rgba(15,23,42,.06);
    }

    .ibr-table-wrap {
        overflow: auto;
    }

    .ibr-table {
        width: 100%;
        min-width: 900px;
        border-collapse: collapse;
    }

        .ibr-table th, .ibr-table td {
            padding: 14px 16px;
            border-bottom: 1px solid #edf1f5;
            text-align: left;
            vertical-align: top;
        }

        .ibr-table th {
            background: #f8fafc;
            color: #475569;
            font-size: 11px;
            font-weight: 900;
            text-transform: uppercase;
        }

        .ibr-table td {
            font-size: 13px;
        }

    .ibr-file {
        max-width: 260px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        font-weight: 800;
    }

    .ibr-invoice {
        font-weight: 900;
        color: #312e81;
    }

    .ibr-status {
        display: inline-flex;
        padding: 7px 10px;
        border-radius: 999px;
        font-size: 11px;
        font-weight: 900;
        white-space: nowrap;
    }

    .ibr-ok {
        background: #dcfce7;
        color: #166534;
    }

    .ibr-fail {
        background: #fee2e2;
        color: #991b1b;
    }

    .ibr-message-ok {
        color: #166534;
    }

    .ibr-message-fail {
        color: #991b1b;
    }

    .ibr-empty {
        padding: 45px 20px;
        text-align: center;
        color: #64748b;
    }

    @@media(max-width:800px) {
        .ibr-header {
            flex-direction: column;
        }

        .ibr-summary {
            grid-template-columns: repeat(2,1fr);
        }
    }
</style>

<div class="ibr-page">
    <div class="ibr-header">
        <div>
            <h1>Bulk Invoice Import Result</h1>
            <p>Batch ID: @(string.IsNullOrWhiteSpace(Model?.BatchId) ? "-" : Model.BatchId)</p>
        </div>
        <div class="ibr-actions">
            <a asp-action="Upload" class="ibr-btn ibr-primary">Import More Invoices</a>
            <a asp-action="History" class="ibr-btn">Invoice History</a>
            <a asp-action="InvoiceList" class="ibr-btn">Invoice List</a>
        </div>
    </div>

    <div class="ibr-summary">
        <div class="ibr-stat"><span>Total processed</span><strong>@results.Count</strong></div>
        <div class="ibr-stat ibr-success"><span>Imported</span><strong>@results.Count(x => x.IsImported)</strong></div>
        <div class="ibr-stat ibr-danger"><span>Not imported</span><strong>@results.Count(x => !x.IsImported && !x.IsUpdated)</strong></div>
        <div class="ibr-stat ibr-info"><span>Matched rows</span><strong>@results.Sum(x => x.RowsSaved)</strong></div>
    </div>

    <div class="ibr-card">
        @if (results.Count == 0)
        {
            <div class="ibr-empty">No invoice results were generated.</div>
        }
        else
        {
            <div class="ibr-table-wrap">
                <table class="ibr-table">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>File</th>
                            <th>Invoice Number</th>
                            <th>Status</th>
                            <th>Matched Rows</th>
                            <th>Result</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (var i = 0; i < results.Count; i++)
                        {
                            var item = results[i];
                            var successful = item.IsImported || item.IsUpdated;
                            <tr>
                                <td>@(i + 1)</td>
                                <td><div class="ibr-file" title="@item.OriginalFileName">@item.OriginalFileName</div></td>
                                <td class="ibr-invoice">@(string.IsNullOrWhiteSpace(item.InvoiceNumber) ? "-" : item.InvoiceNumber)</td>
                                <td>
                                    <span class="ibr-status @(successful ? "ibr-ok" : "ibr-fail")">
                                        @(item.IsImported ? "Imported" : item.IsUpdated ? "Updated" : "Not Imported")
                                    </span>
                                </td>
                                <td>@item.RowsSaved</td>
                                <td class="@(successful ? "ibr-message-ok" : "ibr-message-fail")">@item.Message</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
