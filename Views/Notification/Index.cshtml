@model List<POTracker.Models.Alert>

@{
    ViewData["Title"] = "Notifications";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="page-header">
    <div>
        <h1>Notification Center</h1>
        <p>Process start, delivery, dispatch and overdue alerts</p>
    </div>
    <a href="/Alert/Index" class="btn-secondary">Smart Alerts</a>
</div>

<div class="premium-grid">
    <div class="metric-card"><span>Total Alerts</span><strong>@Model.Count</strong></div>
    <div class="metric-card"><span>Unread</span><strong>@(ViewBag.UnreadCount ?? 0)</strong></div>
    <div class="metric-card"><span>Mobile Queue</span><strong>@Model.Count(x => !x.IsSentToMobile)</strong></div>
    <div class="metric-card"><span>Due Today</span><strong>@Model.Count(x => x.AlertDate.Date <= DateTime.Today)</strong></div>
</div>

<div class="table-section">
    <table class="custom-table">
        <thead>
            <tr>
                <th>Type</th>
                <th>Material</th>
                <th>Message</th>
                <th>Alert Date</th>
                <th>Status</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td><span class="status-blue">@item.AlertType</span></td>
                    <td>@(item.Material?.MaterialNo ?? "-")</td>
                    <td>@item.Message</td>
                    <td>@item.AlertDate.ToString("dd-MM-yyyy")</td>
                    <td><span class="@(item.IsRead ? "status-green" : "status-yellow")">@(item.IsRead ? "Read" : "Unread")</span></td>
                    <td>
                        @if (!item.IsRead)
                        {
                            <role-access roles="Admin,Production">
                                <form asp-controller="Notification"
                                      asp-action="MarkRead"
                                      asp-route-id="@item.Id"
                                      asp-antiforgery="true"
                                      method="post"
                                      style="display:inline;margin:0;">
                                    <button type="submit"
                                            class="action-edit">
                                        Mark Read
                                    </button>
                                </form>
                            </role-access>
                        }
                        else
                        {
                            <span>-</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
