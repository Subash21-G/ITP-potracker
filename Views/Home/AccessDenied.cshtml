@using Microsoft.AspNetCore.Http

@{
    ViewData["Title"] = "Access Denied";
    var role = Context.Session.GetString("Role") ?? "Unknown";
}

<div class="panel">
    <div class="empty-state">
        <div aria-hidden="true" style="font-size:3rem;">🔒</div>
        <h3>Access denied</h3>
        <p>
            Your <strong>@role</strong> role does not have permission to open
            this page or perform this action.
        </p>
        <a href="/app/dashboard"
           class="btn btn-primary">
            Return to Dashboard
        </a>
    </div>
</div>
