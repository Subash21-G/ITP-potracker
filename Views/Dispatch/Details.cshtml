@model POTracker.Models.Material

@{
    ViewData["Title"] = "Dispatch Details";
}

<div class="container-fluid mt-4">

    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h2 class="fw-bold">Dispatch Details</h2>
            <p class="text-muted mb-0">
                View dispatch history and manage dispatch records for this material.
            </p>
        </div>

        <div>
            <a asp-action="Index"
               asp-controller="Dispatch"
               class="btn btn-secondary">
                Back
            </a>

            @if (Model.PendingQty > 0)
            {
                <a asp-action="Create"
                   asp-controller="Dispatch"
                   asp-route-materialId="@Model.Id"
                   class="btn btn-primary">
                    Add Dispatch
                </a>
            }
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    <!-- MATERIAL SUMMARY -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-dark text-white">
            Material Summary
        </div>

        <div class="card-body">
            <div class="row g-3">

                <div class="col-md-3">
                    <label class="text-muted">PO Number</label>
                    <div class="fw-bold">
                        @(Model.PurchaseOrder?.PONumber ?? "-")
                    </div>
                </div>

                <div class="col-md-3">
                    <label class="text-muted">Purchaser</label>
                    <div class="fw-bold">
                        @(Model.PurchaseOrder?.Purchaser?.PurchaserName ?? "-")
                    </div>
                </div>

                <div class="col-md-3">
                    <label class="text-muted">Line Item</label>
                    <div class="fw-bold">
                        @(Model.LineItem ?? "-")
                    </div>
                </div>

                <div class="col-md-3">
                    <label class="text-muted">Material No</label>
                    <div class="fw-bold">
                        @Model.MaterialNo
                    </div>
                </div>

                <div class="col-md-6">
                    <label class="text-muted">Description</label>
                    <div class="fw-bold">
                        @(Model.ShortDescription ?? Model.BriefDescription ?? "-")
                    </div>
                </div>

                <div class="col-md-2">
                    <label class="text-muted">PO Qty</label>
                    <div class="fw-bold">
                        @Model.Qty @Model.Unit
                    </div>
                </div>

                <div class="col-md-2">
                    <label class="text-muted">Dispatch Qty</label>
                    <div class="fw-bold text-success">
                        @Model.DispatchQty @Model.Unit
                    </div>
                </div>

                <div class="col-md-2">
                    <label class="text-muted">Pending Qty</label>
                    <div class="fw-bold text-danger">
                        @Model.PendingQty @Model.Unit
                    </div>
                </div>

                <div class="col-md-3">
                    <label class="text-muted">Delivery Date</label>
                    <div class="fw-bold">
                        @(Model.DeliveryDate?.ToString("dd-MM-yyyy") ?? "-")
                    </div>
                </div>

                <div class="col-md-3">
                    <label class="text-muted">Dispatch Status</label>
                    <div>
                        @if (Model.DispatchStatus == "Dispatched")
                        {
                            <span class="badge bg-success">Dispatched</span>
                        }
                        else if (Model.DispatchStatus == "Partial")
                        {
                            <span class="badge bg-warning text-dark">Partial</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Pending</span>
                        }
                    </div>
                </div>

            </div>
        </div>
    </div>

    <!-- DISPATCH HISTORY -->
    <div class="card shadow-sm border-0">
        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
            <span>Dispatch History</span>

            <span>
                Total Records:
                @(Model.Dispatches?.Count ?? 0)
            </span>
        </div>

        <div class="card-body">

            @if (Model.Dispatches == null || !Model.Dispatches.Any())
            {
                <div class="alert alert-info mb-0">
                    No dispatch records found for this material.
                </div>
            }
            else
            {
                <form asp-action="BulkDelete"
                      asp-controller="Dispatch"
                      method="post"
                      id="dispatchBulkDeleteForm"
                      class="d-flex justify-content-between align-items-center gap-2 flex-wrap mb-3 p-3 border rounded bg-light">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="materialId" value="@Model.Id" />

                    <div>
                        <strong><span id="selectedDispatchCount">0</span> selected</strong>
                        <span class="text-muted ms-2">Maximum 200 dispatch records</span>
                    </div>

                    <div class="d-flex gap-2 flex-wrap">
                        <button type="button" class="btn btn-outline-secondary btn-sm" id="selectAllDispatches">Select All</button>
                        <button type="button" class="btn btn-outline-secondary btn-sm" id="clearDispatchSelection">Clear</button>
                        <button type="submit" class="btn btn-danger btn-sm" id="deleteSelectedDispatches" disabled>Delete Selected</button>
                    </div>
                </form>

                <div class="table-responsive">
                    <table class="table table-bordered table-hover align-middle">
                        <thead class="table-light">
                            <tr>
                                <th style="width:50px;">
                                    <input type="checkbox" id="dispatchHeaderCheckbox" aria-label="Select all dispatch records" />
                                </th>
                                <th style="width:70px;">#</th>
                                <th>Dispatch No</th>
                                <th>Dispatch Date</th>
                                <th class="text-end">Dispatch Qty</th>
                                <th>Remarks</th>
                                <th>File</th>
                                <th style="width:220px;">Action</th>
                            </tr>
                        </thead>

                        <tbody>
                            @{
                                int index = 1;
                            }

                            @foreach (var dispatch in Model.Dispatches.OrderByDescending(x => x.DispatchDate))
                            {
                                <tr>
                                    <td>
                                        <input type="checkbox"
                                               class="dispatch-row-checkbox"
                                               name="selectedIds"
                                               value="@dispatch.Id"
                                               form="dispatchBulkDeleteForm"
                                               aria-label="Select dispatch @dispatch.DispatchNo" />
                                    </td>
                                    <td>@index</td>

                                    <td class="fw-bold">
                                        @dispatch.DispatchNo
                                    </td>

                                    <td>
                                        @dispatch.DispatchDate.ToString("dd-MM-yyyy")
                                    </td>

                                    <td class="text-end fw-bold">
                                        @dispatch.DispatchQty @Model.Unit
                                    </td>

                                    <td>
                                        @(dispatch.Remarks ?? "-")
                                    </td>

                                    <td>
                                        @if (!string.IsNullOrWhiteSpace(dispatch.FilePath))
                                        {
                                            <a href="@dispatch.FilePath"
                                               target="_blank"
                                               class="btn btn-sm btn-outline-primary">
                                                View File
                                            </a>
                                        }
                                        else
                                        {
                                            <span class="text-muted">No file</span>
                                        }
                                    </td>

                                    <td>
                                        <form asp-action="Delete"
                                              asp-controller="Dispatch"
                                              asp-route-id="@dispatch.Id"
                                              method="post"
                                              style="display:inline;"
                                              onsubmit="return confirm('Are you sure you want to delete this dispatch record? This will restore pending quantity.');">
                                            @Html.AntiForgeryToken()

                                            <button type="submit" class="btn btn-sm btn-danger">
                                                Delete
                                            </button>
                                        </form>
                                    </td>
                                </tr>

                                index++;
                            }
                        </tbody>

                        <tfoot class="table-light">
                            <tr>
                                <th colspan="4" class="text-end">
                                    Total Dispatched
                                </th>
                                <th class="text-end text-success">
                                    @Model.DispatchQty @Model.Unit
                                </th>
                                <th colspan="3"></th>
                            </tr>

                            <tr>
                                <th colspan="4" class="text-end">
                                    Pending Dispatch
                                </th>
                                <th class="text-end text-danger">
                                    @Model.PendingQty @Model.Unit
                                </th>
                                <th colspan="3"></th>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            }

        </div>
    </div>

</div>

@section Scripts {
    <script>
        (() => {
            "use strict";
            const checks = Array.from(document.querySelectorAll(".dispatch-row-checkbox"));
            const header = document.getElementById("dispatchHeaderCheckbox");
            const count = document.getElementById("selectedDispatchCount");
            const deleteButton = document.getElementById("deleteSelectedDispatches");
            const form = document.getElementById("dispatchBulkDeleteForm");
            const maximumSelection = 200;

            function refresh() {
                const selected = checks.filter(x => x.checked).length;
                if (count) count.textContent = selected;
                if (deleteButton) deleteButton.disabled = selected === 0;
                if (header) {
                    header.checked = checks.length > 0 && selected === checks.length;
                    header.indeterminate = selected > 0 && selected < checks.length;
                }
            }

            function selectFirstTwoHundred() {
                checks.forEach((checkbox, index) => checkbox.checked = index < maximumSelection);
                if (checks.length > maximumSelection) {
                    window.alert("Only the first 200 dispatch records were selected.");
                }
                refresh();
            }

            checks.forEach(checkbox => checkbox.addEventListener("change", () => {
                if (checks.filter(x => x.checked).length > maximumSelection) {
                    checkbox.checked = false;
                    window.alert("You can select a maximum of 200 dispatch records.");
                }
                refresh();
            }));

            header?.addEventListener("change", () => {
                if (header.checked) selectFirstTwoHundred();
                else { checks.forEach(x => x.checked = false); refresh(); }
            });

            document.getElementById("selectAllDispatches")?.addEventListener("click", selectFirstTwoHundred);
            document.getElementById("clearDispatchSelection")?.addEventListener("click", () => {
                checks.forEach(x => x.checked = false); refresh();
            });

            form?.addEventListener("submit", event => {
                const selected = checks.filter(x => x.checked).length;
                if (selected === 0 || selected > maximumSelection) {
                    event.preventDefault();
                    window.alert("Select between 1 and 200 dispatch records.");
                    return;
                }
                if (!window.confirm(`Delete ${selected} selected dispatch record(s)? Their quantities will be restored to pending dispatch.`)) {
                    event.preventDefault();
                    return;
                }
                if (deleteButton) {
                    deleteButton.disabled = true;
                    deleteButton.textContent = "Deleting...";
                }
            });

            refresh();
        })();
    </script>
}
