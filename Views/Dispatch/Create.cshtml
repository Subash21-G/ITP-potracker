@model POTracker.Models.Dispatch

@{
    ViewData["Title"] = "Add Dispatch";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var material =
        ViewBag.Material as POTracker.Models.Material;

    decimal poQty =
        material?.Qty ?? 0;

    decimal invoiceQty =
        material?.InvoiceQty ?? 0;

    decimal alreadyDispatchedQty =
        material?.DispatchQty ?? 0;

    decimal pendingQty =
        Math.Max(
            0,
            material?.PendingQty ?? 0);

    var purchaseOrder =
        material?.PurchaseOrder;

    var poDate =
        purchaseOrder?.PODate
        ?? material?.PODate;

    var receivedDate =
        purchaseOrder?.ReceivedDate
        ?? material?.ReceivingDate;

    string handler =
        purchaseOrder?.BuyerContactPerson
        ?? "";

    string description =
        !string.IsNullOrWhiteSpace(
            material?.ShortDescription)
            ? material!.ShortDescription!
            : material?.BriefDescription
              ?? "-";

    string dispatchStatus =
        string.IsNullOrWhiteSpace(
            material?.DispatchStatus)
            ? "Pending"
            : material!.DispatchStatus!;

    string pendingValue =
        pendingQty.ToString(
            System.Globalization.CultureInfo.InvariantCulture);
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/dispatch-create-premium.css"
          asp-append-version="true" />
}

<div class="dsc-page">

    <!-- =========================================================
         PAGE HEADER
    ========================================================== -->

    <section class="dsc-header">

        <div>
            <span class="dsc-kicker">
                Manual dispatch entry
            </span>

            <h1>Add Dispatch</h1>

            <p>
                Add a manual dispatch quantity for the selected
                PO material without exceeding its pending quantity.
            </p>
        </div>

        <div class="dsc-header-actions">

            <a asp-controller="Dispatch"
               asp-action="Index"
               class="dsc-btn dsc-btn-light">
                Back to Dispatch
            </a>

            @if (material != null)
            {
                <a asp-controller="Material"
                   asp-action="Details"
                   asp-route-id="@material.Id"
                   class="dsc-btn dsc-btn-light">
                    Material Details
                </a>
            }
        </div>
    </section>

    <!-- =========================================================
         MESSAGES
    ========================================================== -->
    @if (TempData["Success"] != null)
    {
        <div class="dsc-alert dsc-alert-success">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="dsc-alert dsc-alert-danger">
            @TempData["Error"]
        </div>
    }

    @if (material == null)
    {
        <section class="dsc-card">
            <div class="dsc-empty-state">

                <div class="dsc-empty-icon">
                    !
                </div>

                <h2>Material details not found</h2>

                <p>
                    The selected material is unavailable or
                    the material reference is invalid.
                </p>

                <a asp-controller="Dispatch"
                   asp-action="Index"
                   class="dsc-btn dsc-btn-primary">
                    Return to Dispatch
                </a>
            </div>
        </section>
    }
    else
    {
        <!-- =====================================================
             SUMMARY CARDS
        ====================================================== -->

        <section class="dsc-summary-grid">

            <article class="dsc-summary-card dsc-summary-violet">
                <span>PO No</span>

                <strong title="@purchaseOrder?.PONumber">
                    @(purchaseOrder?.PONumber ?? "-")
                </strong>

                <small>Purchase order reference</small>
            </article>

            <article class="dsc-summary-card dsc-summary-blue">
                <span>Line Item</span>

                <strong>
                    @(string.IsNullOrWhiteSpace(material.LineItem)
                        ? "-"
                        : material.LineItem)
                </strong>

                <small>PO material line</small>
            </article>

            <article class="dsc-summary-card dsc-summary-teal">
                <span>Material No</span>

                <strong title="@material.MaterialNo">
                    @(material.MaterialNo ?? "-")
                </strong>

                <small>Selected material reference</small>
            </article>

            <article class="dsc-summary-card dsc-summary-dark">
                <span>PO Qty</span>

                <strong>
                    @poQty.ToString("0.##")
                </strong>

                <small>Total ordered quantity</small>
            </article>

            <article class="dsc-summary-card dsc-summary-cyan">
                <span>Invoice Qty</span>

                <strong>
                    @invoiceQty.ToString("0.##")
                </strong>

                <small>Quantity already invoiced</small>
            </article>

            <article class="dsc-summary-card dsc-summary-green">
                <span>Already Dispatched</span>

                <strong>
                    @alreadyDispatchedQty.ToString("0.##")
                </strong>

                <small>Quantity dispatched earlier</small>
            </article>

            <article class="dsc-summary-card dsc-summary-amber">
                <span>Pending Qty</span>

                <strong id="summaryPendingQty">
                    @pendingQty.ToString("0.##")
                </strong>

                <small>Maximum manual dispatch allowed</small>
            </article>

            <article class="dsc-summary-card dsc-summary-rose">
                <span>After This Dispatch</span>

                <strong id="summaryRemainingQty">
                    @pendingQty.ToString("0.##")
                </strong>

                <small>Live remaining quantity</small>
            </article>
        </section>

        <!-- =====================================================
             MATERIAL INFO + FORM
        ====================================================== -->

        <section class="dsc-main-grid">

            <div class="dsc-card">

                <div class="dsc-section-head">

                    <div>
                        <span class="dsc-kicker">
                            Selected material
                        </span>

                        <h2>Material Summary</h2>

                        <p>
                            Review the PO and material information
                            before creating a dispatch entry.
                        </p>
                    </div>

                    <span class="dsc-status dsc-status-info">
                        @dispatchStatus
                    </span>
                </div>

                <div class="dsc-details-grid">

                    <div class="dsc-detail-item">
                        <span>Handler / Person</span>

                        <strong>
                            @(string.IsNullOrWhiteSpace(handler)
                                ? "Not assigned"
                                : handler)
                        </strong>
                    </div>

                    <div class="dsc-detail-item">
                        <span>Description</span>

                        <strong title="@description">
                            @description
                        </strong>
                    </div>

                    <div class="dsc-detail-item">
                        <span>PO Date</span>

                        <strong>
                            @(poDate?.ToString("dd-MMM-yyyy") ?? "Not set")
                        </strong>
                    </div>

                    <div class="dsc-detail-item">
                        <span>PO Received Date</span>

                        <strong>
                            @(receivedDate?.ToString("dd-MMM-yyyy") ?? "Not set")
                        </strong>
                    </div>

                    <div class="dsc-detail-item">
                        <span>Delivery Date</span>

                        <strong>
                            @(material.DeliveryDate?.ToString("dd-MMM-yyyy")
                              ?? "Not set")
                        </strong>
                    </div>

                    <div class="dsc-detail-item">
                        <span>Unit</span>

                        <strong>
                            @(string.IsNullOrWhiteSpace(material.Unit)
                                ? "-"
                                : material.Unit)
                        </strong>
                    </div>

                    <div class="dsc-detail-item">
                        <span>HSN/SAC</span>

                        <strong>
                            @(string.IsNullOrWhiteSpace(material.HsnSacCode)
                                ? "-"
                                : material.HsnSacCode)
                        </strong>
                    </div>

                    <div class="dsc-detail-item">
                        <span>Drawing No</span>

                        <strong>
                            @(string.IsNullOrWhiteSpace(material.DrawingNo)
                                ? "-"
                                : material.DrawingNo)
                        </strong>
                    </div>
                </div>

                <div class="dsc-progress-card">

                    <div class="dsc-progress-row">

                        <div class="dsc-progress-label">
                            <span>PO Quantity</span>
                            <strong>@poQty.ToString("0.##")</strong>
                        </div>

                        <div class="dsc-progress-track">
                            <i class="dsc-progress-violet"
                               style="width:100%">
                            </i>
                        </div>
                    </div>

                    <div class="dsc-progress-row">

                        <div class="dsc-progress-label">
                            <span>Invoice Quantity</span>
                            <strong>@invoiceQty.ToString("0.##")</strong>
                        </div>

                        <div class="dsc-progress-track">
                            <i class="dsc-progress-blue"
                               style="width:@GetPercent(invoiceQty, poQty)%">
                            </i>
                        </div>
                    </div>

                    <div class="dsc-progress-row">

                        <div class="dsc-progress-label">
                            <span>Already Dispatched</span>
                            <strong>@alreadyDispatchedQty.ToString("0.##")</strong>
                        </div>

                        <div class="dsc-progress-track">
                            <i class="dsc-progress-green"
                               style="width:@GetPercent(alreadyDispatchedQty, poQty)%">
                            </i>
                        </div>
                    </div>

                    <div class="dsc-progress-row">

                        <div class="dsc-progress-label">
                            <span>Pending Quantity</span>
                            <strong>@pendingQty.ToString("0.##")</strong>
                        </div>

                        <div class="dsc-progress-track">
                            <i class="dsc-progress-amber"
                               style="width:@GetPercent(pendingQty, poQty)%">
                            </i>
                        </div>
                    </div>
                </div>
            </div>

            <div class="dsc-card">

                <div class="dsc-section-head">

                    <div>
                        <span class="dsc-kicker">
                            Dispatch information
                        </span>

                        <h2>Dispatch Entry</h2>

                        <p>
                            Enter the dispatch reference, date,
                            quantity and supporting document.
                        </p>
                    </div>
                </div>

                @if (pendingQty <= 0)
                {
                    <div class="dsc-blocked-state">

                        <div class="dsc-blocked-icon">
                            ✓
                        </div>

                        <h3>No pending quantity</h3>

                        <p>
                            This material has no remaining quantity
                            available for manual dispatch.
                        </p>

                        <a asp-controller="Dispatch"
                           asp-action="Index"
                           class="dsc-btn dsc-btn-light">
                            Back to Dispatch
                        </a>
                    </div>
                }
                else
                {
                    <form asp-action="Create"
                          asp-controller="Dispatch"
                          method="post"
                          enctype="multipart/form-data"
                          id="dispatchCreateForm"
                          class="dsc-form"
                          data-pending-qty="@pendingValue">

                        @Html.AntiForgeryToken()

                        <input type="hidden"
                               asp-for="MaterialId" />

                        <div asp-validation-summary="ModelOnly"
                             class="dsc-validation-summary">
                        </div>

                        <div class="dsc-form-grid">

                            <div class="dsc-form-field dsc-field-full">
                                <label asp-for="DispatchNo">
                                    Dispatch No / Reference
                                </label>

                                <input asp-for="DispatchNo"
                                       class="dsc-input"
                                       placeholder="Enter dispatch or DC number"
                                       autocomplete="off" />

                                <span asp-validation-for="DispatchNo"
                                      class="dsc-field-error">
                                </span>
                            </div>

                            <div class="dsc-form-field">
                                <label asp-for="DispatchDate">
                                    Dispatch Date
                                </label>

                                <input asp-for="DispatchDate"
                                       type="date"
                                       class="dsc-input" />

                                <span asp-validation-for="DispatchDate"
                                      class="dsc-field-error">
                                </span>
                            </div>

                            <div class="dsc-form-field">
                                <label asp-for="DispatchQty">
                                    Dispatch Quantity
                                </label>

                                <input asp-for="DispatchQty"
                                       type="number"
                                       class="dsc-input"
                                       id="dispatchQtyInput"
                                       step="0.01"
                                       min="0.01"
                                       max="@pendingValue"
                                       inputmode="decimal"
                                       placeholder="Enter quantity" />

                                <span asp-validation-for="DispatchQty"
                                      class="dsc-field-error">
                                </span>
                            </div>

                            <div class="dsc-quantity-preview dsc-field-full">

                                <div>
                                    <span>Maximum Allowed</span>
                                    <strong>
                                        @pendingQty.ToString("0.##")
                                    </strong>
                                </div>

                                <div>
                                    <span>Entered Qty</span>
                                    <strong id="enteredDispatchQty">
                                        0
                                    </strong>
                                </div>

                                <div>
                                    <span>Remaining Qty</span>
                                    <strong id="remainingDispatchQty">
                                        @pendingQty.ToString("0.##")
                                    </strong>
                                </div>
                            </div>

                            <div class="dsc-live-message dsc-field-full"
                                 id="dispatchQtyMessage"
                                 hidden>
                            </div>

                            <div class="dsc-form-field dsc-field-full">
                                <label asp-for="Remarks">
                                    Remarks
                                </label>

                                <textarea asp-for="Remarks"
                                          class="dsc-input dsc-textarea"
                                          rows="4"
                                          placeholder="Enter remarks, vehicle details or delivery notes"></textarea>

                                <span asp-validation-for="Remarks"
                                      class="dsc-field-error">
                                </span>
                            </div>

                            <div class="dsc-form-field dsc-field-full">
                                <label for="dispatchFile">
                                    Dispatch Document
                                </label>

                                <div class="dsc-file-field">

                                    <input type="file"
                                           name="dispatchFile"
                                           id="dispatchFile"
                                           accept=".pdf,.jpg,.jpeg,.png,.xlsx,.xls,.doc,.docx" />

                                    <div class="dsc-file-placeholder"
                                         id="dispatchFilePlaceholder">

                                        <strong>
                                            Choose dispatch document
                                        </strong>

                                        <span>
                                            PDF, image, Excel or Word file
                                        </span>
                                    </div>
                                </div>

                                <div class="dsc-file-preview"
                                     id="dispatchFilePreview"
                                     hidden>

                                    <div class="dsc-file-icon">
                                        F
                                    </div>

                                    <div>
                                        <strong id="dispatchFileName">
                                            File selected
                                        </strong>

                                        <span id="dispatchFileMeta">
                                            Supporting dispatch document
                                        </span>
                                    </div>

                                    <button type="button"
                                            id="removeDispatchFile"
                                            class="dsc-remove-file">
                                        Remove
                                    </button>
                                </div>

                                <small class="dsc-help-text">
                                    Optional: Upload DC copy, invoice copy,
                                    LR copy or another dispatch document.
                                </small>
                            </div>
                        </div>

                        <div class="dsc-form-actions">

                            <a asp-controller="Dispatch"
                               asp-action="Index"
                               class="dsc-btn dsc-btn-light">
                                Cancel
                            </a>

                            <button type="submit"
                                    class="dsc-btn dsc-btn-primary"
                                    id="saveDispatchButton">
                                Save Dispatch
                            </button>
                        </div>

                        <div class="dsc-saving-state"
                             id="dispatchSavingState"
                             hidden>

                            <div class="dsc-saving-head">
                                <span>
                                    Saving dispatch entry...
                                </span>

                                <strong>
                                    Please wait
                                </strong>
                            </div>

                            <div class="dsc-saving-track">
                                <i></i>
                            </div>
                        </div>
                    </form>
                }
            </div>
        </section>

        <!-- =====================================================
             RULES
        ====================================================== -->

        <section class="dsc-rule-grid">

            <article class="dsc-rule dsc-rule-info">
                <strong>Pending quantity limit</strong>

                <p>
                    Dispatch quantity cannot be greater
                    than the current pending quantity.
                </p>
            </article>

            <article class="dsc-rule dsc-rule-warning">
                <strong>Invoice import rule</strong>

                <p>
                    Vyapar invoice import already updates
                    dispatch quantity automatically.
                </p>
            </article>

            <article class="dsc-rule dsc-rule-success">
                <strong>Manual dispatch purpose</strong>

                <p>
                    Use manual dispatch only for the remaining
                    quantity that must be recorded separately.
                </p>
            </article>
        </section>
    }
</div>

@functions {
    int GetPercent(decimal value, decimal total)
    {
        if (total <= 0)
        {
            return 0;
        }

        decimal percentage =
            value / total * 100;

        percentage =
            Math.Clamp(
                percentage,
                0,
                100);

        return Convert.ToInt32(
            Math.Round(percentage));
    }
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        (() => {
            "use strict";

            const form =
                document.getElementById(
                    "dispatchCreateForm");

            if (!form) {
                return;
            }

            const quantityInput =
                document.getElementById(
                    "dispatchQtyInput");

            const enteredQuantity =
                document.getElementById(
                    "enteredDispatchQty");

            const remainingQuantity =
                document.getElementById(
                    "remainingDispatchQty");

            const summaryRemaining =
                document.getElementById(
                    "summaryRemainingQty");

            const quantityMessage =
                document.getElementById(
                    "dispatchQtyMessage");

            const saveButton =
                document.getElementById(
                    "saveDispatchButton");

            const savingState =
                document.getElementById(
                    "dispatchSavingState");

            const fileInput =
                document.getElementById(
                    "dispatchFile");

            const filePreview =
                document.getElementById(
                    "dispatchFilePreview");

            const fileName =
                document.getElementById(
                    "dispatchFileName");

            const fileMeta =
                document.getElementById(
                    "dispatchFileMeta");

            const removeFileButton =
                document.getElementById(
                    "removeDispatchFile");

            const pendingQty =
                Number.parseFloat(
                    form.dataset.pendingQty ?? "0");

            const parseNumber = (value) => {
                const parsed =
                    Number.parseFloat(value);

                return Number.isFinite(parsed)
                    ? parsed
                    : 0;
            };

            const formatQty = (value) => {
                return value.toLocaleString(
                    undefined,
                    {
                        minimumFractionDigits: 0,
                        maximumFractionDigits: 2
                    });
            };

            const formatFileSize = (bytes) => {
                if (!Number.isFinite(bytes) ||
                    bytes <= 0) {
                    return "0 KB";
                }

                const units =
                    ["B", "KB", "MB", "GB"];

                const index =
                    Math.min(
                        Math.floor(
                            Math.log(bytes) /
                            Math.log(1024)),
                        units.length - 1);

                const value =
                    bytes /
                    Math.pow(1024, index);

                return `${value.toFixed(
                    index === 0 ? 0 : 2
                )} ${units[index]}`;
            };

            const setMessage = (
                message,
                type) => {

                if (!quantityMessage) {
                    return;
                }

                quantityMessage.textContent =
                    message;

                quantityMessage.className =
                    `dsc-live-message dsc-field-full ${type}`;

                quantityMessage.hidden =
                    !message;
            };

            const validateQuantity = () => {
                const entered =
                    parseNumber(
                        quantityInput?.value);

                const remaining =
                    Math.max(
                        0,
                        pendingQty - entered);

                if (enteredQuantity) {
                    enteredQuantity.textContent =
                        formatQty(entered);
                }

                if (remainingQuantity) {
                    remainingQuantity.textContent =
                        formatQty(remaining);
                }

                if (summaryRemaining) {
                    summaryRemaining.textContent =
                        formatQty(remaining);
                }

                if (entered <= 0) {
                    setMessage(
                        "Enter a dispatch quantity greater than zero.",
                        "dsc-message-warning");

                    return false;
                }

                if (entered > pendingQty) {
                    setMessage(
                        `Dispatch quantity cannot exceed ${formatQty(pendingQty)}.`,
                        "dsc-message-danger");

                    return false;
                }

                if (remaining === 0) {
                    setMessage(
                        "This dispatch will complete the pending quantity.",
                        "dsc-message-success");
                } else {
                    setMessage(
                        `${formatQty(remaining)} quantity will remain pending.`,
                        "dsc-message-info");
                }

                return true;
            };

            quantityInput?.addEventListener(
                "input",
                validateQuantity);

            fileInput?.addEventListener(
                "change",
                () => {
                    const file =
                        fileInput.files?.[0];

                    if (!file) {
                        if (filePreview) {
                            filePreview.hidden = true;
                        }

                        return;
                    }

                    if (fileName) {
                        fileName.textContent =
                            file.name;
                    }

                    if (fileMeta) {
                        fileMeta.textContent =
                            formatFileSize(file.size);
                    }

                    if (filePreview) {
                        filePreview.hidden = false;
                    }
                });

            removeFileButton?.addEventListener(
                "click",
                () => {
                    if (fileInput) {
                        fileInput.value = "";
                    }

                    if (filePreview) {
                        filePreview.hidden = true;
                    }
                });

            form.addEventListener(
                "submit",
                (event) => {
                    if (!validateQuantity()) {
                        event.preventDefault();
                        quantityInput?.focus();
                        return;
                    }

                    const entered =
                        parseNumber(
                            quantityInput?.value);

                    const confirmed =
                        window.confirm(
                            `Save dispatch quantity ${formatQty(entered)}?`);

                    if (!confirmed) {
                        event.preventDefault();
                        return;
                    }

                    if (saveButton) {
                        saveButton.disabled = true;
                        saveButton.textContent =
                            "Saving...";
                    }

                    if (savingState) {
                        savingState.hidden = false;
                    }

                    form
                        .querySelectorAll(
                            "input, textarea, button")
                        .forEach((element) => {
                            if (element !== saveButton) {
                                element.setAttribute(
                                    "readonly",
                                    "readonly");
                            }
                        });
                });

            validateQuantity();
        })();
    </script>
}
