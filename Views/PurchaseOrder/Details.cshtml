@model POTracker.Models.PurchaseOrder

@{
    ViewData["Title"] = "PO Details";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var materials =
        ViewBag.Materials as List<POTracker.Models.Material>
        ?? Model.Materials?.ToList()
        ?? new List<POTracker.Models.Material>();

    bool IsCompleted(POTracker.Models.Material item)
    {
        var invoiceCompleted =
            item.BalanceQty <= 0 ||
            string.Equals(
                item.InvoiceStatus,
                "Fully Invoiced",
                StringComparison.OrdinalIgnoreCase);

        var dispatchCompleted =
            item.PendingQty <= 0 ||
            string.Equals(
                item.DispatchStatus,
                "Dispatched",
                StringComparison.OrdinalIgnoreCase) ||
            string.Equals(
                item.DispatchStatus,
                "Completed",
                StringComparison.OrdinalIgnoreCase);

        return invoiceCompleted && dispatchCompleted;
    }

    string StatusClass(string? value)
    {
        var status =
            value?.Trim().ToLowerInvariant() ?? "";

        if (status.Contains("complete") ||
            status.Contains("fully") ||
            status == "dispatched")
        {
            return "pod-status-success";
        }

        if (status.Contains("running") ||
            status.Contains("progress") ||
            status.Contains("partial"))
        {
            return "pod-status-info";
        }

        if (status.Contains("overdue") ||
            status.Contains("reject") ||
            status.Contains("cancel"))
        {
            return "pod-status-danger";
        }

        if (status.Contains("pending") ||
            status.Contains("not invoiced") ||
            string.IsNullOrWhiteSpace(status))
        {
            return "pod-status-warning";
        }

        return "pod-status-neutral";
    }

    var totalMaterials =
        materials.Count;

    var completedMaterials =
        materials.Count(IsCompleted);

    var pendingMaterials =
        totalMaterials - completedMaterials;

    var overdueMaterials =
        materials.Count(x =>
            x.DeliveryDate.HasValue &&
            x.DeliveryDate.Value.Date < DateTime.Today &&
            x.PendingQty > 0);

    var totalPOQuantity =
        materials.Sum(x => x.Qty);

    var totalInvoiceBalance =
        materials.Sum(x =>
            Math.Max(0, x.BalanceQty));

    var totalDispatchBalance =
        materials.Sum(x =>
            Math.Max(0, x.PendingQty));

    var handler =
        Model.BuyerContactPerson;

    var poDate =
        Model.PODate;

    var poReceivedDate =
        Model.ReceivedDate;
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/purchase-order-details-premium.css"
          asp-append-version="true" />
}

<div class="pod-page">

    <!-- =========================================================
         PAGE HEADER
    ========================================================== -->

    <section class="pod-header">

        <div>
            <span class="pod-kicker">
                Purchase order management
            </span>

            <h1>Purchase Order Details</h1>

            <p>
                Complete purchase order, material,
                invoice and dispatch information.
            </p>
        </div>

        <div class="pod-header-actions">

            <a asp-controller="PurchaseOrder"
               asp-action="Index"
               class="pod-btn pod-btn-light">
                Back
            </a>

            <role-access roles="Admin,Production">
                <a asp-controller="PurchaseOrder"
                   asp-action="Edit"
                   asp-route-id="@Model.Id"
                   class="pod-btn pod-btn-primary">
                    Edit Purchase Order
                </a>
            </role-access>
        </div>
    </section>

    <!-- =========================================================
         PO INFORMATION
    ========================================================== -->

    <section class="pod-card">

        <div class="pod-section-head">

            <div>
                <span class="pod-kicker">
                    PO information
                </span>

                <h2>@Model.PONumber</h2>
            </div>

            @if (!string.IsNullOrWhiteSpace(Model.PdfFilePath))
            {
                <a href="@Model.PdfFilePath"
                   target="_blank"
                   rel="noopener noreferrer"
                   class="pod-pdf-link">
                    View PO PDF
                </a>
            }
        </div>

        <div class="pod-detail-grid">

            <article class="pod-detail-item">
                <span>PO Number</span>

                <strong>
                    @Model.PONumber
                </strong>
            </article>

            @if (!string.IsNullOrWhiteSpace(handler))
            {
                <article class="pod-detail-item">
                    <span>Handler / Person</span>

                    <strong>
                        @handler
                    </strong>
                </article>
            }

            @if (poDate.HasValue)
            {
                <article class="pod-detail-item pod-po-date">
                    <span>PO Date</span>

                    <strong>
                        @poDate.Value.ToString("dd-MMM-yyyy")
                    </strong>
                </article>
            }

            @if (poReceivedDate.HasValue)
            {
                <article class="pod-detail-item pod-received-date">
                    <span>PO Received Date</span>

                    <strong>
                        @poReceivedDate.Value.ToString("dd-MMM-yyyy")
                    </strong>
                </article>
            }

            <article class="pod-detail-item">
                <span>Created Date</span>

                <strong>
                    @Model.CreatedDate.ToString("dd-MMM-yyyy")
                </strong>
            </article>
        </div>
    </section>

    <!-- =========================================================
         SUMMARY METRICS
         Unique pod-* classes prevent global CSS conflicts.
    ========================================================== -->

    <section class="pod-summary-grid">

        <article class="pod-summary-card pod-summary-violet">
            <span>Total Materials</span>

            <strong>
                @totalMaterials
            </strong>

            <small>
                Linked material lines
            </small>
        </article>

        <article class="pod-summary-card pod-summary-green">
            <span>Completed Materials</span>

            <strong>
                @completedMaterials
            </strong>

            <small>
                Invoice and dispatch completed
            </small>
        </article>

        <article class="pod-summary-card pod-summary-amber">
            <span>Pending Materials</span>

            <strong>
                @pendingMaterials
            </strong>

            <small>
                Materials requiring action
            </small>
        </article>

        <article class="pod-summary-card pod-summary-red">
            <span>Overdue Materials</span>

            <strong>
                @overdueMaterials
            </strong>

            <small>
                Delivery date already passed
            </small>
        </article>

        <article class="pod-summary-card pod-summary-blue">
            <span>Total PO Quantity</span>

            <strong>
                @totalPOQuantity.ToString("N2")
            </strong>

            <small>
                Total ordered quantity
            </small>
        </article>

        <article class="pod-summary-card pod-summary-rose">
            <span>Invoice Balance</span>

            <strong>
                @totalInvoiceBalance.ToString("N2")
            </strong>

            <small>
                Quantity pending invoice
            </small>
        </article>

        <article class="pod-summary-card pod-summary-teal">
            <span>Dispatch Balance</span>

            <strong>
                @totalDispatchBalance.ToString("N2")
            </strong>

            <small>
                Quantity pending dispatch
            </small>
        </article>
    </section>

    <!-- =========================================================
         MATERIAL TABLE
    ========================================================== -->

    <section class="pod-card">

        <div class="pod-section-head">

            <div>
                <span class="pod-kicker">
                    Linked materials
                </span>

                <h3>Material List</h3>

                <p>
                    @totalMaterials material record(s)
                    linked to this purchase order.
                </p>
            </div>

            <role-access roles="Admin,Production">
                <a asp-controller="Material"
                   asp-action="Create"
                   asp-route-purchaseOrderId="@Model.Id"
                   class="pod-btn pod-btn-primary">
                    + Add Material
                </a>
            </role-access>
        </div>

        @if (materials.Count == 0)
        {
            <div class="pod-empty-state">

                <div class="pod-empty-icon">
                    M
                </div>

                <h3>No materials linked</h3>

                <p>
                    No material records are currently linked
                    to this purchase order.
                </p>

                <role-access roles="Admin,Production">
                    <a asp-controller="Material"
                       asp-action="Create"
                       asp-route-purchaseOrderId="@Model.Id"
                       class="pod-btn pod-btn-primary">
                        Add First Material
                    </a>
                </role-access>
            </div>
        }
        else
        {
            <div class="pod-table-wrap">

                <table class="pod-table">

                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Line Item</th>
                            <th>Material No</th>
                            <th>Description</th>
                            <th>PO Qty</th>
                            <th>Invoice Balance</th>
                            <th>Dispatch Balance</th>
                            <th>Delivery Date</th>
                            <th>Process</th>
                            <th>Invoice</th>
                            <th>Dispatch</th>
                            <th>Action</th>
                        </tr>
                    </thead>

                    <tbody>

                        @{
                            var serialNumber = 1;
                        }

                        @foreach (var item in materials)
                        {
                            var description =
                                !string.IsNullOrWhiteSpace(
                                    item.ShortDescription)
                                    ? item.ShortDescription
                                    : item.BriefDescription;

                            var isOverdue =
                                item.DeliveryDate.HasValue &&
                                item.DeliveryDate.Value.Date <
                                DateTime.Today &&
                                item.PendingQty > 0;

                            <tr class="@(isOverdue ? "pod-overdue-row" : "")">

                                <td>
                                    @serialNumber
                                </td>

                                <td>
                                    <span class="pod-line-item">
                                        @(string.IsNullOrWhiteSpace(item.LineItem)
                                            ? "-"
                                            : item.LineItem)
                                    </span>
                                </td>

                                <td>
                                    <a asp-controller="Material"
                                       asp-action="Details"
                                       asp-route-id="@item.Id"
                                       class="pod-material-number">
                                        @item.MaterialNo
                                    </a>

                                    @if (!string.IsNullOrWhiteSpace(item.DrawingNo))
                                    {
                                        <small class="pod-drawing">
                                            Drg: @item.DrawingNo
                                        </small>
                                    }
                                </td>

                                <td>
                                    <span class="pod-description"
                                          title="@description">
                                        @(string.IsNullOrWhiteSpace(description)
                                            ? "-"
                                            : description)
                                    </span>
                                </td>

                                <td>
                                    <strong class="pod-quantity">
                                        @item.Qty.ToString("N2")
                                    </strong>

                                    @if (!string.IsNullOrWhiteSpace(item.Unit))
                                    {
                                        <small class="pod-unit">
                                            @item.Unit
                                        </small>
                                    }
                                </td>

                                <td>
                                    <strong class="pod-quantity pod-quantity-warning">
                                        @Math.Max(0, item.BalanceQty).ToString("N2")
                                    </strong>
                                </td>

                                <td>
                                    <strong class="pod-quantity pod-quantity-danger">
                                        @Math.Max(0, item.PendingQty).ToString("N2")
                                    </strong>
                                </td>

                                <td>
                                    @if (item.DeliveryDate.HasValue)
                                    {
                                        <span class="pod-date @(isOverdue ? "pod-date-overdue" : "")">
                                            @item.DeliveryDate.Value.ToString("dd-MMM-yyyy")
                                        </span>

                                        @if (isOverdue)
                                        {
                                            <small class="pod-overdue-text">
                                                Overdue
                                            </small>
                                        }
                                    }
                                    else
                                    {
                                        <span class="pod-unassigned">
                                            Not set
                                        </span>
                                    }
                                </td>

                                <td>
                                    <span class="pod-status @StatusClass(item.ProcessStatus)">
                                        @(string.IsNullOrWhiteSpace(item.ProcessStatus)
                                            ? "Pending"
                                            : item.ProcessStatus)
                                    </span>
                                </td>

                                <td>
                                    <span class="pod-status @StatusClass(item.InvoiceStatus)">
                                        @(string.IsNullOrWhiteSpace(item.InvoiceStatus)
                                            ? "Not Invoiced"
                                            : item.InvoiceStatus)
                                    </span>
                                </td>

                                <td>
                                    <span class="pod-status @StatusClass(item.DispatchStatus)">
                                        @(string.IsNullOrWhiteSpace(item.DispatchStatus)
                                            ? "Pending"
                                            : item.DispatchStatus)
                                    </span>
                                </td>

                                <td>
                                    <div class="pod-row-actions">

                                        <a asp-controller="Material"
                                           asp-action="Details"
                                           asp-route-id="@item.Id"
                                           class="pod-row-btn pod-row-view">
                                            View
                                        </a>

                                        <role-access roles="Admin,Production">
                                            <a asp-controller="Material"
                                               asp-action="Edit"
                                               asp-route-id="@item.Id"
                                               class="pod-row-btn pod-row-edit">
                                                Edit
                                            </a>

                                            @if (item.PendingQty > 0)
                                            {
                                                <a href="/app/dispatches/@item.Id"
                                                   class="pod-row-btn pod-row-dispatch">
                                                    Dispatch
                                                </a>
                                            }
                                        </role-access>
                                    </div>
                                </td>
                            </tr>

                            serialNumber++;
                        }
                    </tbody>

                    <tfoot>
                        <tr>
                            <th colspan="4"
                                class="pod-text-right">
                                Total
                            </th>

                            <th>
                                @totalPOQuantity.ToString("N2")
                            </th>

                            <th>
                                @totalInvoiceBalance.ToString("N2")
                            </th>

                            <th>
                                @totalDispatchBalance.ToString("N2")
                            </th>

                            <th colspan="5"></th>
                        </tr>
                    </tfoot>
                </table>
            </div>
        }
    </section>
</div>
