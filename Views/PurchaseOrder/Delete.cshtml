@model POTracker.Models.PurchaseOrder

@{
    ViewData["Title"] = "Delete Purchase Order";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var materialCount =
        ViewBag.MaterialCount is int count
            ? count
            : 0;

    var canDelete =
        materialCount == 0;

    var handler =
        string.IsNullOrWhiteSpace(Model.BuyerContactPerson)
            ? "Not assigned"
            : Model.BuyerContactPerson;

    var poDate =
        Model.PODate?.ToString("dd-MMM-yyyy")
        ?? "Not set";

    var receivedDate =
        Model.ReceivedDate?.ToString("dd-MMM-yyyy")
        ?? "Not set";

    var pdfFileName =
        string.IsNullOrWhiteSpace(Model.PdfFilePath)
            ? null
            : System.IO.Path.GetFileName(
                Model.PdfFilePath);
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/purchase-order-delete-premium.css"
          asp-append-version="true" />
}

<div class="podl-page">

    <!-- =========================================================
         PAGE HEADER
    ========================================================== -->

    <section class="podl-header">

        <div>
            <span class="podl-kicker">
                Purchase order management
            </span>

            <h1>Delete Purchase Order</h1>

            <p>
                Review this purchase order carefully before
                permanently removing it from the system.
            </p>
        </div>

        <div class="podl-header-actions">

            <a asp-controller="PurchaseOrder"
               asp-action="Details"
               asp-route-id="@Model.Id"
               class="podl-btn podl-btn-light">
                View Details
            </a>

            <a asp-controller="PurchaseOrder"
               asp-action="Index"
               class="podl-btn podl-btn-light">
                Back
            </a>
        </div>
    </section>

    <!-- =========================================================
         DELETE STATUS
    ========================================================== -->
    @if (canDelete)
    {
        <section class="podl-alert podl-alert-danger">

            <div class="podl-alert-icon">
                !
            </div>

            <div>
                <strong>
                    Permanent deletion warning
                </strong>

                <p>
                    This purchase order has no linked materials
                    and can be deleted. This action cannot be undone.
                </p>
            </div>
        </section>
    }
    else
    {
        <section class="podl-alert podl-alert-warning">

            <div class="podl-alert-icon">
                @materialCount
            </div>

            <div>
                <strong>
                    Delete is currently blocked
                </strong>

                <p>
                    This purchase order has
                    @materialCount linked material record(s).
                    Remove or transfer those materials before
                    deleting the purchase order.
                </p>
            </div>
        </section>
    }

    <!-- =========================================================
         PURCHASE ORDER SUMMARY
    ========================================================== -->

    <section class="podl-card">

        <div class="podl-section-head">

            <div>
                <span class="podl-kicker">
                    Record summary
                </span>

                <h2>@Model.PONumber</h2>

                <p>
                    Confirm that this is the correct purchase
                    order before continuing.
                </p>
            </div>

            <span class="podl-status @(canDelete ? "podl-status-ready" : "podl-status-blocked")">
                @(canDelete
                    ? "Ready to delete"
                    : "Deletion blocked")
            </span>
        </div>

        <div class="podl-detail-grid">

            <article class="podl-detail-item">
                <span>PO Number</span>
                <strong>@Model.PONumber</strong>
            </article>

            <article class="podl-detail-item">
                <span>Handler / Person</span>
                <strong>@handler</strong>
            </article>

            <article class="podl-detail-item">
                <span>PO Date</span>
                <strong>@poDate</strong>
            </article>

            <article class="podl-detail-item podl-received-date">
                <span>PO Received Date</span>
                <strong>@receivedDate</strong>
            </article>

            <article class="podl-detail-item">
                <span>Created Date</span>

                <strong>
                    @Model.CreatedDate.ToString("dd-MMM-yyyy")
                </strong>
            </article>

            <article class="podl-detail-item @(canDelete ? "podl-count-safe" : "podl-count-blocked")">
                <span>Linked Materials</span>
                <strong>@materialCount</strong>
            </article>
        </div>
    </section>

    <!-- =========================================================
         DOCUMENT INFORMATION
    ========================================================== -->
    @if (!string.IsNullOrWhiteSpace(Model.PdfFilePath))
    {
        <section class="podl-card">

            <div class="podl-section-head">

                <div>
                    <span class="podl-kicker">
                        Attached document
                    </span>

                    <h3>Purchase Order PDF</h3>
                </div>
            </div>

            <div class="podl-file-row">

                <div class="podl-file-icon">
                    PDF
                </div>

                <div class="podl-file-info">
                    <strong>
                        @(pdfFileName ?? "Purchase Order PDF")
                    </strong>

                    <span>
                        The document reference will no longer
                        be available after deletion.
                    </span>
                </div>

                <a href="@Model.PdfFilePath"
                   target="_blank"
                   rel="noopener noreferrer"
                   class="podl-file-link">
                    View PDF
                </a>
            </div>
        </section>
    }

    <!-- =========================================================
         LINKED MATERIAL BLOCK
    ========================================================== -->
    @if (!canDelete)
    {
        <section class="podl-card">

            <div class="podl-section-head">

                <div>
                    <span class="podl-kicker">
                        Required action
                    </span>

                    <h3>Resolve Linked Materials</h3>

                    <p>
                        The system prevents accidental deletion
                        of purchase orders that still contain materials.
                    </p>
                </div>
            </div>

            <div class="podl-block-message">

                <strong>
                    @materialCount material record(s) must be handled.
                </strong>

                <p>
                    Open the purchase order details page and review
                    the linked materials. Delete, transfer or unlink
                    them according to your business process.
                </p>

                <a asp-controller="PurchaseOrder"
                   asp-action="Details"
                   asp-route-id="@Model.Id"
                   class="podl-btn podl-btn-primary">
                    Review Linked Materials
                </a>
            </div>
        </section>
    }

    <!-- =========================================================
         DELETE FORM
    ========================================================== -->

    <section class="podl-actions">

        <div class="podl-action-note">

            @if (canDelete)
            {
                <strong>
                    This action is permanent.
                </strong>

                <span>
                    Click Delete Purchase Order only after
                    verifying the record above.
                </span>
            }
            else
            {
                <strong>
                    Deletion is unavailable.
                </strong>

                <span>
                    Linked materials must be cleared first.
                </span>
            }
        </div>

        <div class="podl-action-buttons">

            <a asp-controller="PurchaseOrder"
               asp-action="Index"
               class="podl-btn podl-btn-light">
                Cancel
            </a>

            <form asp-controller="PurchaseOrder"
                  asp-action="Delete"
                  asp-route-id="@Model.Id"
                  method="post"
                  id="deletePurchaseOrderForm"
                  class="podl-delete-form">

                @Html.AntiForgeryToken()

                <input type="hidden"
                       asp-for="Id" />

                <button type="submit"
                        id="deletePurchaseOrderButton"
                        class="podl-btn podl-btn-danger"
                        disabled="@(!canDelete)">
                    Delete Purchase Order
                </button>
            </form>
        </div>
    </section>
</div>

@section Scripts {
    <script>
        (() => {
            "use strict";

            const canDelete =
                @canDelete.ToString().ToLowerInvariant();

            const form =
                document.getElementById(
                    "deletePurchaseOrderForm");

            const button =
                document.getElementById(
                    "deletePurchaseOrderButton");

            if (!canDelete || !form || !button) {
                return;
            }

            form.addEventListener(
                "submit",
                (event) => {
                    const confirmed =
                        window.confirm(
                            "Delete purchase order '@Model.PONumber'? " +
                            "This action cannot be undone.");

                    if (!confirmed) {
                        event.preventDefault();
                        return;
                    }

                    button.disabled = true;
                    button.textContent = "Deleting...";
                });
        })();
    </script>
}
