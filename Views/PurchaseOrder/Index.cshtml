@model POTracker.ViewModels.PurchaseOrderIndexViewModel

@{
    ViewData["Title"] = "Purchase Orders";
    Layout = "~/Views/Shared/_Layout.cshtml";

    string StatusClass(string? value)
    {
        var status = value?.Trim().ToLowerInvariant() ?? "";

        if (status.Contains("complete"))
        {
            return "poi-status-success";
        }

        if (status.Contains("progress") ||
            status.Contains("partial"))
        {
            return "poi-status-info";
        }

        if (status.Contains("overdue") ||
            status.Contains("cancel") ||
            status.Contains("reject"))
        {
            return "poi-status-danger";
        }

        if (status.Contains("open") ||
            status.Contains("pending"))
        {
            return "poi-status-warning";
        }

        return "poi-status-neutral";
    }
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/purchase-order-index-premium.css"
          asp-append-version="true" />

    <style>
        .poi-bulk-bar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 14px;
            padding: 13px 15px;
            margin-bottom: 14px;
            border: 1px solid #fecdd3;
            border-radius: 13px;
            background: #fff7f8;
        }

        .poi-bulk-left,
        .poi-bulk-actions {
            display: flex;
            align-items: center;
            gap: 12px;
            flex-wrap: wrap;
        }

        .poi-select-all-label,
        .poi-row-check-label {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
        }

        .poi-select-checkbox {
            width: 18px;
            height: 18px;
            margin: 0;
            accent-color: #dc2626;
            cursor: pointer;
        }

        .poi-checkbox-column {
            width: 48px;
            min-width: 48px;
            text-align: center !important;
        }

        .poi-selected-count {
            display: inline-flex;
            align-items: center;
            min-height: 30px;
            padding: 5px 10px;
            border: 1px solid #ddd6fe;
            border-radius: 999px;
            background: #f5f3ff;
            color: #5b21b6;
            font-size: 12px;
            font-weight: 900;
        }

        .poi-bulk-help {
            color: #64748b;
            font-size: 12px;
            font-weight: 700;
        }

        .poi-btn-bulk-delete {
            min-height: 39px;
            padding: 9px 14px;
            border: 1px solid #dc2626;
            border-radius: 10px;
            background: #dc2626;
            color: #fff;
            font: inherit;
            font-size: 13px;
            font-weight: 900;
            cursor: pointer;
            transition: .18s ease;
        }

            .poi-btn-bulk-delete:hover:not(:disabled) {
                background: #b91c1c;
                transform: translateY(-1px);
            }

            .poi-btn-bulk-delete:disabled {
                border-color: #cbd5e1;
                background: #e2e8f0;
                color: #94a3b8;
                cursor: not-allowed;
            }

        .poi-row-selected {
            background: #fff7f8 !important;
        }

        .poi-overdue-row.poi-row-selected {
            background: #fff1f2 !important;
        }

        @@media (max-width: 760px) {
            .poi-bulk-bar {
                align-items: flex-start;
                flex-direction: column;
            }

            .poi-bulk-actions,
            .poi-btn-bulk-delete {
                width: 100%;
            }
        }
    </style>
}

<div class="poi-page">

    <section class="poi-hero">
        <div class="poi-hero-copy">
            <span class="poi-kicker">
                Purchase order management
            </span>

            <h2>Purchase Orders</h2>

            <p>
                Track purchase orders by handler, PO date,
                PO received date, material progress,
                invoice balance and dispatch balance.
            </p>
        </div>

        <div class="poi-hero-actions">

            <a asp-controller="PurchaseOrder"
               asp-action="ExportExcel"
               asp-route-search="@Model.Search"
               asp-route-handler="@Model.Handler"
               asp-route-poDateFrom="@(Model.PODateFrom?.ToString("yyyy-MM-dd"))"
               asp-route-poDateTo="@(Model.PODateTo?.ToString("yyyy-MM-dd"))"
               asp-route-poReceivedDateFrom="@(Model.POReceivedDateFrom?.ToString("yyyy-MM-dd"))"
               asp-route-poReceivedDateTo="@(Model.POReceivedDateTo?.ToString("yyyy-MM-dd"))"
               asp-route-status="@Model.Status"
               asp-route-materialStatus="@Model.MaterialStatus"
               class="poi-btn poi-btn-excel">
                Export Filtered Excel
            </a>

            <role-access roles="Admin,Production">
                <a asp-controller="PurchaseOrder"
                   asp-action="Create"
                   class="poi-btn poi-btn-primary">
                    + Add Purchase Order
                </a>
            </role-access>
        </div>
    </section>

    @if (TempData["Success"] != null)
    {
        <div class="poi-alert poi-alert-success">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="poi-alert poi-alert-danger">
            @TempData["Error"]
        </div>
    }

    <section class="poi-summary-grid">

        <article class="poi-summary-card poi-summary-violet">
            <span>Total Purchase Orders</span>

            <strong>
                @Model.Summary.TotalPurchaseOrders
            </strong>

            <small>
                Purchase orders in current result
            </small>
        </article>

        <article class="poi-summary-card poi-summary-amber">
            <span>Open Purchase Orders</span>

            <strong>
                @Model.Summary.OpenPurchaseOrders
            </strong>

            <small>
                Open and in-progress orders
            </small>
        </article>

        <article class="poi-summary-card poi-summary-green">
            <span>Completed Orders</span>

            <strong>
                @Model.Summary.CompletedPurchaseOrders
            </strong>

            <small>
                All linked materials completed
            </small>
        </article>

        <article class="poi-summary-card poi-summary-blue">
            <span>Pending Materials</span>

            <strong>
                @Model.Summary.PurchaseOrdersWithPendingMaterials
            </strong>

            <small>
                Orders with pending materials
            </small>
        </article>

        <article class="poi-summary-card poi-summary-red">
            <span>Overdue Materials</span>

            <strong>
                @Model.Summary.PurchaseOrdersWithOverdueMaterials
            </strong>

            <small>
                Orders requiring urgent attention
            </small>
        </article>

        <article class="poi-summary-card poi-summary-rose">
            <span>Without Handler</span>

            <strong>
                @Model.Summary.PurchaseOrdersWithoutHandler
            </strong>

            <small>
                Orders not assigned to a handler
            </small>
        </article>
    </section>

    <section class="poi-quantity-summary">

        <article>
            <span>Total PO Quantity</span>

            <strong>
                @Model.Summary.TotalPOQuantity.ToString("N2")
            </strong>
        </article>

        <article>
            <span>Invoice Balance</span>

            <strong>
                @Model.Summary.TotalInvoiceBalanceQuantity.ToString("N2")
            </strong>
        </article>

        <article>
            <span>Dispatch Balance</span>

            <strong>
                @Model.Summary.TotalPendingDispatchQuantity.ToString("N2")
            </strong>
        </article>
    </section>

    <section class="poi-filter-card">

        <div class="poi-section-head">
            <div>
                <span class="poi-kicker">
                    Search and filter
                </span>

                <h3>Find purchase orders</h3>
            </div>

            @if (Model.HasActiveFilters)
            {
                <span class="poi-filter-count">
                    @Model.ActiveFilterCount active filter(s)
                </span>
            }
        </div>

        <form asp-controller="PurchaseOrder"
              asp-action="Index"
              method="get"
              class="poi-filter-form">

            <div class="poi-filter-grid">

                <div class="poi-field poi-field-wide">
                    <label for="Search">
                        PO number / Handler
                    </label>

                    <input type="search"
                           id="Search"
                           name="search"
                           value="@Model.Search"
                           placeholder="Search by PO number or handler name..." />
                </div>

                <div class="poi-field">
                    <label for="Handler">
                        Handler / Person
                    </label>

                    <select id="Handler"
                            name="handler">
                        <option value="">
                            All handlers
                        </option>

                        @foreach (var option in Model.Handlers)
                        {
                            if (option.IsSelected)
                            {
                                <option value="@option.Value"
                                        selected>
                                    @option.Text (@option.Count)
                                </option>
                            }
                            else
                            {
                                <option value="@option.Value">
                                    @option.Text (@option.Count)
                                </option>
                            }
                        }
                    </select>
                </div>

                <div class="poi-field">
                    <label for="Status">
                        PO status
                    </label>

                    <select id="Status"
                            name="status">
                        <option value="">
                            All PO statuses
                        </option>

                        @foreach (var option in Model.Statuses)
                        {
                            if (option.IsSelected)
                            {
                                <option value="@option.Value"
                                        selected>
                                    @option.Text (@option.Count)
                                </option>
                            }
                            else
                            {
                                <option value="@option.Value">
                                    @option.Text (@option.Count)
                                </option>
                            }
                        }
                    </select>
                </div>

                <div class="poi-field">
                    <label for="MaterialStatus">
                        Material status
                    </label>

                    <select id="MaterialStatus"
                            name="materialStatus">
                        <option value="">
                            All material statuses
                        </option>

                        @foreach (var option in Model.MaterialStatuses)
                        {
                            if (option.IsSelected)
                            {
                                <option value="@option.Value"
                                        selected>
                                    @option.Text (@option.Count)
                                </option>
                            }
                            else
                            {
                                <option value="@option.Value">
                                    @option.Text (@option.Count)
                                </option>
                            }
                        }
                    </select>
                </div>

                <div class="poi-field">
                    <label for="PODateFrom">
                        PO date from
                    </label>

                    <input type="date"
                           id="PODateFrom"
                           name="poDateFrom"
                           value="@(Model.PODateFrom?.ToString("yyyy-MM-dd"))" />
                </div>

                <div class="poi-field">
                    <label for="PODateTo">
                        PO date to
                    </label>

                    <input type="date"
                           id="PODateTo"
                           name="poDateTo"
                           value="@(Model.PODateTo?.ToString("yyyy-MM-dd"))" />
                </div>

                <div class="poi-field">
                    <label for="POReceivedDateFrom">
                        PO received from
                    </label>

                    <input type="date"
                           id="POReceivedDateFrom"
                           name="poReceivedDateFrom"
                           value="@(Model.POReceivedDateFrom?.ToString("yyyy-MM-dd"))" />
                </div>

                <div class="poi-field">
                    <label for="POReceivedDateTo">
                        PO received to
                    </label>

                    <input type="date"
                           id="POReceivedDateTo"
                           name="poReceivedDateTo"
                           value="@(Model.POReceivedDateTo?.ToString("yyyy-MM-dd"))" />
                </div>

                <div class="poi-field">
                    <label for="PageSize">
                        Rows per page
                    </label>

                    <select id="PageSize"
                            name="pageSize">

                        @foreach (var size in new[] { 10, 25, 50, 100, 200 })
                        {
                            if (Model.PageSize == size)
                            {
                                <option value="@size"
                                        selected>
                                    @size rows
                                </option>
                            }
                            else
                            {
                                <option value="@size">
                                    @size rows
                                </option>
                            }
                        }
                    </select>
                </div>
            </div>

            <div class="poi-filter-actions">

                <button type="submit"
                        class="poi-btn poi-btn-primary">
                    Search Purchase Orders
                </button>

                <a asp-controller="PurchaseOrder"
                   asp-action="Index"
                   class="poi-btn poi-btn-light">
                    Reset Filters
                </a>
            </div>
        </form>
    </section>

    <section class="poi-table-card">

        <div class="poi-table-head">

            <div>
                <span class="poi-kicker">
                    Purchase order records
                </span>

                <h3>Purchase order list</h3>

                <p>
                    Showing @Model.FirstRecordNumber–@Model.LastRecordNumber
                    of @Model.TotalRecords records
                </p>
            </div>

            <role-access roles="Admin,Production">
                <a href="/app/po-import"
                   class="poi-import-link">
                    Import PO PDF
                </a>
            </role-access>
        </div>

        @if (Model.Items.Count == 0)
        {
            <div class="poi-empty-state">

                <div class="poi-empty-icon">
                    PO
                </div>

                <h3>No purchase orders found</h3>

                <p>
                    Try changing the search criteria
                    or reset all filters.
                </p>

                <a asp-controller="PurchaseOrder"
                   asp-action="Index"
                   class="poi-btn poi-btn-primary">
                    Show All Purchase Orders
                </a>
            </div>
        }
        else
        {
            <form asp-controller="PurchaseOrder"
                  asp-action="BulkDelete"
                  method="post"
                  id="purchaseOrderBulkDeleteForm">

                @Html.AntiForgeryToken()

                <input type="hidden"
                       name="returnUrl"
                       value="@($"{Context.Request.Path}{Context.Request.QueryString}")" />

                <role-access roles="Admin,Production">
                    <div class="poi-bulk-bar">
                        <div class="poi-bulk-left">
                            <label class="poi-select-all-label"
                                   for="selectAllPurchaseOrders">
                                <input type="checkbox"
                                       id="selectAllPurchaseOrders"
                                       class="poi-select-checkbox"
                                       aria-label="Select all purchase orders on this page" />
                            </label>

                            <strong>
                                Select all on this page
                            </strong>

                            <span class="poi-selected-count"
                                  id="selectedPurchaseOrderCount">
                                0 selected
                            </span>

                            <span class="poi-bulk-help">
                                Purchase orders with linked materials will be skipped safely.
                            </span>
                        </div>

                        <div class="poi-bulk-actions">
                            <button type="submit"
                                    class="poi-btn-bulk-delete"
                                    id="deleteSelectedPurchaseOrdersButton"
                                    disabled>
                                Delete Selected
                            </button>
                        </div>
                    </div>
                </role-access>

                <div class="poi-table-scroll">

                    <table class="poi-table">

                        <thead>
                            <tr>
                                <th class="poi-checkbox-column">
                                    <span class="visually-hidden">
                                        Select
                                    </span>
                                </th>
                                <th>PO No</th>
                                <th>Handler / Person</th>
                                <th>PO Date</th>
                                <th>PO Received Date</th>
                                <th>PO Status</th>
                                <th>Material Status</th>
                                <th>Materials</th>
                                <th>PO Qty</th>
                                <th>Invoice Balance</th>
                                <th>Dispatch Balance</th>
                                <th>Delivery Range</th>
                                <th>PDF</th>
                                <th>Actions</th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var item in Model.Items)
                            {
                                <tr class="@(item.HasOverdueMaterials ? "poi-overdue-row" : "")"
                                    data-purchase-order-row="@item.PurchaseOrderId">

                                    <td class="poi-checkbox-column">
                                        <role-access roles="Admin,Production">
                                            <label class="poi-row-check-label">
                                                <input type="checkbox"
                                                       name="selectedIds"
                                                       value="@item.PurchaseOrderId"
                                                       class="poi-select-checkbox purchase-order-select-checkbox"
                                                       aria-label="Select purchase order @item.PONumber" />
                                            </label>
                                        </role-access>
                                    </td>

                                    <td>
                                        <a asp-controller="PurchaseOrder"
                                           asp-action="Details"
                                           asp-route-id="@item.PurchaseOrderId"
                                           class="poi-po-number">
                                            @item.PONumber
                                        </a>
                                    </td>

                                    <td>
                                        @if (string.IsNullOrWhiteSpace(item.Handler))
                                        {
                                            <span class="poi-unassigned">
                                                Unassigned
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="poi-handler">

                                                <span class="poi-handler-avatar">
                                                    @item.Handler.Trim()[0]
                                                </span>

                                                @item.Handler
                                            </span>
                                        }
                                    </td>

                                    <td>
                                        <span class="poi-date poi-po-date">
                                            @item.PODateDisplay
                                        </span>
                                    </td>

                                    <td>
                                        <span class="poi-date poi-received-date">
                                            @item.POReceivedDateDisplay
                                        </span>
                                    </td>

                                    <td>
                                        <span class="poi-status @StatusClass(item.Status)">
                                            @item.Status
                                        </span>
                                    </td>

                                    <td>
                                        <span class="poi-status @StatusClass(item.MaterialStatus)">
                                            @item.MaterialStatus
                                        </span>

                                        <div class="poi-progress">
                                            <span style="width:@item.CompletionPercentage.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)%"></span>
                                        </div>

                                        <small class="poi-progress-copy">
                                            @item.CompletionPercentage.ToString("0")%
                                            complete
                                        </small>
                                    </td>

                                    <td>
                                        <div class="poi-material-counts">

                                            <div>
                                                <span>Total</span>

                                                <strong>
                                                    @item.TotalMaterials
                                                </strong>
                                            </div>

                                            <div>
                                                <span>Pending</span>

                                                <strong class="poi-count-warning">
                                                    @item.PendingMaterials
                                                </strong>
                                            </div>

                                            <div>
                                                <span>Completed</span>

                                                <strong class="poi-count-success">
                                                    @item.CompletedMaterials
                                                </strong>
                                            </div>

                                            @if (item.OverdueMaterials > 0)
                                            {
                                                <div>
                                                    <span>Overdue</span>

                                                    <strong class="poi-count-danger">
                                                        @item.OverdueMaterials
                                                    </strong>
                                                </div>
                                            }
                                        </div>
                                    </td>

                                    <td>
                                        <strong class="poi-quantity">
                                            @item.TotalPOQuantity.ToString("N2")
                                        </strong>
                                    </td>

                                    <td>
                                        <strong class="poi-quantity poi-quantity-warning">
                                            @item.TotalInvoiceBalanceQuantity.ToString("N2")
                                        </strong>

                                        <small class="poi-quantity-note">
                                            @item.NotInvoicedMaterials
                                            not invoiced
                                        </small>
                                    </td>

                                    <td>
                                        <strong class="poi-quantity poi-quantity-danger">
                                            @item.TotalPendingDispatchQuantity.ToString("N2")
                                        </strong>

                                        <small class="poi-quantity-note">
                                            @item.PendingDispatchMaterials
                                            pending
                                        </small>
                                    </td>

                                    <td>
                                        @if (item.EarliestDeliveryDate.HasValue ||
                                             item.LatestDeliveryDate.HasValue)
                                        {
                                            <div class="poi-delivery-range">

                                                <span>
                                                    @(item.EarliestDeliveryDate?.ToString("dd-MMM-yyyy") ?? "Not set")
                                                </span>

                                                <small>to</small>

                                                <span>
                                                    @(item.LatestDeliveryDate?.ToString("dd-MMM-yyyy") ?? "Not set")
                                                </span>
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="poi-unassigned">
                                                No delivery dates
                                            </span>
                                        }
                                    </td>

                                    <td>
                                        @if (item.HasPdf)
                                        {
                                            <a href="@item.PdfFilePath"
                                               target="_blank"
                                               rel="noopener noreferrer"
                                               class="poi-pdf-link">
                                                Open PDF
                                            </a>
                                        }
                                        else
                                        {
                                            <span class="poi-no-file">
                                                No PDF
                                            </span>
                                        }
                                    </td>

                                    <td>
                                        <div class="poi-row-actions">

                                            <a asp-controller="PurchaseOrder"
                                               asp-action="Details"
                                               asp-route-id="@item.PurchaseOrderId"
                                               class="poi-row-btn poi-row-view">
                                                View
                                            </a>

                                            <role-access roles="Admin,Production">
                                                <a asp-controller="PurchaseOrder"
                                                   asp-action="Edit"
                                                   asp-route-id="@item.PurchaseOrderId"
                                                   class="poi-row-btn poi-row-edit">
                                                    Edit
                                                </a>

                                                <a asp-controller="PurchaseOrder"
                                                   asp-action="Delete"
                                                   asp-route-id="@item.PurchaseOrderId"
                                                   class="poi-row-btn poi-row-delete">
                                                    Delete
                                                </a>
                                            </role-access>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="poi-pagination">

                    <div class="poi-pagination-copy">
                        Page @Model.Page of @Model.TotalPages
                    </div>

                    <div class="poi-pagination-links">

                        @if (Model.HasPreviousPage)
                        {
                            <a asp-controller="PurchaseOrder"
                               asp-action="Index"
                               asp-route-search="@Model.Search"
                               asp-route-handler="@Model.Handler"
                               asp-route-poDateFrom="@(Model.PODateFrom?.ToString("yyyy-MM-dd"))"
                               asp-route-poDateTo="@(Model.PODateTo?.ToString("yyyy-MM-dd"))"
                               asp-route-poReceivedDateFrom="@(Model.POReceivedDateFrom?.ToString("yyyy-MM-dd"))"
                               asp-route-poReceivedDateTo="@(Model.POReceivedDateTo?.ToString("yyyy-MM-dd"))"
                               asp-route-status="@Model.Status"
                               asp-route-materialStatus="@Model.MaterialStatus"
                               asp-route-page="@(Model.Page - 1)"
                               asp-route-pageSize="@Model.PageSize"
                               class="poi-page-link">
                                Previous
                            </a>
                        }
                        else
                        {
                            <span class="poi-page-link disabled">
                                Previous
                            </span>
                        }

                        @{
                            var firstPage =
                                Math.Max(
                                    1,
                                    Model.Page - 2);

                            var lastPage =
                                Math.Min(
                                    Model.TotalPages,
                                    Model.Page + 2);
                        }

                        @for (var pageNumber = firstPage;
                              pageNumber <= lastPage;
                              pageNumber++)
                        {
                            <a asp-controller="PurchaseOrder"
                               asp-action="Index"
                               asp-route-search="@Model.Search"
                               asp-route-handler="@Model.Handler"
                               asp-route-poDateFrom="@(Model.PODateFrom?.ToString("yyyy-MM-dd"))"
                               asp-route-poDateTo="@(Model.PODateTo?.ToString("yyyy-MM-dd"))"
                               asp-route-poReceivedDateFrom="@(Model.POReceivedDateFrom?.ToString("yyyy-MM-dd"))"
                               asp-route-poReceivedDateTo="@(Model.POReceivedDateTo?.ToString("yyyy-MM-dd"))"
                               asp-route-status="@Model.Status"
                               asp-route-materialStatus="@Model.MaterialStatus"
                               asp-route-page="@pageNumber"
                               asp-route-pageSize="@Model.PageSize"
                               class="poi-page-number @(pageNumber == Model.Page ? "active" : "")">
                                @pageNumber
                            </a>
                        }

                        @if (Model.HasNextPage)
                        {
                            <a asp-controller="PurchaseOrder"
                               asp-action="Index"
                               asp-route-search="@Model.Search"
                               asp-route-handler="@Model.Handler"
                               asp-route-poDateFrom="@(Model.PODateFrom?.ToString("yyyy-MM-dd"))"
                               asp-route-poDateTo="@(Model.PODateTo?.ToString("yyyy-MM-dd"))"
                               asp-route-poReceivedDateFrom="@(Model.POReceivedDateFrom?.ToString("yyyy-MM-dd"))"
                               asp-route-poReceivedDateTo="@(Model.POReceivedDateTo?.ToString("yyyy-MM-dd"))"
                               asp-route-status="@Model.Status"
                               asp-route-materialStatus="@Model.MaterialStatus"
                               asp-route-page="@(Model.Page + 1)"
                               asp-route-pageSize="@Model.PageSize"
                               class="poi-page-link">
                                Next
                            </a>
                        }
                        else
                        {
                            <span class="poi-page-link disabled">
                                Next
                            </span>
                        }
                    </div>
                </div>
            </form>
        }
    </section>
</div>

@section Scripts {
    <script>
        (() => {
            "use strict";

            const form =
                document.getElementById(
                    "purchaseOrderBulkDeleteForm");

            if (!form) {
                return;
            }

            const selectAll =
                document.getElementById(
                    "selectAllPurchaseOrders");

            const deleteButton =
                document.getElementById(
                    "deleteSelectedPurchaseOrdersButton");

            const selectedCount =
                document.getElementById(
                    "selectedPurchaseOrderCount");

            const checkboxes =
                Array.from(
                    form.querySelectorAll(
                        ".purchase-order-select-checkbox"));

            const updateSelectionState = () => {
                const selected =
                    checkboxes.filter(
                        checkbox =>
                            checkbox.checked);

                const selectedTotal =
                    selected.length;

                if (selectedCount) {
                    selectedCount.textContent =
                        `${selectedTotal} selected`;
                }

                if (deleteButton) {
                    deleteButton.disabled =
                        selectedTotal === 0;
                }

                if (selectAll) {
                    selectAll.checked =
                        checkboxes.length > 0 &&
                        selectedTotal ===
                        checkboxes.length;

                    selectAll.indeterminate =
                        selectedTotal > 0 &&
                        selectedTotal <
                        checkboxes.length;
                }

                checkboxes.forEach(
                    checkbox => {
                        const row =
                            checkbox.closest("tr");

                        row?.classList.toggle(
                            "poi-row-selected",
                            checkbox.checked);
                    });
            };

            selectAll?.addEventListener(
                "change",
                () => {
                    checkboxes.forEach(
                        checkbox => {
                            checkbox.checked =
                                selectAll.checked;
                        });

                    updateSelectionState();
                });

            checkboxes.forEach(
                checkbox => {
                    checkbox.addEventListener(
                        "change",
                        updateSelectionState);
                });

            form.addEventListener(
                "submit",
                event => {
                    const selectedTotal =
                        checkboxes.filter(
                            checkbox =>
                                checkbox.checked)
                            .length;

                    if (selectedTotal === 0) {
                        event.preventDefault();

                        window.alert(
                            "Select at least one purchase order.");

                        return;
                    }

                    const confirmed =
                        window.confirm(
                            `Delete ${selectedTotal} selected purchase order(s)? ` +
                            "POs with linked materials will be skipped.");

                    if (!confirmed) {
                        event.preventDefault();
                        return;
                    }

                    if (deleteButton) {
                        deleteButton.disabled = true;
                        deleteButton.textContent =
                            "Deleting...";
                    }
                });

            updateSelectionState();
        })();
    </script>
}

