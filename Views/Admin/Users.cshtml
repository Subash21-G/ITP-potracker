@using Microsoft.AspNetCore.Http
@model List<POTracker.Models.AppUser>

@{
    ViewData["Title"] = "Users";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var currentUserName =
        Context.Session.GetString("UserName") ?? string.Empty;

    string[] availableRoles =
    {
        "Viewer",
        "Production",
        "Admin"
    };
}

@section Styles {
    <style>
        .role-form {
            display: flex;
            align-items: center;
            gap: 0.65rem;
            min-width: 290px;
        }

            .role-form .form-select {
                min-width: 145px;
                margin: 0;
            }

        .current-user-badge {
            display: inline-flex;
            align-items: center;
            margin-left: 0.45rem;
            padding: 0.2rem 0.55rem;
            border-radius: 999px;
            color: #5b21b6;
            background: #ede9fe;
            font-size: 0.72rem;
            font-weight: 800;
        }

        .role-help {
            color: #64748b;
            font-size: 0.8rem;
        }

        @@media (max-width: 760px) {
            .role-form {
                align-items: stretch;
                flex-direction: column;
                min-width: 180px;
            }
        }
    </style>
}

<div class="page-header">
    <div>
        <h1>User & Role Management</h1>
        <p>Admin, production, stores, dispatch and viewer access</p>
    </div>
    <a href="/Account/Register" class="btn-primary">+ Add User</a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert-success" role="status">
        @TempData["Success"]
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert-danger" role="alert">
        @TempData["Error"]
    </div>
}

<div class="premium-grid">
    <div class="metric-card">
        <span>Total Users</span>
        <strong>@Model.Count</strong>
    </div>
    <div class="metric-card">
        <span>Admins</span>
        <strong>@Model.Count(x => x.Role == "Admin")</strong>
    </div>
    <div class="metric-card">
        <span>Production</span>
        <strong>@Model.Count(x => x.Role == "Production")</strong>
    </div>
    <div class="metric-card">
        <span>Viewers</span>
        <strong>@Model.Count(x => x.Role == "Viewer")</strong>
    </div>
</div>

<div class="table-section">
    <div class="table-responsive">
        <table class="custom-table">
            <thead>
                <tr>
                    <th>Full Name</th>
                    <th>Username</th>
                    <th>Current Role</th>
                    <th>Change Role</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in Model)
                {
                    var isCurrentUser = string.Equals(
                        user.UserName,
                        currentUserName,
                        StringComparison.OrdinalIgnoreCase);

                    <tr>
                        <td>
                            @user.FullName

                            @if (isCurrentUser)
                            {
                                <span class="current-user-badge">You</span>
                            }
                        </td>
                        <td>@user.UserName</td>
                        <td>
                            <span class="status-dark">@user.Role</span>
                        </td>
                        <td>
                            @if (isCurrentUser)
                            {
                                <span class="role-help">
                                    Sign in as another Admin to change this role.
                                </span>
                            }
                            else
                            {
                                <form asp-controller="Admin"
                                      asp-action="UpdateRole"
                                      method="post"
                                      class="role-form">
                                    @Html.AntiForgeryToken()

                                    <input type="hidden"
                                           name="id"
                                           value="@user.Id" />

                                    <select name="role"
                                            class="form-select"
                                            aria-label="Role for @user.FullName">
                                        @foreach (var roleOption in availableRoles)
                                        {
                                            if (roleOption.Equals(
                                                user.Role,
                                                StringComparison.OrdinalIgnoreCase))
                                            {
                                                <option value="@roleOption" selected>
                                                    @roleOption
                                                </option>
                                            }
                                            else
                                            {
                                                <option value="@roleOption">
                                                    @roleOption
                                                </option>
                                            }
                                        }
                                    </select>

                                    <button type="submit"
                                            class="btn-secondary">
                                        Save Role
                                    </button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
