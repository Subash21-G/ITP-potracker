@model POTracker.ViewModels.PendingMaterialIndexViewModel

@{
    ViewData["Title"] = "Pending Materials";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var assignments = Model.Summary.AssignmentSummary ?? new();

    string StatusClass(string? value)
    {
        var status = value?.Trim().ToLowerInvariant() ?? "";

        if (status.Contains("complete") ||
            status.Contains("fully") ||
            status == "dispatched")
        {
            return "pm-good";
        }

        if (status.Contains("partial") ||
            status.Contains("progress"))
        {
            return "pm-info";
        }

        if (status.Contains("cancel") ||
            status.Contains("reject"))
        {
            return "pm-bad";
        }

        return "pm-warn";
    }

    string DueClass(
        POTracker.ViewModels.PendingMaterialRowViewModel item)
    {
        if (item.IsOverdue) return "pm-bad";
        if (item.IsDueToday) return "pm-warn";
        if (item.IsDueThisWeek) return "pm-info";
        if (!item.DeliveryDate.HasValue) return "pm-neutral";
        return "pm-good";
    }
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/pending-material.css"
          asp-append-version="true" />
}

<div class="pm-page">

    <section class="pm-hero">
        <div>
            <span class="pm-kicker">Production control</span>

            <h2>Pending Materials</h2>

            <p>
                Track pending materials by handler,
                PO received date, invoice and dispatch status.
            </p>
        </div>

        <div class="pm-actions">
            <a asp-controller="PendingMaterial"
               asp-action="ExportExcel"
               asp-route-search="@Model.Search"
               asp-route-poNumber="@Model.PONumber"
               asp-route-handler="@Model.Handler"
               asp-route-assignedDashboard="@Model.AssignedDashboard"
               asp-route-processStatus="@Model.ProcessStatus"
               asp-route-invoiceStatus="@Model.InvoiceStatus"
               asp-route-dispatchStatus="@Model.DispatchStatus"
               asp-route-poDateFrom="@(Model.PODateFrom?.ToString("yyyy-MM-dd"))"
               asp-route-poDateTo="@(Model.PODateTo?.ToString("yyyy-MM-dd"))"
               asp-route-poReceivedDateFrom="@(Model.POReceivedDateFrom?.ToString("yyyy-MM-dd"))"
               asp-route-poReceivedDateTo="@(Model.POReceivedDateTo?.ToString("yyyy-MM-dd"))"
               asp-route-deliveryDateFrom="@(Model.DeliveryDateFrom?.ToString("yyyy-MM-dd"))"
               asp-route-deliveryDateTo="@(Model.DeliveryDateTo?.ToString("yyyy-MM-dd"))"
               asp-route-overdueOnly="@Model.OverdueOnly"
               asp-route-dueThisWeekOnly="@Model.DueThisWeekOnly"
               class="pm-btn pm-btn-excel">
                Export Filtered Excel
            </a>

            <a asp-controller="Material"
               asp-action="Index"
               class="pm-btn pm-btn-light">
                All Materials
            </a>
        </div>
    </section>

    <section class="pm-stats">
        <article class="pm-stat violet">
            <span>Total Pending</span>
            <strong>@Model.Summary.TotalPendingMaterials</strong>
            <small>Material lines requiring action</small>
        </article>

        <article class="pm-stat rose">
            <span>Overdue</span>
            <strong>@Model.Summary.OverdueMaterials</strong>
            <small>Delivery date already passed</small>
        </article>

        <article class="pm-stat amber">
            <span>Due This Week</span>
            <strong>@Model.Summary.DueThisWeekMaterials</strong>
            <small>Within the next seven days</small>
        </article>

        <article class="pm-stat blue">
            <span>Invoice Balance</span>
            <strong>@Model.Summary.TotalInvoiceBalanceQuantity.ToString("N2")</strong>
            <small>Quantity not fully invoiced</small>
        </article>

        <article class="pm-stat green">
            <span>Dispatch Balance</span>
            <strong>@Model.Summary.TotalPendingDispatchQuantity.ToString("N2")</strong>
            <small>Quantity pending dispatch</small>
        </article>

        <article class="pm-stat teal">
            <span>Pending Value</span>
            <strong>₹@Model.Summary.TotalPendingValue.ToString("N2")</strong>
            <small>Pending quantity × unit cost</small>
        </article>
    </section>

    <section class="pm-card">
        <div class="pm-card-head">
            <div>
                <span class="pm-kicker">Search and filter</span>
                <h3>Find pending materials</h3>
            </div>

            @if (Model.HasActiveFilters)
            {
                <span class="pm-filter-count">
                    @Model.ActiveFilterCount active
                </span>
            }
        </div>

        <form asp-controller="PendingMaterial"
              asp-action="Index"
              method="get"
              class="pm-filter-form">

            <div class="pm-filter-grid">

                <div class="pm-field wide">
                    <label>Material search</label>

                    <input type="search"
                           name="search"
                           value="@Model.Search"
                           placeholder="Material no, description, drawing, handler..." />
                </div>

                <div class="pm-field">
                    <label>PO number</label>

                    <input type="text"
                           name="poNumber"
                           value="@Model.PONumber"
                           placeholder="Enter PO number" />
                </div>

                <div class="pm-field">
                    <label>Handler / Person</label>

                    <select name="handler">
                        <option value="">All handlers</option>

                        @foreach (var option in Model.Handlers)
                        {
                            if (option.IsSelected)
                            {
                                <option value="@option.Value" selected>
                                    @option.Text (@option.Count)
                                </option>
                            }
                            else
                            {
                                <option value="@option.Value">
                                    @option.Text (@option.Count)
                                </option>
                            }
                        }
                    </select>
                </div>

                <div class="pm-field">
                    <label>PO date from</label>

                    <input type="date"
                           name="poDateFrom"
                           value="@(Model.PODateFrom?.ToString("yyyy-MM-dd"))" />
                </div>

                <div class="pm-field">
                    <label>PO date to</label>

                    <input type="date"
                           name="poDateTo"
                           value="@(Model.PODateTo?.ToString("yyyy-MM-dd"))" />
                </div>

                <div class="pm-field">
                    <label>PO received from</label>

                    <input type="date"
                           name="poReceivedDateFrom"
                           value="@(Model.POReceivedDateFrom?.ToString("yyyy-MM-dd"))" />
                </div>

                <div class="pm-field">
                    <label>PO received to</label>

                    <input type="date"
                           name="poReceivedDateTo"
                           value="@(Model.POReceivedDateTo?.ToString("yyyy-MM-dd"))" />
                </div>

                <div class="pm-field">
                    <label>Assigned person</label>

                    <select name="assignedDashboard">
                        <option value="">All assigned people</option>

                        @foreach (var option in Model.AssignedDashboards)
                        {
                            if (option.IsSelected)
                            {
                                <option value="@option.Value" selected>
                                    @option.Text (@option.Count)
                                </option>
                            }
                            else
                            {
                                <option value="@option.Value">
                                    @option.Text (@option.Count)
                                </option>
                            }
                        }
                    </select>
                </div>

                <div class="pm-field">
                    <label>Process status</label>

                    <select name="processStatus">
                        <option value="">All process statuses</option>

                        @foreach (var option in Model.ProcessStatuses)
                        {
                            if (option.IsSelected)
                            {
                                <option value="@option.Value" selected>
                                    @option.Text (@option.Count)
                                </option>
                            }
                            else
                            {
                                <option value="@option.Value">
                                    @option.Text (@option.Count)
                                </option>
                            }
                        }
                    </select>
                </div>

                <div class="pm-field">
                    <label>Invoice status</label>

                    <select name="invoiceStatus">
                        <option value="">All invoice statuses</option>

                        @foreach (var option in Model.InvoiceStatuses)
                        {
                            if (option.IsSelected)
                            {
                                <option value="@option.Value" selected>
                                    @option.Text (@option.Count)
                                </option>
                            }
                            else
                            {
                                <option value="@option.Value">
                                    @option.Text (@option.Count)
                                </option>
                            }
                        }
                    </select>
                </div>

                <div class="pm-field">
                    <label>Dispatch status</label>

                    <select name="dispatchStatus">
                        <option value="">All dispatch statuses</option>

                        @foreach (var option in Model.DispatchStatuses)
                        {
                            if (option.IsSelected)
                            {
                                <option value="@option.Value" selected>
                                    @option.Text (@option.Count)
                                </option>
                            }
                            else
                            {
                                <option value="@option.Value">
                                    @option.Text (@option.Count)
                                </option>
                            }
                        }
                    </select>
                </div>

                <div class="pm-field">
                    <label>Delivery from</label>

                    <input type="date"
                           name="deliveryDateFrom"
                           value="@(Model.DeliveryDateFrom?.ToString("yyyy-MM-dd"))" />
                </div>

                <div class="pm-field">
                    <label>Delivery to</label>

                    <input type="date"
                           name="deliveryDateTo"
                           value="@(Model.DeliveryDateTo?.ToString("yyyy-MM-dd"))" />
                </div>

                <div class="pm-field">
                    <label>Rows per page</label>

                    <select name="pageSize">
                        @foreach (var size in new[] { 10, 25, 50, 100, 200 })
                        {
                            if (Model.PageSize == size)
                            {
                                <option value="@size" selected>
                                    @size rows
                                </option>
                            }
                            else
                            {
                                <option value="@size">
                                    @size rows
                                </option>
                            }
                        }
                    </select>
                </div>
            </div>

            <div class="pm-checks">
                <label>
                    <input type="checkbox"
                           name="overdueOnly"
                           value="true"
                           checked="@Model.OverdueOnly" />

                    Overdue only
                </label>

                <label>
                    <input type="checkbox"
                           name="dueThisWeekOnly"
                           value="true"
                           checked="@Model.DueThisWeekOnly" />

                    Due within seven days
                </label>
            </div>

            <div class="pm-actions">
                <button type="submit"
                        class="pm-btn pm-btn-primary">
                    Search Materials
                </button>

                <a asp-controller="PendingMaterial"
                   asp-action="Index"
                   class="pm-btn pm-btn-light">
                    Clear Filters
                </a>
            </div>
        </form>
    </section>

    <section class="pm-table-card">

        <div class="pm-table-head">
            <div>
                <span class="pm-kicker">Filtered result</span>

                <h3>Pending material list</h3>

                <p>
                    Showing @Model.FirstRecordNumber–@Model.LastRecordNumber
                    of @Model.TotalRecords
                </p>
            </div>
        </div>

        @if (Model.Items.Count == 0)
        {
            <div class="pm-empty">
                <h3>No pending materials found</h3>

                <p>
                    Clear the filters or enter a different search.
                </p>

                <a asp-controller="PendingMaterial"
                   asp-action="Index"
                   class="pm-btn pm-btn-primary">
                    Show All Pending
                </a>
            </div>
        }
        else
        {
            <div class="pm-table-wrap">
                <table class="pm-table">
                    <thead>
                        <tr>
                            <th>PO No</th>
                            <th>Handler / Person</th>
                            <th>PO Date</th>
                            <th>PO Received Date</th>
                            <th>Material</th>
                            <th>Progress</th>
                            <th>Invoice</th>
                            <th>Dispatch</th>
                            <th>Delivery</th>
                            <th>Process</th>
                            <th>Assigned</th>
                            <th>Drawing</th>
                            <th>Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var item in Model.Items)
                        {
                            <tr class="@(item.IsOverdue ? "pm-overdue-row" : "")">

                                <td>
                                    <strong>@item.PONumber</strong>
                                </td>

                                <td>
                                    @if (string.IsNullOrWhiteSpace(item.Handler))
                                    {
                                        <small>Unassigned</small>
                                    }
                                    else
                                    {
                                        <span class="pm-handler">
                                            <span>
                                                @item.Handler.Trim()[0]
                                            </span>

                                            @item.Handler
                                        </span>
                                    }
                                </td>

                                <td>
                                    <span class="pm-po-date">
                                        @(item.PODate?.ToString("dd-MMM-yyyy") ?? "Not set")
                                    </span>
                                </td>

                                <td>
                                    <span class="pm-received-date">
                                        @(item.POReceivedDate?.ToString("dd-MMM-yyyy") ?? "Not set")
                                    </span>
                                </td>

                                <td>
                                    <strong class="pm-material">
                                        @item.MaterialNo
                                    </strong>

                                    <small>@item.LineItem</small>

                                    <small title="@item.BriefDescription">
                                        @(string.IsNullOrWhiteSpace(item.ShortDescription)
                                            ? item.BriefDescription
                                            : item.ShortDescription)
                                    </small>
                                </td>

                                <td>
                                    <div class="pm-qty">
                                        <span>PO Qty</span>

                                        <strong>
                                            @item.POQuantity.ToString("N2")
                                            @item.Unit
                                        </strong>
                                    </div>

                                    <div class="pm-progress">
                                        <span style="width:@item.CompletionPercentage.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)%"></span>
                                    </div>

                                    <small>
                                        @item.CompletionPercentage.ToString("0")%
                                        complete
                                    </small>
                                </td>

                                <td>
                                    <div class="pm-value-row">
                                        <span>Invoiced</span>
                                        <strong>
                                            @item.InvoiceQuantity.ToString("N2")
                                        </strong>
                                    </div>

                                    <div class="pm-value-row">
                                        <span>Balance</span>
                                        <strong class="warning">
                                            @item.InvoiceBalanceQuantity.ToString("N2")
                                        </strong>
                                    </div>

                                    <span class="pm-badge @StatusClass(item.InvoiceStatus)">
                                        @item.InvoiceStatus
                                    </span>
                                </td>

                                <td>
                                    <div class="pm-value-row">
                                        <span>Dispatched</span>
                                        <strong>
                                            @item.DispatchQuantity.ToString("N2")
                                        </strong>
                                    </div>

                                    <div class="pm-value-row">
                                        <span>Pending</span>
                                        <strong class="danger">
                                            @item.PendingDispatchQuantity.ToString("N2")
                                        </strong>
                                    </div>

                                    <span class="pm-badge @StatusClass(item.DispatchStatus)">
                                        @item.DispatchStatus
                                    </span>
                                </td>

                                <td>
                                    <strong>
                                        @(item.DeliveryDate?.ToString("dd-MMM-yyyy") ?? "Not set")
                                    </strong>

                                    <span class="pm-badge @DueClass(item)">
                                        @item.DueStatus
                                    </span>

                                    @if (item.IsOverdue)
                                    {
                                        <small class="late">
                                            @item.OverdueDays day(s) late
                                        </small>
                                    }
                                </td>

                                <td>
                                    <span class="pm-badge @StatusClass(item.ProcessStatus)">
                                        @item.ProcessStatus
                                    </span>
                                </td>

                                <td>
                                    @if (string.IsNullOrWhiteSpace(item.AssignedDashboard))
                                    {
                                        <small>Unassigned</small>
                                    }
                                    else
                                    {
                                        <span class="pm-person">
                                            @item.AssignedDashboard
                                        </span>
                                    }
                                </td>

                                <td>
                                    <strong>
                                        @(item.DrawingNo ?? "No drawing")
                                    </strong>

                                    @if (!string.IsNullOrWhiteSpace(item.DrawingFilePath))
                                    {
                                        <a href="@item.DrawingFilePath"
                                           target="_blank"
                                           class="pm-file">
                                            Open drawing
                                        </a>
                                    }
                                </td>

                                <td>
                                    <div class="pm-row-actions">
                                        <a asp-controller="Material"
                                           asp-action="Details"
                                           asp-route-id="@item.MaterialId">
                                            View
                                        </a>

                                        <a asp-controller="Material"
                                           asp-action="Edit"
                                           asp-route-id="@item.MaterialId">
                                            Edit
                                        </a>

                                        <a asp-controller="PurchaseOrder"
                                           asp-action="Details"
                                           asp-route-id="@item.PurchaseOrderId">
                                            PO
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="pm-pagination">
                <span>
                    Page @Model.Page of @Model.TotalPages
                </span>

                <div>
                    @if (Model.HasPreviousPage)
                    {
                        <a asp-controller="PendingMaterial"
                           asp-action="Index"
                           asp-route-search="@Model.Search"
                           asp-route-poNumber="@Model.PONumber"
                           asp-route-handler="@Model.Handler"
                           asp-route-assignedDashboard="@Model.AssignedDashboard"
                           asp-route-processStatus="@Model.ProcessStatus"
                           asp-route-invoiceStatus="@Model.InvoiceStatus"
                           asp-route-dispatchStatus="@Model.DispatchStatus"
                           asp-route-poDateFrom="@(Model.PODateFrom?.ToString("yyyy-MM-dd"))"
                           asp-route-poDateTo="@(Model.PODateTo?.ToString("yyyy-MM-dd"))"
                           asp-route-poReceivedDateFrom="@(Model.POReceivedDateFrom?.ToString("yyyy-MM-dd"))"
                           asp-route-poReceivedDateTo="@(Model.POReceivedDateTo?.ToString("yyyy-MM-dd"))"
                           asp-route-deliveryDateFrom="@(Model.DeliveryDateFrom?.ToString("yyyy-MM-dd"))"
                           asp-route-deliveryDateTo="@(Model.DeliveryDateTo?.ToString("yyyy-MM-dd"))"
                           asp-route-overdueOnly="@Model.OverdueOnly"
                           asp-route-dueThisWeekOnly="@Model.DueThisWeekOnly"
                           asp-route-page="@(Model.Page - 1)"
                           asp-route-pageSize="@Model.PageSize">
                            Previous
                        </a>
                    }

                    @{
                        var firstPage = Math.Max(1, Model.Page - 2);
                        var lastPage = Math.Min(Model.TotalPages, Model.Page + 2);
                    }

                    @for (var number = firstPage;
                          number <= lastPage;
                          number++)
                    {
                        <a asp-controller="PendingMaterial"
                           asp-action="Index"
                           asp-route-search="@Model.Search"
                           asp-route-poNumber="@Model.PONumber"
                           asp-route-handler="@Model.Handler"
                           asp-route-assignedDashboard="@Model.AssignedDashboard"
                           asp-route-processStatus="@Model.ProcessStatus"
                           asp-route-invoiceStatus="@Model.InvoiceStatus"
                           asp-route-dispatchStatus="@Model.DispatchStatus"
                           asp-route-poDateFrom="@(Model.PODateFrom?.ToString("yyyy-MM-dd"))"
                           asp-route-poDateTo="@(Model.PODateTo?.ToString("yyyy-MM-dd"))"
                           asp-route-poReceivedDateFrom="@(Model.POReceivedDateFrom?.ToString("yyyy-MM-dd"))"
                           asp-route-poReceivedDateTo="@(Model.POReceivedDateTo?.ToString("yyyy-MM-dd"))"
                           asp-route-deliveryDateFrom="@(Model.DeliveryDateFrom?.ToString("yyyy-MM-dd"))"
                           asp-route-deliveryDateTo="@(Model.DeliveryDateTo?.ToString("yyyy-MM-dd"))"
                           asp-route-overdueOnly="@Model.OverdueOnly"
                           asp-route-dueThisWeekOnly="@Model.DueThisWeekOnly"
                           asp-route-page="@number"
                           asp-route-pageSize="@Model.PageSize"
                           class="@(number == Model.Page ? "active" : "")">
                            @number
                        </a>
                    }

                    @if (Model.HasNextPage)
                    {
                        <a asp-controller="PendingMaterial"
                           asp-action="Index"
                           asp-route-search="@Model.Search"
                           asp-route-poNumber="@Model.PONumber"
                           asp-route-handler="@Model.Handler"
                           asp-route-assignedDashboard="@Model.AssignedDashboard"
                           asp-route-processStatus="@Model.ProcessStatus"
                           asp-route-invoiceStatus="@Model.InvoiceStatus"
                           asp-route-dispatchStatus="@Model.DispatchStatus"
                           asp-route-poDateFrom="@(Model.PODateFrom?.ToString("yyyy-MM-dd"))"
                           asp-route-poDateTo="@(Model.PODateTo?.ToString("yyyy-MM-dd"))"
                           asp-route-poReceivedDateFrom="@(Model.POReceivedDateFrom?.ToString("yyyy-MM-dd"))"
                           asp-route-poReceivedDateTo="@(Model.POReceivedDateTo?.ToString("yyyy-MM-dd"))"
                           asp-route-deliveryDateFrom="@(Model.DeliveryDateFrom?.ToString("yyyy-MM-dd"))"
                           asp-route-deliveryDateTo="@(Model.DeliveryDateTo?.ToString("yyyy-MM-dd"))"
                           asp-route-overdueOnly="@Model.OverdueOnly"
                           asp-route-dueThisWeekOnly="@Model.DueThisWeekOnly"
                           asp-route-page="@(Model.Page + 1)"
                           asp-route-pageSize="@Model.PageSize">
                            Next
                        </a>
                    }
                </div>
            </div>
        }
    </section>
</div>
