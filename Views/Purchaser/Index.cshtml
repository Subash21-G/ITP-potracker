@model List<POTracker.Models.Purchaser>

@{
    ViewData["Title"] = "Purchasers";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="page-header">
    <div>
        <h1>Purchasers</h1>
        <p>Manage all purchaser/customer details</p>
    </div>

    <role-access roles="Admin,Production">
        <a href="/Purchaser/Create" class="btn-primary">
            + Add Purchaser
        </a>
    </role-access>
</div>

<div class="table-section">

    <form method="get" class="search-box">
        <input type="text"
               name="search"
               value="@ViewBag.Search"
               placeholder="Search purchaser..." />

        <button type="submit">
            Search
        </button>
    </form>

    <table class="custom-table">
        <thead>
            <tr>
                <th>#</th>
                <th>Purchaser Name</th>
                <th>Contact Person</th>
                <th>Mobile</th>
                <th>Email</th>
                <th>Address</th>
                <th>Actions</th>
            </tr>
        </thead>

        <tbody>
            @{
                int i = 1;
            }

            @foreach (var item in Model)
            {
                <tr>
                    <td>@i</td>
                    <td>@item.PurchaserName</td>
                    <td>@(item.ContactPerson ?? "-")</td>
                    <td>@(item.MobileNo ?? "-")</td>
                    <td>@(item.Email ?? "-")</td>
                    <td>@(item.Address ?? "-")</td>
                    <td>
                        <role-access roles="Admin,Production">
                            <a href="/Purchaser/Edit/@item.Id" class="action-edit">
                                Edit
                            </a>

                            <form asp-controller="Purchaser"
                                  asp-action="Delete"
                                  asp-route-id="@item.Id"
                                  asp-antiforgery="true"
                                  method="post"
                                  style="display:inline;margin:0;"
                                  onsubmit="return confirm('Are you sure you want to delete this purchaser?');">
                                <button type="submit"
                                        class="action-delete">
                                    Delete
                                </button>
                            </form>
                        </role-access>
                    </td>
                </tr>

                i++;
            }
        </tbody>
    </table>

</div>
