@model POTracker.Models.Purchaser

@{
    ViewData["Title"] = "Add Purchaser";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="form-container">

    <div class="page-header">
        <div>
            <h1>Add Purchaser</h1>
            <p>Create new purchaser/customer profile</p>
        </div>

        <a href="/Purchaser/Index" class="btn-secondary">
            Back
        </a>
    </div>

    <form method="post" class="premium-form">
        @Html.AntiForgeryToken()

        <div class="form-grid">

            <div class="form-group">
                <label>Purchaser Name</label>
                <input asp-for="PurchaserName" required />
            </div>

            <div class="form-group">
                <label>Contact Person</label>
                <input asp-for="ContactPerson" />
            </div>

            <div class="form-group">
                <label>Mobile No</label>
                <input asp-for="MobileNo" />
            </div>

            <div class="form-group">
                <label>Email</label>
                <input asp-for="Email" />
            </div>

            <div class="form-group full">
                <label>Address</label>
                <textarea asp-for="Address"></textarea>
            </div>

        </div>

        <div class="form-actions">
            <button type="submit" class="btn-primary">
                Save Purchaser
            </button>

            <a href="/Purchaser/Index" class="btn-secondary">
                Cancel
            </a>
        </div>

    </form>

</div>
