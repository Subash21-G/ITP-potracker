@model POTracker.ViewModels.DashboardPendingSummaryViewModel

@{
    string DueClass(
        POTracker.ViewModels.DashboardPendingMaterialRowViewModel item)
    {
        if (item.IsOverdue)
        {
            return "dpw-danger";
        }

        if (item.IsDueToday)
        {
            return "dpw-warning";
        }

        if (item.IsDueThisWeek)
        {
            return "dpw-info";
        }

        if (!item.DeliveryDate.HasValue)
        {
            return "dpw-neutral";
        }

        return "dpw-success";
    }

    string StatusClass(string? status)
    {
        var value = status?.Trim().ToLowerInvariant() ?? "";

        if (value.Contains("fully") ||
            value.Contains("complete") ||
            value == "dispatched")
        {
            return "dpw-success";
        }

        if (value.Contains("partial") ||
            value.Contains("progress"))
        {
            return "dpw-info";
        }

        if (value.Contains("cancel") ||
            value.Contains("reject"))
        {
            return "dpw-danger";
        }

        return "dpw-warning";
    }
}

<section class="dpw-widget">

    <div class="dpw-header">
        <div>
            <span class="dpw-kicker">
                Production priority
            </span>

            <h3>Pending Materials</h3>

            <p>
                Urgent materials with handler,
                PO received date, invoice and dispatch balance.
            </p>
        </div>

        <a href="/app/pending-materials"
           class="dpw-view-all">
            View All Pending
        </a>
    </div>

    <div class="dpw-summary-grid">

        <article class="dpw-summary-card dpw-violet">
            <span>Total Pending</span>

            <strong>
                @Model.TotalPendingMaterials
            </strong>

            <small>
                Material lines requiring action
            </small>
        </article>

        <article class="dpw-summary-card dpw-red">
            <span>Overdue</span>

            <strong>
                @Model.OverdueMaterials
            </strong>

            <small>
                Delivery date already passed
            </small>
        </article>

        <article class="dpw-summary-card dpw-amber">
            <span>Due Today</span>

            <strong>
                @Model.DueTodayMaterials
            </strong>

            <small>
                Requires immediate action
            </small>
        </article>

        <article class="dpw-summary-card dpw-blue">
            <span>Due This Week</span>

            <strong>
                @Model.DueThisWeekMaterials
            </strong>

            <small>
                Due within seven days
            </small>
        </article>

        <article class="dpw-summary-card dpw-green">
            <span>Invoice Balance</span>

            <strong>
                @Model.PendingInvoiceQuantity.ToString("N2")
            </strong>

            <small>
                Quantity not fully invoiced
            </small>
        </article>

        <article class="dpw-summary-card dpw-teal">
            <span>Dispatch Balance</span>

            <strong>
                @Model.PendingDispatchQuantity.ToString("N2")
            </strong>

            <small>
                Quantity pending dispatch
            </small>
        </article>
    </div>

    @if (Model.PriorityItems.Count == 0)
    {
        <div class="dpw-empty">
            <div class="dpw-empty-icon">
                ✓
            </div>

            <h4>No pending materials</h4>

            <p>
                All materials are currently completed.
            </p>
        </div>
    }
    else
    {
        <div class="dpw-table-wrap">
            <table class="dpw-table">
                <thead>
                    <tr>
                        <th>PO No</th>
                        <th>Handler / Person</th>
                        <th>PO Date</th>
                        <th>PO Received Date</th>
                        <th>Material</th>
                        <th>Invoice Balance</th>
                        <th>Dispatch Balance</th>
                        <th>Delivery</th>
                        <th>Assigned</th>
                        <th>Action</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in Model.PriorityItems)
                    {
                        <tr class="@(item.IsOverdue ? "dpw-overdue-row" : "")">

                            <td>
                                <a href="/app/purchase-orders/@item.PurchaseOrderId"
                                   class="dpw-po-number">
                                    @item.PONumber
                                </a>
                            </td>

                            <td>
                                @if (string.IsNullOrWhiteSpace(item.Handler))
                                {
                                    <span class="dpw-unassigned">
                                        Unassigned
                                    </span>
                                }
                                else
                                {
                                    <span class="dpw-handler">
                                        <span class="dpw-handler-avatar">
                                            @item.Handler.Trim()[0]
                                        </span>

                                        @item.Handler
                                    </span>
                                }
                            </td>

                            <td>
                                <span class="dpw-date dpw-po-date">
                                    @item.PODateDisplay
                                </span>
                            </td>

                            <td>
                                <span class="dpw-date dpw-received-date">
                                    @item.POReceivedDateDisplay
                                </span>
                            </td>

                            <td>
                                <a href="/app/materials/@item.MaterialId"`r`n                                   class="dpw-material-number">
                                    @item.MaterialNo
                                </a>

                                @if (!string.IsNullOrWhiteSpace(item.LineItem))
                                {
                                    <small class="dpw-line-item">
                                        Line: @item.LineItem
                                    </small>
                                }

                                @if (!string.IsNullOrWhiteSpace(item.Description))
                                {
                                    <small class="dpw-description"
                                           title="@item.Description">
                                        @item.Description
                                    </small>
                                }

                                @if (!string.IsNullOrWhiteSpace(item.DrawingNo))
                                {
                                    <small class="dpw-drawing">
                                        Drg: @item.DrawingNo
                                    </small>
                                }
                            </td>

                            <td>
                                <strong class="dpw-quantity">
                                    @item.InvoiceBalanceQuantity.ToString("N2")
                                </strong>

                                <span class="dpw-badge @StatusClass(item.InvoiceStatus)">
                                    @item.InvoiceStatus
                                </span>
                            </td>

                            <td>
                                <strong class="dpw-quantity">
                                    @item.PendingQuantity.ToString("N2")
                                    @item.Unit
                                </strong>

                                <span class="dpw-badge @StatusClass(item.DispatchStatus)">
                                    @item.DispatchStatus
                                </span>
                            </td>

                            <td>
                                <strong class="dpw-delivery-date">
                                    @(item.DeliveryDate?.ToString("dd-MMM-yyyy") ?? "Not set")
                                </strong>

                                <span class="dpw-badge @DueClass(item)">
                                    @item.DueText
                                </span>
                            </td>

                            <td>
                                <span class="dpw-assigned">
                                    @item.AssignedPersonDisplay
                                </span>

                                <span class="dpw-process">
                                    @item.ProcessStatus
                                </span>
                            </td>

                            <td>
                                <div class="dpw-row-actions">
                                    <a href="/app/materials/@item.MaterialId"`r`n                                       class="dpw-action dpw-action-view">
                                        View
                                    </a>

                                    <role-access roles="Admin,Production">
                                        <a href="/app/materials/@item.MaterialId/edit"`r`n                                           class="dpw-action dpw-action-edit">
                                            Edit
                                        </a>
                                    </role-access>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    <div class="dpw-footer">
        <div class="dpw-footer-note">
            Showing the top @Model.PriorityItems.Count
            urgent material(s)
        </div>

        @if (Model.UnassignedMaterials > 0)
        {
            <a href="/app/pending-materials"
               class="dpw-unassigned-link">
                @Model.UnassignedMaterials unassigned
            </a>
        }
    </div>
</section>
