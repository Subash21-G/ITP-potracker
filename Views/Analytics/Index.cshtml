@model List<POTracker.Models.Purchaser>

@{
    ViewData["Title"] = "Analytics";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="page-header">
    <div>
        <h1>Purchaser Performance Analytics</h1>
        <p>Purchaser-wise PO load, material count and overdue summary</p>
    </div>
    <a href="/Report/Index" class="btn-secondary">Reports</a>
</div>

<div class="premium-grid">
    <div class="metric-card"><span>Purchasers</span><strong>@Model.Count</strong></div>
    <div class="metric-card"><span>Total Materials</span><strong>@(ViewBag.TotalMaterials ?? 0)</strong></div>
    <div class="metric-card"><span>Overdue</span><strong>@(ViewBag.OverdueCount ?? 0)</strong></div>
    <div class="metric-card"><span>Open POs</span><strong>@Model.SelectMany(x => x.PurchaseOrders).Count()</strong></div>
</div>

<div class="premium-split">
    <div class="premium-panel">
        <h2>Purchaser Load</h2>
        @foreach (var purchaser in Model.Take(5))
        {
            var materialCount = purchaser.PurchaseOrders.SelectMany(x => x.Materials).Count();
            var width = Math.Min(100, materialCount * 8);
            <div class="progress-row">
                <span>@purchaser.PurchaserName</span>
                <div class="bar"><i style="width:@width%;background:#2563eb"></i></div>
                <strong>@materialCount</strong>
            </div>
        }
    </div>
    <div class="premium-panel">
        <h2>Delay Snapshot</h2>
        <p>Use this page to compare purchaser load, overdue items and process bottlenecks. The next upgrade can add charts and date filters.</p>
    </div>
</div>

<div class="table-section">
    <table class="custom-table">
        <thead>
            <tr>
                <th>Purchaser</th>
                <th>PO Count</th>
                <th>Material Count</th>
                <th>Pending</th>
                <th>Completed</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var purchaser in Model)
            {
                var materials = purchaser.PurchaseOrders.SelectMany(x => x.Materials).ToList();
                <tr>
                    <td><strong>@purchaser.PurchaserName</strong></td>
                    <td>@purchaser.PurchaseOrders.Count</td>
                    <td>@materials.Count</td>
                    <td>@materials.Count(x => x.ProcessStatus != "Completed")</td>
                    <td>@materials.Count(x => x.ProcessStatus == "Completed")</td>
                </tr>
            }
        </tbody>
    </table>
</div>
